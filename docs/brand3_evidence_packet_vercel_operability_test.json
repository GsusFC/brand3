  "findings": [
    {
      "id": "stable_entity_not_overblocked",
      "severity": "positive",
      "summary": "The packet preserved 13 finding-eligible items for Vercel, unlike Builtwith where it blocked almost everything. This indicates the classifier is not simply over-conservative."
    },
    {
      "id": "technical_visual_signals_removed",
      "severity": "positive",
      "summary": "Context artifacts such as robots.txt, sitemap.xml, llms.txt, schema, key-page presence, and visual metrics were classified as technical/internal rather than narrative findings."
    },
    {
      "id": "differentiation_gap",
      "severity": "blocking",
      "summary": "No differentiation evidence survived as finding-eligible. For a high-evidence platform like Vercel, that means the packet is not yet usable as the sole pre-narrative input."
    },
    {
      "id": "empty_text_url_leak",
      "severity": "blocking",
      "summary": "Some URL-only entries with empty text were still classified as eligible. A prompt cannot write responsible findings from URLs alone without evidence text."
    },
    {
      "id": "source_role_too_coarse",
      "severity": "material",
      "summary": "External evidence is still too broad: Wikipedia, TechCrunch, Releasebot, togithub mirrors, and owned Vercel pages all pass through similar eligibility paths despite different evidentiary roles."
    },
    {
      "id": "linkedin_over_review_gated",
      "severity": "minor",
      "summary": "The LinkedIn company profile was review-gated as same-name external profile. This is safe, but a stable company case needs better official-social verification instead of blanket ambiguity."
    }
  ],
  "root_cause_assessment": "Evidence Packet v0 is operational as a diagnostic filter, but not yet operational as a replacement for finding input preparation. It proves that upstream classification can preserve good evidence while removing technical/internal noise, but it also exposes that eligibility needs evidence-text requirements, source-role weighting, and dimension coverage checks before it can feed prompts.",
  "recommended_next_step": "Do one narrow hardening pass before any prompt integration: block empty-text URL evidence from normal eligibility, add source-role subtypes, add official-social verification from owned links/raw inputs, and require each dimension to have enough eligible evidence before generation."
}
