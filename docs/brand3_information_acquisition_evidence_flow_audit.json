  "root_cause_assessment": {
    "primary": "The system lacks an information-to-evidence eligibility contract between feature extraction and narrative generation.",
    "details": [
      "Feature raw values double as evidence containers.",
      "Narrative extraction accepts evidence_insights and other technical/internal fields.",
      "Context infrastructure facts become evidence items.",
      "Dimension grouping merges all source types without eligibility.",
      "Entity discovery exists in the run result but is not a hard narrative boundary.",
      "Confidence and freshness do not reach the findings prompt.",
      "The findings prompt then forces implication and typical_decision."
    ],
    "not_primary": [
      "model_quality_alone",
      "renderer_alone",
      "scoring_alone",
      "Visual_Signature"
    ]
  },
  "recommended_next_step": {
    "name": "Information-to-Evidence Contract",
    "description": "Define a deterministic eligibility layer between feature extraction and narrative finding generation.",
    "suggested_classes": [
      "finding_eligible",
