      "mode": "deterministic_extract_evidence",
      "risk": "narrow evidence extraction for report display"
    },
    {
      "from": "features.raw_value",
      "to": "narrative_Evidence_objects",
      "mode": "deterministic_collect_evidences",
      "risk": "broad extraction accepts evidence_snippet, evidence_snippets, evidence_url, evidence_insights"
    },
    {
      "from": "narrative_Evidence_objects",
      "to": "findings_prompt_input",
      "mode": "dimension_grouping_and_formatting",
      "risk": "source quality and purpose are compressed"
    },
    {
      "from": "findings_prompt_input",
      "to": "report_findings",
      "mode": "LLM_generated",
      "risk": "prompt requires implication and typical_decision"
    },
