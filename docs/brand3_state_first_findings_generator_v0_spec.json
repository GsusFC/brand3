{
  "version": "1.0",
  "created_at": "2026-05-17",
  "artifact_type": "lab_only_state_first_findings_generator_v0_spec",
  "status": {
    "specification_only": true,
    "implemented": false,
    "lab_only": true,
    "runtime_integration": false,
    "prompt_rollout": false,
    "scoring_change": false,
    "renderer_change": false,
    "report_mutation": false,
    "persisted_payload_change": false,
    "visual_signature_change": false,
    "ui_change": false,
    "llm_runtime_call": false
  },
  "purpose": "Define the contract for a future lab-only state-first findings generator before implementation.",
  "research_question": "Can entity-state-first generation produce better Brand3 findings than the current dimension-by-dimension pipeline without inventing coherence or hiding uncertainty?",
  "operating_principle": "The generator must decide whether it can safely generate before it writes.",
  "fallback_output": "No safe state-first generation candidate.",
  "required_inputs": [
    {
      "id": "report_narrative_payload",
      "required": true,
      "minimum_fields": [
        "summary",
        "synthesis_prose",
        "tensions_prose",
        "findings_by_dimension"
      ],
      "notes": "Baseline material only. Must not be mutated."
    },
    {
      "id": "payload_diagnostic",
      "required": true,
      "may_be_built_offline": true,
      "minimum_fields": [
        "warning_count",
        "findings_count",
        "findings_without_evidence_urls",
        "safe_attribution_counts",
        "fallback_evidence_opening_counts",
        "external_corroboration_caveat_counts",
        "generic_decision_space_counts",
        "repeated_opener_metrics"
      ]
    },
    {
      "id": "render_diagnostic",
      "required": true,
      "may_be_built_offline": true,
      "minimum_fields": [
        "visible_repeated_openings",
        "visible_safe_attribution_count",
        "visible_external_corroboration_caveat_count",
        "visible_fallback_repetition",
        "visible_evidence_chip_count",
        "suppressed_by_rendering",
        "still_visible_risks"
      ]
    },
    {
      "id": "entity_narrative_state",
      "required": true,
      "minimum_fields": [
        "status",
        "primary_entity_signal",
        "entity_aliases_or_observed_related_surfaces",
        "owned_claim_density",
        "source_ownership_summary",
        "evidence_url_coverage",
        "primary_tension",
        "contradiction_candidates",
        "decision_space_mode",
        "compression_candidates"
      ],
      "must_be_offline_lab_only": true
    },
    {
      "id": "observed_related_surfaces",
      "required": false,
      "allowed_only_when": [
        "explicitly_reviewed",
        "deterministically_safe"
      ],
      "disallowed_sources": [
        "arbitrary_evidence_urls",
        "name_similarity_alone",
        "third_party_mentions",
        "search_co_occurrence"
      ]
    },
    {
      "id": "snapshot_metadata",
      "required": false,
      "allowed_fields": [
        "brand_name",
        "target_url",
        "run_id",
        "report_token",
        "score_summary",
        "dimension_score_summary"
      ],
      "rule": "Scores are context only and must not justify prose."
    }
  ],
  "preconditions_to_generate": [
    "report_narrative_payload_exists",
    "at_least_one_finding_exists",
    "payload_diagnostic_exists_or_can_be_built_offline",
    "render_diagnostic_exists_or_can_be_built_offline",
    "entity_narrative_state_exists",
    "entity_narrative_state_status_is_offline_experimental_not_runtime_not_scoring_not_rendering_not_prompt_not_persisted",
    "meaningful_evidence_map_can_be_built",
    "unresolved_ambiguity_is_explicit_not_inferred",
    "related_surfaces_are_explicit_or_reviewed",
    "every_generated_finding_can_state_an_evidence_boundary"
  ],
  "no_candidate_reasons": [
    "missing_report_narrative_payload",
    "missing_findings",
    "missing_diagnostics_and_cannot_build_offline",
    "missing_entity_narrative_state",
    "entity_narrative_state_not_offline_lab_only",
    "entity_ambiguity_implied_but_not_explicit",
    "related_surfaces_from_name_similarity_only",
    "evidence_too_thin_for_meaningful_map",
    "only_possible_improvement_is_stylistic",
    "uncertainty_would_need_to_be_hidden",
    "stable_case_would_be_overstructured",
    "observation_and_interpretation_cannot_be_separated"
  ],
  "intervention_modes": [
    {
      "mode": "none",
      "use_when": [
        "baseline_already_coherent",
        "evidence_too_thin",
        "no_meaningful_state_first_improvement",
        "rewrite_would_be_mostly_stylistic"
      ],
      "output": "No safe state-first generation candidate."
    },
    {
      "mode": "light",
      "use_when": [
        "entity_stable",
        "evidence_adequate",
        "state_first_can_improve_evidence_boundaries_or_caveat_discipline",
        "heavy_rewrite_would_add_unnecessary_complexity"
      ],
      "typical_cases": [
        "launchdarkly",
        "netlify_snapshot_mock_when_safe"
      ],
      "allowed_behavior": [
        "compact_global_caveat",
        "dimension_role_clarification",
        "local_evidence_boundary_improvements",
        "no_artificial_entity_tension"
      ]
    },
    {
      "mode": "strong",
      "use_when": [
        "baseline_risks_false_coherence",
        "related_surfaces_may_be_collapsed_into_aliases",
        "owned_claims_repeatedly_treated_as_proof",
        "visual_or_perceptual_confidence_may_become_evidentiary_confidence",
        "external_caveats_repeat_because_uncertainty_is_not_centralized"
      ],
      "typical_cases": [
        "builtwith_kit_com",
        "iris",
        "watermelon"
      ],
      "allowed_behavior": [
        "global_governing_caveat",
        "explicit_entity_boundary_reading",
        "review_gated_related_surfaces",
        "dimension_level_redistribution_of_evidence_and_uncertainty"
      ],
      "forbidden_behavior": [
        "resolving_ambiguity",
        "inferring_ownership",
        "inferring_intent",
        "turning_uncertainty_into_confident_strategy"
      ]
    }
  ],
  "output_contract": {
    "top_level_required_fields": [
      "version",
      "created_at",
      "case_id",
      "status",
      "input_artifacts",
      "generation_decision",
      "baseline",
      "shared_entity_state",
      "shared_evidence_map",
      "global_uncertainty_model",
      "state_first_finding_plan",
      "generated_state_first_findings",
      "comparison",
      "verdict"
    ],
    "status_required_flags": {
      "lab_only": true,
      "runtime_integration": false,
      "prompt_rollout": false,
      "scoring_change": false,
      "renderer_change": false,
      "report_mutation": false,
      "visual_signature_change": false,
      "production_ready": false
    },
    "generation_decision_required_fields": [
      "mode",
      "candidate_available",
      "reason",
      "blocked_reasons",
      "preconditions_passed",
      "preconditions_failed"
    ],
    "finding_required_fields_when_candidate_available": [
      "dimension",
      "title",
      "finding",
      "evidence_urls_or_missing_evidence_note",
      "confidence",
      "uncertainty_note_when_applicable",
      "review_flag_when_applicable"
    ]
  },
  "evidence_rules": [
    "Evidence URLs are not decorative.",
    "Every generated claim must know what evidence supports it.",
    "Missing evidence is allowed but must be visible.",
    "Owned claims support positioning observations, not market validation.",
    "External trust/security pages support scrutiny signals, not broad perception claims.",
    "Product Hunt, alternatives pages, articles, repositories, or docs do not prove ownership without review.",
    "Scores must not be used as proof inside findings.",
    "Visual/perceptual strength must not compensate for weak evidentiary confidence.",
    "Evidence limits should be centralized when global and local when dimension-specific."
  ],
  "uncertainty_rules": [
    "Caveat compression is valid; caveat deletion is not.",
    "A compressed caveat must remain visible.",
    "Entity uncertainty must be stated before dimension findings when it governs the case.",
    "Related surfaces must be marked as review-gated unless deterministic and explicit.",
    "Interpretation must remain separate from observation.",
    "Strategic intention must not be inferred from surface signals alone.",
    "Healthy cases must not receive artificial tension.",
    "Thin cases must not receive synthetic depth."
  ],
  "future_prompt_guardrails": [
    "do_not_invent_new_evidence",
    "do_not_cite_unavailable_evidence",
    "do_not_resolve_entity_ambiguity",
    "do_not_infer_ownership",
    "do_not_use_scores_as_prose_justification",
    "do_not_write_generic_decision_space",
    "do_not_hide_uncertainty",
    "do_not_convert_related_surfaces_into_aliases",
    "do_not_turn_state_fields_into_quoted_report_content",
    "return_no_candidate_if_conditions_are_unsafe"
  ],
  "expected_tests_for_future_implementation": {
    "output_shape": [
      "stable_output_shape_for_all_modes",
      "json_serializable",
      "no_candidate_output_when_mode_none",
      "runtime_scoring_prompt_rendering_visual_signature_flags_remain_false"
    ],
    "preconditions": [
      "missing_payload_returns_no_candidate",
      "missing_findings_returns_no_candidate",
      "missing_entity_state_returns_no_candidate",
      "non_offline_state_returns_no_candidate",
      "unreviewed_related_surfaces_return_no_candidate_or_review_gated_blocked_state",
      "thin_payload_selects_none_or_light_not_strong"
    ],
    "evidence_discipline": [
      "generated_findings_include_evidence_urls_or_missing_evidence_notes",
      "owned_claims_not_treated_as_market_validation",
      "external_trust_pages_not_treated_as_broad_reputation_proof",
      "repositories_do_not_imply_official_roadmap_without_review",
      "scores_not_used_as_evidence"
    ],
    "uncertainty_discipline": [
      "caveats_compressed_not_deleted",
      "entity_ambiguity_preserved",
      "visual_confidence_not_evidentiary_confidence",
      "healthy_cases_do_not_gain_false_tension",
      "thin_cases_do_not_gain_artificial_depth"
    ],
    "case_fixtures": [
      "builtwith_kit_com_selects_strong",
      "iris_selects_strong",
      "watermelon_selects_strong",
      "launchdarkly_selects_light",
      "netlify_snapshot_mock_selects_light_or_none_depending_on_evidence_map_quality"
    ]
  },
  "explicit_non_goals": [
    "modify_brand_audit_output",
    "modify_scoring",
    "modify_production_prompts",
    "modify_report_renderer",
    "modify_persisted_report_narrative",
    "integrate_visual_signature",
    "create_official_lab_claims",
    "persist_generated_candidates",
    "replace_human_review",
    "automate_entity_discovery",
    "infer_related_surfaces"
  ],
  "future_implementation_boundary": {
    "suggested_module": "src/reports/state_first_findings_generator.py",
    "suggested_public_function": "generate_state_first_findings_candidate",
    "signature": "generate_state_first_findings_candidate(payload: dict, *, payload_diagnostic: dict, render_diagnostic: dict, entity_state: dict, snapshot: dict | None = None) -> dict",
    "requirements": [
      "offline",
      "lab_only",
      "deterministic_precondition_and_mode_selection",
      "not_wired_into_report_generation",
      "not_wired_into_rendering"
    ]
  }
}
