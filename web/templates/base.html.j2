<!DOCTYPE html>
{% set current_lang = ui_lang if ui_lang is defined else (model.lang if model is defined and model.lang is defined else 'es') %}
{% set lang_suffix = '?lang=' ~ current_lang if current_lang == 'en' else '' %}
{% set lang_query = '&lang=' ~ current_lang if current_lang == 'en' else '' %}
<html lang="{{ current_lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Brand3{% endblock %}</title>
<link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
<script>
  (() => {
    try {
      const stored = localStorage.getItem("brand3-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = stored || (prefersDark ? "dark" : "light");
    } catch {
      document.documentElement.dataset.theme = "light";
    }
  })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="/static/main.css?v={{ static_asset_version }}">
{% block extra_head %}{% endblock %}
</head>
<body>
<div class="page">
  <div class="term-head">
    <a class="term-home" href="/{{ lang_suffix }}" aria-label="{{ 'Inicio de Brand3' if current_lang == 'es' else 'Brand3 home' }}">
      <span class="prompt">❯</span> brand3 <span class="hl-accent">--mode</span> web <span class="dim">· {{ 'observatorio público' if current_lang == 'es' else 'public observatory' }}</span>
    </a>
    <div class="term-actions">
      <div class="lang-toggle" aria-label="Language switch">
        <a class="source-link{% if current_lang == 'es' %} badge-ready{% endif %}" href="{{ request.url.include_query_params(lang='es') }}">ES</a>
        <a class="source-link{% if current_lang == 'en' %} badge-ready{% endif %}" href="{{ request.url.include_query_params(lang='en') }}">EN</a>
      </div>
      <button class="theme-toggle theme-toggle-term" type="button" data-theme-toggle aria-label="Toggle color theme">Theme</button>
    </div>
  </div>
  {% block content %}{% endblock %}
  <hr class="rule">
  <footer class="footer">
    <div class="kv">
      <span class="k">engine</span>    <span class="v">brand3 v0.1.0</span>
      <span class="k">{{ 'acerca' if current_lang == 'es' else 'about' }}</span>     <span class="v"><a href="/{{ lang_suffix }}">{{ 'Inicio' if current_lang == 'es' else 'Home' }}</a> · <a href="/reports{{ lang_suffix }}">{{ 'Informes' if current_lang == 'es' else 'Reports' }}</a> · <a href="/visual-signature{{ lang_suffix }}">{{ 'Laboratorio de firma visual' if current_lang == 'es' else 'Visual Signature Lab' }}</a> · <a href="/magnetism-scanner{{ lang_suffix }}">Brand3 Scanner</a> · <a href="/takedown{{ lang_suffix }}">/takedown</a></span>
    </div>
    <div class="small footer-note">
      {% if current_lang == 'es' %}
      Brand3 Scoring es el producto de auditoría en uso. Visual Signature Lab es una capa secundaria de evidencia e investigación.
      Las puntuaciones son opiniones derivadas de heurísticas + análisis LLM, no hechos.
      ¿Eres propietario de una marca y quieres retirar el análisis? Consulta <a href="/takedown{{ lang_suffix }}">/takedown</a>.
      {% else %}
      Brand3 Scoring is the working audit product. Visual Signature Lab is a secondary evidence and research layer.
      Scores are opinions derived from heuristics + LLM analysis, not facts.
      Own a brand and want the analysis removed? See <a href="/takedown{{ lang_suffix }}">/takedown</a>.
      {% endif %}
    </div>
    <div class="footer-cursor"><span class="prompt">❯</span> _<span class="cursor"></span></div>
  </footer>
</div>
<script>
  (() => {
    const button = document.querySelector("[data-theme-toggle]");
    if (!button) return;

    const setTheme = (theme) => {
      document.documentElement.dataset.theme = theme;
      button.textContent = theme === "dark" ? "Light" : "Dark";
      button.setAttribute("aria-pressed", theme === "dark" ? "true" : "false");
    };

    setTheme(document.documentElement.dataset.theme || "light");
    button.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      try {
        localStorage.setItem("brand3-theme", next);
      } catch {
        // localStorage can be unavailable in strict/private contexts.
      }
      setTheme(next);
    });
  })();
</script>
</body>
</html>
