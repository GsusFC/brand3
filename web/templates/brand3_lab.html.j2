{% extends "base.html.j2" %}
{% block title %}Brand3 Lab — audit{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">brand3_lab</span>
    <span class="tag">// lab pipeline applied</span>
  </div>

  <h1 class="page-title">brand3 lab — audit</h1>
  <p class="prose dim intro-copy">
    Same report page format as production, generated with the Lab narrative pipeline.
  </p>

  <form action="/brand3-lab/analyze" method="post" class="form-row">
    <input type="url" name="url" placeholder="https://your-brand.com" required autofocus spellcheck="false" autocomplete="off">
    <button type="submit">run lab analysis</button>
  </form>

  <p class="small dim form-note">
    This sends the URL through the full audit pipeline and opens the Lab-rendered report when ready.
  </p>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">latest_lab_audits</span>
    <span class="tag">// last {{ model.latest_analyses|length }} public</span>
  </div>
  {% if model.latest_analyses %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="col-date">date</th>
        <th class="col-brand">brand</th>
        <th class="num col-score">score</th>
        <th class="col-bar">bar</th>
        <th class="col-band">band</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    {% for row in model.latest_analyses %}
      <tr>
        <td>{{ row.date }}</td>
        <td><a href="/brand/{{ row.brand_slug }}">{{ row.brand_slug }}</a></td>
        <td class="num num-inline">{{ row.score_display }}</td>
        <td class="bar">{{ row.bar }}</td>
        <td class="dim">{{ row.band }}</td>
        <td><a href="/brand3-lab/r/{{ row.token }}">view</a></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="empty">// no public audits yet — submit the first one above.</div>
  {% endif %}
</section>
{% endblock %}
