{% extends "base.html.j2" %}
{% block title %}brand3 :: {{ model.title }}{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">{{ model.kind }}</span>
    <span class="tag">// run_id={{ model.run_id }} · lab only · read-only diagnostic</span>
  </div>
  <div class="lab-review-nav">
    <a class="source-link" href="{{ model.back_href }}">Back to Brand3 Lab</a>
    <a class="source-link" href="/brand3-lab/cases/run/{{ model.run_id }}/review">Open Lab review input</a>
  </div>
  <h1 class="page-title">{{ model.title }}</h1>
  <p class="prose dim intro-copy">
    Read-only Lab comparison for one Brand Audit run. The official report stays unchanged; this page shows candidate recompositions, what changed, what remains uncertain, and why.
  </p>

  <div class="badge-line">
    {% for guardrail in model.guardrails %}
    <span class="badge">{{ guardrail }}</span>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">Official Result</span>
    <span class="tag">// official output remains Brand Audit</span>
  </div>
  <div class="lab-official-summary">
    <article class="lab-detail-block">
      <h2>{{ model.brand.name }}</h2>
      <div class="lab-index-meta">
        <span class="inline-kv"><span class="k">domain</span>=<span class="v">{{ model.brand.domain }}</span></span>
        <span class="inline-kv"><span class="k">run_id</span>=<span class="v">{{ model.run_id }}</span></span>
        <span class="inline-kv"><span class="k">composite</span>=<span class="v">{{ model.score_summary.composite if model.score_summary.composite is not none else "unknown" }}</span></span>
      </div>
      <p class="prose dim mono-token">{{ model.brand.url }}</p>
      {% if model.official_report.available %}
      <a class="source-link" href="{{ model.official_report.href }}">open official report</a>
      {% else %}
      <p class="prose dim">Official report link is unavailable.</p>
      {% endif %}
    </article>
    <article class="lab-detail-block">
      <h2>Dimension scores</h2>
      {% if model.dimensions %}
      <div class="lab-score-grid">
        {% for dimension in model.dimensions %}
        <span class="inline-kv"><span class="k">{{ dimension.name }}</span>=<span class="v">{{ dimension.score }}</span></span>
        {% endfor %}
      </div>
      {% else %}
      <p>No dimension score rows are available for this run.</p>
      {% endif %}
    </article>
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">Lab-Applied Reading Candidate</span>
    <span class="tag">// official finding vs experimental candidate</span>
  </div>
  {% if model.applied_reading.available %}
  <p class="prose dim">{{ model.applied_reading.summary }}</p>
  {% for dimension in model.applied_reading.dimensions %}
  <div class="lab-applied-dimension">
    <div class="section-head compact">
      <span class="label">{{ dimension.name }}</span>
      <span class="tag">// {{ dimension.findings|length }} findings</span>
    </div>
    <div class="lab-applied-stack">
      {% for finding in dimension.findings %}
      <article class="lab-applied-card{% if not finding.lab_variant_available %} is-unavailable{% endif %}">
        <div class="lab-layer-mini-head">
          <h2>{{ finding.title }}</h2>
          <span class="badge{% if finding.lab_variant_available %} badge-ready{% endif %}">{{ finding.candidate_label }}</span>
        </div>
        {% if finding.lab_variant_available %}
        <div class="lab-signal-chip-row">
          <span class="badge">experimental</span>
          <span class="badge">lab-only</span>
          <span class="badge">not official</span>
          <span class="badge">not persisted</span>
          <span class="badge">{{ finding.candidate_generation_mode }}</span>
        </div>
        {% endif %}
        <div class="lab-finding-compare">
          <div class="lab-narrative-panel">
            <div class="lab-narrative-panel-head">
              <h2>Official Brand Audit finding</h2>
              <span class="tag">// current output</span>
            </div>
            <p>{{ finding.official_text }}</p>
          </div>
          <div class="lab-narrative-panel is-perceptual">
            <div class="lab-narrative-panel-head">
              <h2>Lab-applied reading</h2>
              <span class="tag">// experimental</span>
            </div>
            {% if finding.lab_variant_available %}
            <p>{{ finding.lab_applied_text }}</p>
            {% else %}
            <p>No safe Lab reading candidate yet: {{ finding.unavailable_reason }}.</p>
            {% endif %}
          </div>
        </div>
        <div class="lab-evidence-risk-grid">
          <div>
            <h3>Change notes</h3>
            <ul class="lab-detail-list">
              {% for note in finding.change_notes %}
              <li>{{ note }}</li>
              {% endfor %}
            </ul>
          </div>
          <div>
            <h3>Evidence & risk</h3>
            <div class="lab-signal-chip-row">
              <span class="badge">confidence={{ finding.confidence }}</span>
              <span class="badge">human_review={{ finding.requires_human_review }}</span>
              <span class="badge">decision_space_visible={{ finding.decision_space_visible }}</span>
            </div>
            {% if finding.evidence_urls %}
            <div class="lab-signal-chip-row">
              {% for url in finding.evidence_urls %}
              <a class="badge" href="{{ url }}">{{ url }}</a>
              {% endfor %}
            </div>
            {% endif %}
            <ul class="lab-detail-list">
              {% for risk in finding.risk_notes %}
              <li>{{ risk }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
        <div class="lab-signal-chip-row">
          {% for layer in finding.layers_used %}
          <span class="badge">{{ layer }}</span>
          {% endfor %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
  {% else %}
  <article class="lab-detail-block">
    <h2>No safe Lab-applied reading candidate yet</h2>
    <p>{{ model.applied_reading.summary }} Reason: {{ model.applied_reading.unavailable_reason }}.</p>
  </article>
  {% endif %}
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">Methodology Summary</span>
    <span class="tag">// traceability after the value</span>
  </div>
  <div class="lab-signal-summary">
    <article>
      <h2>Report Narrative</h2>
      <div class="lab-index-meta">
        <span class="inline-kv"><span class="k">available</span>=<span class="v">{{ model.report_narrative.available }}</span></span>
        <span class="inline-kv"><span class="k">source</span>=<span class="v">{{ model.report_narrative.source or "unknown" }}</span></span>
        <span class="inline-kv"><span class="k">version</span>=<span class="v">{{ model.report_narrative.version or "unknown" }}</span></span>
      </div>
    </article>
    <article>
      <h2>Evidence URL coverage</h2>
      <div class="lab-index-meta">
        <span class="inline-kv"><span class="k">coverage</span>=<span class="v">{{ model.evidence_coverage.coverage_level }}</span></span>
        <span class="inline-kv"><span class="k">findings</span>=<span class="v">{{ model.evidence_coverage.finding_count }}</span></span>
        <span class="inline-kv"><span class="k">without_urls</span>=<span class="v">{{ model.evidence_coverage.findings_without_evidence_urls }}</span></span>
      </div>
      {% if model.evidence_coverage.affected_dimensions %}
      <p class="small dim">Affected dimensions: {{ model.evidence_coverage.affected_dimensions|join(", ") }}</p>
      {% endif %}
    </article>
    <article>
      <h2>EntityNarrativeState</h2>
      <div class="lab-index-meta">
        <span class="inline-kv"><span class="k">available</span>=<span class="v">{{ model.entity_narrative_state.available }}</span></span>
        <span class="inline-kv"><span class="k">status</span>=<span class="v">{{ model.entity_narrative_state.status }}</span></span>
        <span class="inline-kv"><span class="k">review</span>=<span class="v">{{ model.entity_narrative_state.requires_review }}</span></span>
      </div>
    </article>
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">Narrative Harness</span>
    <span class="tag">// in-memory diagnostic summary</span>
  </div>
  {% if model.narrative_harness.available %}
  <div class="lab-index-meta">
    <span class="inline-kv"><span class="k">status</span>=<span class="v">{{ model.narrative_harness.status }}</span></span>
    <span class="inline-kv"><span class="k">warnings</span>=<span class="v">{{ model.narrative_harness.warning_count }}</span></span>
    <span class="inline-kv"><span class="k">errors</span>=<span class="v">{{ model.narrative_harness.error_count }}</span></span>
    <span class="inline-kv"><span class="k">findings</span>=<span class="v">{{ model.narrative_harness.metrics.findings_count }}</span></span>
    <span class="inline-kv"><span class="k">missing_evidence_urls</span>=<span class="v">{{ model.narrative_harness.metrics.findings_without_evidence_urls }}</span></span>
    <span class="inline-kv"><span class="k">safe_attribution_total</span>=<span class="v">{{ model.narrative_harness.metrics.safe_attribution_total }}</span></span>
    <span class="inline-kv"><span class="k">observation_repetition_families</span>=<span class="v">{{ model.narrative_harness.metrics.observation_repetition_families }}</span></span>
  </div>
  {% if model.narrative_harness.visible_checks %}
  <ul class="lab-detail-list">
    {% for check in model.narrative_harness.visible_checks %}
    <li><strong>{{ check.id }}</strong>: {{ check.status }}{% if check.message %} — {{ check.message }}{% endif %}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="prose dim">Narrative Harness ran and found no visible warning checks in the summarized output.</p>
  {% endif %}
  {% else %}
  <p class="prose dim">Narrative Harness is unavailable because this run has no persisted report narrative payload.</p>
  {% endif %}
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">Lab Layers</span>
    <span class="tag">// explicit available and unavailable states</span>
  </div>
  <div class="lab-layer-card-row">
    {% for layer in model.layers %}
    <article class="lab-layer-mini-card">
      <div class="lab-layer-mini-head">
        <h2>{{ layer.name }}</h2>
        <span class="badge{% if layer.status == 'generated_offline' %} badge-ready{% endif %}">{{ layer.status }}</span>
      </div>
      <p>{{ layer.summary }}</p>
    </article>
    {% endfor %}
  </div>
</section>
{% endblock %}
