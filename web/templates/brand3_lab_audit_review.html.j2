{% extends "base.html.j2" %}
{% block title %}brand3 :: {{ model.title }}{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">{{ model.kind }}</span>
    <span class="tag">// run_id={{ model.run_id }} · draft-only · no persistence</span>
  </div>
  <div class="lab-review-nav">
    <a class="source-link" href="/brand3-lab/cases/run/{{ model.run_id }}">Back to Lab case</a>
    {% if model.official_report.available %}
    <a class="source-link" href="{{ model.official_report.href }}">Open official report</a>
    {% endif %}
  </div>
  <h1 class="page-title">{{ model.title }}</h1>
  <p class="prose dim intro-copy">
    Review the official Brand Audit finding against the Lab-applied state-first candidate. This creates a local draft JSON only; it does not save reviewer decisions or change the audit.
  </p>
  <div class="badge-line">
    <span class="badge">lab-only</span>
    <span class="badge">draft_only</span>
    <span class="badge">not_persisted</span>
    <span class="badge">not official</span>
    <span class="badge">no scoring impact</span>
  </div>
</section>

<hr class="rule-thin">

<section
  data-lab-review-form
  data-run-id="{{ model.run_id }}"
  data-case-id="{{ model.case_id }}"
  data-case-brand="{{ model.brand.name }}"
  data-source-artifacts='{{ model.review.source_artifacts|tojson }}'
  data-review-schema-version="{{ model.review.schema_version }}"
>
  <div class="section-head">
    <span class="label">Review Surface</span>
    <span class="tag">// official vs Lab candidate by dimension</span>
  </div>

  {% if model.review.available %}
  <div class="lab-review-stack">
    {% for dimension in model.review.dimensions %}
    <article
      class="lab-review-dimension"
      data-dimension-review
      data-dimension-id="{{ dimension.id }}"
      data-dimension-name="{{ dimension.name }}"
      data-candidate-available="{{ dimension.candidate_available|lower }}"
      data-requires-human-review="{{ dimension.requires_human_review|lower }}"
    >
      <div class="lab-layer-mini-head">
        <div>
          <span class="label">{{ dimension.name }}</span>
          <h2>{{ dimension.lab_candidate_count }} Lab candidates / {{ dimension.finding_count }} official findings</h2>
        </div>
        <span class="badge{% if dimension.candidate_available %} badge-ready{% endif %}">
          {% if dimension.candidate_available %}candidate available{% else %}no safe candidate{% endif %}
        </span>
      </div>

      <div class="lab-review-findings">
        {% for finding in dimension.findings %}
        <div class="lab-review-finding">
          <div class="lab-finding-compare">
            <div class="lab-narrative-panel">
              <div class="lab-narrative-panel-head">
                <h2>Official Brand Audit finding</h2>
                <span class="tag">// {{ finding.title }}</span>
              </div>
              <p>{{ finding.official_text }}</p>
            </div>
            <div class="lab-narrative-panel is-perceptual">
              <div class="lab-narrative-panel-head">
                <h2>Lab-applied candidate</h2>
                <span class="tag">// {{ finding.candidate_generation_mode }}</span>
              </div>
              {% if finding.lab_variant_available %}
              <p>{{ finding.lab_applied_text }}</p>
              {% else %}
              <p>No safe candidate: {{ finding.unavailable_reason }}.</p>
              {% endif %}
            </div>
          </div>
          <div class="lab-evidence-risk-grid">
            <div>
              <h3>Evidence used</h3>
              {% if finding.evidence_urls %}
              <div class="lab-signal-chip-row">
                {% for url in finding.evidence_urls %}
                <a class="badge" href="{{ url }}">{{ url }}</a>
                {% endfor %}
              </div>
              {% else %}
              <p class="prose dim">No finding-level evidence URL is attached.</p>
              {% endif %}
            </div>
            <div>
              <h3>Uncertainty / overreach</h3>
              <div class="lab-signal-chip-row">
                <span class="badge">confidence={{ finding.confidence }}</span>
                <span class="badge">human_review={{ finding.requires_human_review }}</span>
              </div>
              <ul class="lab-detail-list">
                {% for item in finding.risk_notes %}
                <li>{{ item }}</li>
                {% endfor %}
              </ul>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>

      <div class="lab-review-input-grid">
        <fieldset class="review-control-group">
          <legend>Reviewer decision</legend>
          {% for option in model.review.dimension_decisions %}
          <label>
            <input type="radio" name="decision_{{ dimension.id }}" value="{{ option }}">
            {{ option.replace("_", " ") }}
          </label>
          {% endfor %}
        </fieldset>
        <fieldset class="review-control-group">
          <legend>Reason tags</legend>
          {% for tag in model.review.reason_tags %}
          <label>
            <input type="checkbox" name="reason_{{ dimension.id }}" value="{{ tag }}">
            {{ tag.replace("_", " ") }}
          </label>
          {% endfor %}
        </fieldset>
      </div>
      <label class="lab-review-note-label" for="notes_{{ dimension.id }}">Dimension notes</label>
      <textarea id="notes_{{ dimension.id }}" name="notes_{{ dimension.id }}" rows="3" placeholder="Short reviewer note for {{ dimension.name }}"></textarea>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <article class="lab-detail-block">
    <h2>No safe Lab candidate to review</h2>
    <p>{{ model.review.unavailable_reason }}. The review flow is still available as an unavailable state, but there are no dimension candidates to score.</p>
  </article>
  {% endif %}
</section>

<hr class="rule-thin">

<section data-lab-review-overall>
  <div class="section-head">
    <span class="label">Overall Review</span>
    <span class="tag">// local draft export only</span>
  </div>
  <div class="lab-review-input-grid">
    <fieldset class="review-control-group">
      <legend>Overall decision</legend>
      {% for option in model.review.overall_decisions %}
      <label>
        <input type="radio" name="overall_decision" value="{{ option }}">
        {{ option.replace("_", " ") }}
      </label>
      {% endfor %}
    </fieldset>
    <div class="lab-review-overall-note">
      <label class="lab-review-note-label" for="overall_notes">Overall reviewer note</label>
      <textarea id="overall_notes" name="overall_notes" rows="5" placeholder="What should Brand3 learn from this review?"></textarea>
    </div>
  </div>
  <div class="draft-actions comparison-export-actions">
    <button class="button" type="button" data-export-lab-review-draft>Export local draft JSON</button>
    <span class="draft-export-status" data-lab-review-export-status>No review is persisted.</span>
  </div>
</section>

<script src="/static/brand3_lab_review.js?v=brand3-lab-review-20260517"></script>
{% endblock %}
