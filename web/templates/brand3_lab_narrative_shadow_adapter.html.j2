{% extends "base.html.j2" %}
{% block title %}brand3 :: {{ model.title }}{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">brand3_lab</span>
    <span class="tag">// shadow adapter · non-runtime · lab only</span>
  </div>
  <h1 class="page-title">{{ model.title }}</h1>
  <p class="prose dim intro-copy">{{ model.intro }}</p>

  <div class="badge-line">
    <span class="badge">no runtime integration</span>
    <span class="badge">no scoring changes</span>
    <span class="badge">no prompt rollout</span>
    <span class="badge">bounded schema only</span>
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">Run Trial</span>
    <span class="tag">// dry or execute</span>
  </div>
  <form method="post" class="form-row">
    <select name="mode">
      <option value="dry">dry (build artifacts only)</option>
      <option value="execute">execute (real LLM calls)</option>
    </select>
    <select name="source_mode">
      <option value="benchmark" {% if model.selected_source_mode != "run" %}selected{% endif %}>benchmark matrix (v2.1)</option>
      <option value="run" {% if model.selected_source_mode == "run" %}selected{% endif %}>single audited run_id</option>
    </select>
    <input name="run_id" type="text" value="{{ model.selected_run_id if model.selected_run_id is not none else '' }}" placeholder="run_id (required for single run)" list="available-runs" />
    <datalist id="available-runs">
      {% for row in model.available_runs %}
      <option value="{{ row.run_id }}">{{ row.label }}</option>
      {% endfor %}
    </datalist>
    <button type="submit">run shadow trial</button>
  </form>
  <p class="small form-note">Benchmark source: <span class="mono-token">{{ model.source_manifest_path }}</span></p>
  <p class="small form-note">Tip: ejecuta primero un audit normal y usa su <span class="mono-token">run_id</span> en modo <span class="mono-token">single audited run_id</span>.</p>
  {% if model.last_run %}
  <div class="lab-builder-panel">
    <h2>Last run</h2>
    <div class="kv">
      <span class="k">ok</span><span class="v">{{ model.last_run.ok }}</span>
      <span class="k">return_code</span><span class="v">{{ model.last_run.return_code }}</span>
      <span class="k">elapsed_ms</span><span class="v">{{ model.last_run.elapsed_ms }}</span>
      <span class="k">mode</span><span class="v">{{ "execute" if model.last_run.execute else "dry" }}</span>
      <span class="k">source_mode</span><span class="v">{{ model.last_run.source_mode }}</span>
      <span class="k">run_id</span><span class="v">{{ model.last_run.run_id if model.last_run.run_id is not none else "all" }}</span>
    </div>
    {% if model.last_run.stderr_tail %}
    <p class="small"><strong>stderr tail</strong></p>
    <pre class="mono">{{ model.last_run.stderr_tail }}</pre>
    {% endif %}
  </div>
  {% endif %}
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">Reading Summary</span>
    <span class="tag">// human view</span>
  </div>
  <div class="kv">
    <span class="k">estado</span><span class="v">{{ "listo para leer" if model.summary.executed else "sin ejecución" }}</span>
    <span class="k">resultado del trial</span><span class="v">{{ model.summary.trial_pass }}</span>
    <span class="k">casos leídos</span><span class="v">{{ model.summary.requests_executed }}</span>
    <span class="k">casos saltados</span><span class="v">{{ model.summary.requests_skipped }}</span>
    <span class="k">fallos de parseo</span><span class="v">{{ model.summary.parse_failures_unrecovered }}</span>
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">By Dimension</span>
    <span class="tag">// scoring-aligned overview</span>
  </div>
  <table class="report-table">
    <thead>
      <tr>
        <th>dimensión</th>
        <th>estado</th>
        <th class="num">casos</th>
        <th class="num">hallazgos</th>
        <th class="num">riesgos</th>
      </tr>
    </thead>
    <tbody>
      {% for row in model.dimension_overview %}
      <tr>
        <td>{{ row.dimension }}</td>
        <td>{{ row.status }}</td>
        <td class="num">{{ row.cases }}</td>
        <td class="num">{{ row.findings }}</td>
        <td class="num">{{ row.risk_signals }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">Findings (Human Read)</span>
    <span class="tag">// grouped by scoring dimensions</span>
  </div>
  {% if model.findings_sections %}
    {% for section in model.findings_sections %}
    <div class="lab-builder-panel">
      <h2>{{ section.dimension }}</h2>
      {% for row in section.rows %}
      <article class="finding-block">
        <p class="small">
          {{ row.case_id }}
          · estado={{ row.readiness_status }}
        </p>
        {% if row.is_empty %}
          <p class="small dim">Sin hallazgos generados para este caso/dimensión.</p>
        {% else %}
          <p><strong>{{ row.title }}</strong></p>
          <p>{{ row.observation }}</p>
          <p><strong>Lectura acotada</strong>: {{ row.bounded_interpretation }}</p>
          <p><strong>Límite</strong>: {{ row.limits }}</p>
          <details>
            <summary>Ver evidencia</summary>
            <p><strong>evidence_anchor</strong>: {{ row.evidence_anchor }}</p>
            <p><strong>evidence_urls</strong>:
              {% if row.evidence_urls %}
                {% for url in row.evidence_urls %}
                  <span class="mono-token">{{ url }}</span>{% if not loop.last %}, {% endif %}
                {% endfor %}
              {% else %}
                <span class="dim">none</span>
              {% endif %}
            </p>
          </details>
        {% endif %}
      </article>
      {% endfor %}
    </div>
    {% endfor %}
  {% else %}
    <p class="small dim">No findings available yet. Execute the trial first.</p>
  {% endif %}
</section>

<hr class="rule-thin">

<section>
  <details>
    <summary>Technical diagnostics</summary>
    <div class="section-head">
      <span class="label">Per Case</span>
      <span class="tag">// bounded output diagnostics</span>
    </div>
  <table class="report-table">
    <thead>
      <tr>
        <th>case::dimension</th>
        <th>readiness</th>
        <th class="num">findings</th>
        <th>limits</th>
        <th class="num">risky outside limits</th>
        <th>urls valid</th>
        <th>non-regressive</th>
      </tr>
    </thead>
    <tbody>
      {% for row in model.per_case_rows %}
      <tr>
        <td><span class="mono-token">{{ row.key }}</span></td>
        <td>{{ row.readiness_status }}</td>
        <td class="num">{{ row.finding_count }}</td>
        <td>{{ row.limits_present }}</td>
        <td class="num">{{ row.risky_outside_count }}</td>
        <td>{{ row.urls_valid }}</td>
        <td>{{ row.delta_non_regressive }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
    <div class="section-head">
      <span class="label">Artifacts</span>
      <span class="tag">// latest generated files</span>
    </div>
    <div class="kv artifact-kv">
      <span class="k">trial_dir</span><span class="v mono-token">{{ model.trial_dir }}</span>
      <span class="k">request_manifest</span><span class="v">{{ model.artifacts.request_manifest.created_at }}</span>
      <span class="k">raw_outputs</span><span class="v">{{ model.artifacts.raw_outputs.created_at }}</span>
      <span class="k">comparison</span><span class="v">{{ model.artifacts.comparison.created_at }}</span>
      <span class="k">cost_observation</span><span class="v">{{ model.artifacts.cost_observation.created_at }}</span>
    </div>
    <div class="kv artifact-kv">
      {% for key, value in model.summary.pass_flags.items() %}
      <span class="k">{{ key }}</span><span class="v">{{ value }}</span>
      {% endfor %}
    </div>
  </details>
</section>
{% endblock %}
