{% extends "base.html.j2" %}
{% block title %}brand3 :: Brand Audit{% endblock %}
{% block content %}
<section class="home-hero">
  <h1 class="page-title">{{ 'Auditoría de Marca' if current_lang == 'es' else 'Brand Audit' }}</h1>
  <p class="prose dim intro-copy">
    {% if current_lang == 'es' %}
    Introduce la URL de una marca para ejecutar una auditoría. Las auditorías recientes aparecen abajo y el observatorio público completo sigue a un clic.
    {% else %}
    Enter a brand URL to run an audit. Recent audits are listed below, and the full public observatory remains one click away.
    {% endif %}
  </p>

  <div class="home-scanner-shell">
    <form action="/analyze" method="post" class="form-row home-scanner-form">
      <input type="url" name="url" placeholder="https://your-brand.com" required autofocus spellcheck="false" autocomplete="off">
      {% if ui_lang == 'en' %}
      <input type="hidden" name="lang" value="en">
      {% endif %}
      <button type="submit">{{ 'ejecutar auditoría' if current_lang == 'es' else 'run audit' }}</button>
    </form>
    <p class="small dim home-secondary-actions">
      <a href="/magnetism-scanner{{ lang_suffix }}">Brand3 Scanner</a> · <a href="/visual-signature{{ lang_suffix }}">{{ 'Laboratorio de firma visual' if current_lang == 'es' else 'Visual Signature Lab' }}</a>
    </p>
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ 'auditorías_recientes' if current_lang == 'es' else 'recent_audits' }}</span>
    <span class="tag"><a href="/reports{{ lang_suffix }}">{{ 'abrir observatorio público completo' if current_lang == 'es' else 'open full public observatory' }}</a></span>
  </div>

  {% if recent_audits %}
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th class="col-date">{{ 'fecha' if current_lang == 'es' else 'date' }}</th>
          <th class="col-brand">{{ 'marca' if current_lang == 'es' else 'brand' }}</th>
          <th class="num col-score">{{ 'puntuación' if current_lang == 'es' else 'score' }}</th>
          <th class="col-bar">bar</th>
          <th class="col-band">band</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      {% for row in recent_audits %}
        <tr>
          <td>{{ row.date }}</td>
          <td><a href="/r/{{ row.token }}{{ lang_suffix }}">{{ row.brand_slug }}</a></td>
          <td class="num num-inline">{{ row.score_display }}</td>
          <td class="bar">{{ row.bar }}</td>
          <td class="dim">{{ row.band }}</td>
          <td><a href="/r/{{ row.token }}{{ lang_suffix }}">{{ 'ver' if current_lang == 'es' else 'view' }}</a></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="empty">// {% if current_lang == 'es' %}todavía no hay auditorías públicas.{% else %}no public audits yet.{% endif %}</div>
  {% endif %}
</section>
{% endblock %}
