{% extends "base.html.j2" %}
{% block title %}brand3 :: debug clasificación {{ debug.display_name or domain }}{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">debug_clasificación_mercado</span>
    <span class="tag">// {{ debug.evidence_count }} snippets · llm={{ 'available' if debug.llm_available else 'unavailable' }}</span>
  </div>
  <h1 class="page-title">{{ debug.display_name or domain }}</h1>
  <p class="small dim block-note">
    Evidencia exacta que entra en el clasificador de mercado. Esta vista no modifica tags, score ni ficha.
  </p>
  <p class="small">
    <a class="source-link" href="/brand/{{ domain }}?lang={{ current_lang }}#market-classification">volver a ficha</a>
    <a class="source-link" href="/brand/{{ domain }}/edit?lang={{ current_lang }}#market-classification">editar clasificación</a>
  </p>
</section>

<section class="brand-profile-grid">
  <section class="brand-profile-block">
    <div class="section-head">
      <span class="label">fuentes</span>
      <span class="tag">// cobertura</span>
    </div>
    {% if debug.source_counts %}
    <dl class="brand-profile-kv">
      {% for source, count in debug.source_counts.items() %}
      <dt>{{ source }}</dt><dd>{{ count }}</dd>
      {% endfor %}
    </dl>
    {% else %}
    <p class="dim">Sin snippets de evidencia.</p>
    {% endif %}
  </section>

  <section class="brand-profile-block">
    <div class="section-head">
      <span class="label">heurística</span>
      <span class="tag">// tags disparados</span>
    </div>
    {% if debug.heuristic_tags %}
    <ul class="brand-profile-evidence-list">
      {% for tag in debug.heuristic_tags %}
      <li>
        <strong>{{ tag.group }} / {{ tag.tag }}</strong>
        <span class="dim"> · {{ tag.confidence }} · {{ tag.reason_codes|join(', ') }}</span>
        {% if tag.evidence_text %}<span style="display:block;">{{ tag.evidence_text }}</span>{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="dim">La heurística no dispara tags.</p>
    {% endif %}
  </section>
</section>

<section class="brand-profile-block">
  <div class="section-head">
    <span class="label">perfil_usado</span>
    <span class="tag">// resumen generado</span>
  </div>
  <dl class="brand-profile-kv">
    {% for key, value in debug.profile.items() %}
    <dt>{{ key }}</dt><dd>{{ value or '-' }}</dd>
    {% endfor %}
  </dl>
</section>

<section class="brand-profile-block">
  <div class="section-head">
    <span class="label">snippets</span>
    <span class="tag">// input clasificador</span>
  </div>
  {% if debug.evidence %}
  <ol class="brand-profile-evidence-list">
    {% for item in debug.evidence %}
    <li>
      <span class="badge-ready">{{ item.source_type or 'unknown' }}</span>
      {% if item.url %}<a href="{{ item.url }}" rel="nofollow noopener">{{ item.url|truncate(96, true) }}</a>{% endif %}
      <p class="prose" style="margin: 6px 0 0;">{{ item.text }}</p>
    </li>
    {% endfor %}
  </ol>
  {% else %}
  <p class="dim">No hay evidencia de entrada para clasificar.</p>
  {% endif %}
</section>
{% endblock %}
