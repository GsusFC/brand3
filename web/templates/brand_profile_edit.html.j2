{% extends "base.html.j2" %}
{% block title %}brand3 :: editar {{ history.display_name or domain }}{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">edición_ficha</span>
    <span class="tag">// override humano</span>
  </div>
  <h1 class="page-title">Editar {{ history.display_name or domain }}</h1>
  <p class="small dim block-note">
    Los campos vacíos no sustituyen la ficha generada. La evidencia y el histórico de scans no se modifican.
  </p>
</section>

<form class="brand-profile-edit-form" method="post" action="/brand/{{ domain }}/edit?lang={{ current_lang }}">
  <section class="brand-profile-block">
    <div class="section-head">
      <span class="label">identidad</span>
      <span class="tag">// nombre, dominio, logo</span>
    </div>
    <div class="form-grid">
      <label>Nombre
        <input name="name" value="{{ profile.name }}" autocomplete="off">
      </label>
      <label>Dominio
        <input name="domain" value="{{ profile.domain }}" autocomplete="off">
      </label>
      <label>URL canónica
        <input name="canonical_url" value="{{ profile.official_links[0] if profile.official_links else 'https://' ~ profile.domain }}" autocomplete="off">
      </label>
      <label>Logo URL
        <input name="logo_url" value="{{ profile.logo_url }}" autocomplete="off">
      </label>
      <label>Categoría
        <input name="category" value="{{ profile.category }}" autocomplete="off">
      </label>
      <label>Editor
        <input name="updated_by" value="" placeholder="sergio" autocomplete="off">
      </label>
    </div>
  </section>

  <section class="brand-profile-block">
    <div class="section-head">
      <span class="label">lectura</span>
      <span class="tag">// texto visible en ficha</span>
    </div>
    <label>Resumen
      <textarea name="summary" rows="4">{{ profile.summary }}</textarea>
    </label>
    <label>Productos / servicios
      <textarea name="offer" rows="4">{{ profile.offer }}</textarea>
    </label>
    <label>Audiencia
      <textarea name="audience" rows="3">{{ profile.audience }}</textarea>
    </label>
    <label>Resultado
      <textarea name="outcome" rows="3">{{ profile.outcome }}</textarea>
    </label>
  </section>

  <section class="brand-profile-block">
    <div class="section-head">
      <span class="label">links</span>
      <span class="tag">// uno por línea</span>
    </div>
    <div class="form-grid">
      <label>Oficiales
        <textarea name="official_links" rows="5">{{ profile.official_links | join('\n') }}</textarea>
      </label>
      <label>Sociales
        <textarea name="social_links" rows="5">{% for item in profile.social_links %}{{ item.url if item.url is defined else item }}
{% endfor %}</textarea>
      </label>
    </div>
  </section>

  <div class="brand-profile-edit-actions">
    <a class="source-link" href="/brand/{{ domain }}?lang={{ current_lang }}">cancelar</a>
    <button class="source-link source-link-button" type="submit">guardar override</button>
  </div>
</form>

<form id="market-classification" class="brand-profile-edit-form" method="post" action="/brand/{{ domain }}/market-classification?lang={{ current_lang }}">
  <section class="brand-profile-block">
    <div class="section-head">
      <span class="label">clasificación_mercado</span>
      <span class="tag">// tags controlados</span>
    </div>
    <p class="small dim block-note">
      Contexto para filtros y benchmarking. No modifica el score.
    </p>
    <label>Categoría primaria
      <select name="primary_category">
        <option value="">auto</option>
        {% for group in market_classification.groups %}
        {% for tag in market_classification.options.get(group, []) %}
        <option value="{{ tag }}" {% if market_classification.primary_category == tag %}selected{% endif %}>{{ tag }}</option>
        {% endfor %}
        {% endfor %}
      </select>
    </label>
    <div class="brand-market-edit-grid">
      {% for group in market_classification.groups %}
      <fieldset class="brand-market-fieldset">
        <legend>{{ group }}</legend>
        {% set accepted = market_classification.accepted.get(group, []) %}
        {% for tag in market_classification.options.get(group, []) %}
        <label class="brand-market-checkbox">
          <input type="checkbox" name="{{ group }}" value="{{ tag }}" {% if tag in accepted %}checked{% endif %}>
          <span>{{ tag }}</span>
        </label>
        {% endfor %}
      </fieldset>
      {% endfor %}
    </div>
    <label>Editor
      <input name="updated_by" value="" placeholder="sergio" autocomplete="off">
    </label>
  </section>

  <div class="brand-profile-edit-actions">
    <a class="source-link" href="/brand/{{ domain }}?lang={{ current_lang }}">cancelar</a>
    <button class="source-link source-link-button" type="submit">guardar clasificación</button>
  </div>
</form>
{% endblock %}
