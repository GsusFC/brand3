{% extends "base.html.j2" %}
{% block title %}brand3 :: {{ model.t.audit }} · {{ model.display_name or model.brand_name }}{% endblock %}
{% block content %}
{% set hero_label = "brand3 scanner" %}
{% set hero_tag = model.t.audit_tag %}
{% set hero_intro = model.t.audit_intro %}
{% if model.audit.available %}
{% set audit_ctx = model.audit.context %}
{% set data_quality_class = "hl-ok" if audit_ctx.brand.data_quality == "good" else ("hl-warn" if audit_ctx.brand.data_quality == "insufficient" else "hl-accent") %}
{% set hero_metrics = [
  {"label": model.t.audit_score, "value": audit_ctx.score.global_display, "suffix": "/100", "class": "hl-accent magnetism-hero-score", "bar_width": audit_ctx.score.global or 0, "tier": audit_ctx.score.band_letter ~ " · " ~ audit_ctx.score.band_label},
  {"label": "data_quality", "value": audit_ctx.brand.data_quality, "class": data_quality_class ~ " magnetism-hero-metric-value-compact", "tier": model.t.audit_run ~ " #" ~ model.audit.source_run_id}
] %}
{% else %}
{% set hero_metrics = [
  {"label": model.t.audit, "value": "n/a", "class": "hl-warn magnetism-hero-metric-value-compact", "tier": model.audit.reason}
] %}
{% endif %}
{% include "magnetism_scan_hero.html.j2" %}

<hr class="rule-thin magnetism-compact-rule">

{% if not model.audit.available %}
<section>
  <div class="section-head">
    <span class="label">{{ model.t.audit }}</span>
    <span class="tag">// {{ model.audit.reason }}</span>
  </div>
  <article style="border:1px solid var(--border); background:var(--surface); padding:16px;">
    <p class="dim" style="font-family:var(--font-mono); font-size:13px; line-height:1.5; margin:0;">
      {{ model.t.audit_unavailable }}
    </p>
  </article>
</section>
{% else %}
{% set audit_ctx = model.audit.context %}
{% set analyst = audit_ctx.executive_analysis_v2 or {} %}
{% set analyst_dimensions = analyst.dimensions or {} %}

<section>
  <div class="section-head">
    <span class="label">{{ model.t.executive_summary }}</span>
    <span class="tag">// {{ audit_ctx.presentation_policy.headline }}</span>
  </div>
  <article class="magnetism-audit-summary">
    <p class="magnetism-audit-summary-text">
      {{ analyst.executive_summary or audit_ctx.synthesis_prose or audit_ctx.summary }}
    </p>
    {% if analyst.primary_risk or analyst.primary_opportunity %}
    <div class="magnetism-audit-summary-grid">
      {% if analyst.primary_risk %}
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.primary_risk }}</span>
        <p>{{ analyst.primary_risk }}</p>
      </div>
      {% endif %}
      {% if analyst.primary_opportunity %}
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.primary_opportunity }}</span>
        <p>{{ analyst.primary_opportunity }}</p>
      </div>
      {% endif %}
    </div>
    {% endif %}
  </article>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.dimension_audit }}</span>
    <span class="tag">// {{ audit_ctx.trust_summary.overall_status_label }}</span>
  </div>
  <div class="magnetism-audit-dimension-grid">
    {% for dim in audit_ctx.dimensions %}
    {% set analyst_dim = analyst_dimensions[dim.name] if dim.name in analyst_dimensions else none %}
    <article class="magnetism-audit-dimension-card">
      <div class="magnetism-audit-dimension-head">
        <strong>{{ model.t.dimension_names.get(dim.name, dim.display_name) }}</strong>
        <span class="badge {% if dim.confidence_status == 'good' %}badge-ready{% else %}badge-missing{% endif %}">
          {{ dim.score_display }}/100 · {{ dim.confidence_label }}
        </span>
      </div>
      {% if analyst_dim %}
      <div class="magnetism-audit-dimension-body">
        <div>
          <span class="dim magnetism-audit-mini-label">{{ model.t.diagnosis }}</span>
          <p>{{ analyst_dim.diagnosis or dim.verdict }}</p>
        </div>
        {% if analyst_dim.findings %}
        <div>
          <span class="dim magnetism-audit-mini-label">{{ model.t.findings }}</span>
          <ul>
            {% for item in analyst_dim.findings[:3] %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if analyst_dim.evidence %}
        <div>
          <span class="dim magnetism-audit-mini-label">{{ model.t.evidence }}</span>
          <ul>
            {% for item in analyst_dim.evidence[:3] %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if analyst_dim.recommendation %}
        <div class="magnetism-audit-recommendation">
          <span class="dim magnetism-audit-mini-label">{{ model.t.recommendation }}</span>
          <p>{{ analyst_dim.recommendation }}</p>
        </div>
        {% endif %}
      </div>
      {% else %}
      <p class="magnetism-audit-legacy-verdict">{{ dim.verdict }}</p>
      {% if dim.findings %}
      <div class="magnetism-audit-legacy-findings">
        {% for finding in dim.findings[:2] %}
        <div>
          <strong>{{ finding.title }}</strong>
          <span class="dim">{{ finding.observation }}</span>
        </div>
        {% endfor %}
      </div>
      {% elif dim.observations %}
      <ul class="magnetism-audit-legacy-list">
        {% for item in dim.observations[:3] %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if dim.evidence %}
      <details class="magnetism-audit-evidence-details">
        <summary class="source-link">{{ model.t.evidence }} · {{ dim.evidence|length }}</summary>
        <ul>
          {% for item in dim.evidence[:4] %}
          <li>{{ item.quote or item.source_url }}</li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
      {% endif %}
    </article>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.evidence_basis }}</span>
    <span class="tag">// Brand Audit</span>
  </div>
  <div class="magnetism-audit-evidence-strip">
    <article>
      <div class="dim magnetism-audit-mini-label">{{ model.t.total_evidence }}</div>
      <strong>{{ audit_ctx.evidence_summary.total }}</strong>
    </article>
    <article>
      <div class="dim magnetism-audit-mini-label">{{ model.t.overall_status }}</div>
      <strong>{{ audit_ctx.trust_summary.overall_status_label }}</strong>
    </article>
    <article>
      <div class="dim magnetism-audit-mini-label">{{ model.t.report_mode }}</div>
      <strong>{{ audit_ctx.readiness.report_mode }}</strong>
    </article>
  </div>
</section>

{% if model.internal_audit and model.internal_audit.available %}
{% set internal = model.internal_audit %}
{% set score_state = internal.score_state or {} %}
{% set provenance = internal.score_provenance or {} %}
{% set reviewed_score = internal.reviewed_score or {} %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.internal_audit }}</span>
    <span class="tag">// {{ model.t.internal_audit_tag }}</span>
  </div>
  <article class="magnetism-audit-summary">
    <p class="magnetism-audit-summary-text">
      {{ internal.summary }}
    </p>

    <div class="badge-line" style="margin-top: 12px;">
      <span class="badge {{ internal.status_class or 'badge-missing' }}">Score status · {{ internal.status_label or 'review-required' }}</span>
      <span class="badge {% if score_state.display_score_source == 'blocked' %}badge-error{% else %}badge-ready{% endif %}">Display decision · {{ internal.display_decision_label or score_state.display_score_source }}</span>
      <span class="badge badge-ready">Recommended action · {{ score_state.recommended_action }}</span>
      <span class="badge {% if score_state.score_integrity == 'valid' %}badge-ready{% elif score_state.score_integrity == 'unverifiable' %}badge-missing{% else %}badge-error{% endif %}">Drift type · {{ score_state.drift_type or 'none' }}</span>
      <span class="badge {% if score_state.replay_integrity.fingerprint_status == 'match' %}badge-ready{% elif score_state.replay_integrity.fingerprint_status == 'missing' %}badge-missing{% else %}badge-error{% endif %}">Fingerprint status · {{ score_state.replay_integrity.fingerprint_status }}</span>
      <span class="badge">internal-only</span>
    </div>

    <div class="magnetism-audit-evidence-strip">
      <article>
        <div class="dim magnetism-audit-mini-label">{{ model.t.score_integrity }}</div>
        <strong>{{ score_state.score_integrity }}</strong>
      </article>
      <article>
        <div class="dim magnetism-audit-mini-label">{{ model.t.display_score_source }}</div>
        <strong>{{ score_state.display_score_source }}</strong>
      </article>
      <article>
        <div class="dim magnetism-audit-mini-label">{{ model.t.display_score }}</div>
        <strong>
          {% if score_state.display_score_blocked %}
          blocked
          {% elif score_state.recommended_display_score is not none %}
          {{ score_state.recommended_display_score }}/100
          {% else %}
          n/a
          {% endif %}
        </strong>
      </article>
      <article>
        <div class="dim magnetism-audit-mini-label">{{ model.t.recommended_action }}</div>
        <strong>{{ score_state.recommended_action }}</strong>
      </article>
    </div>

    <div class="magnetism-audit-summary-grid">
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.computed_score }}</span>
        <p>{% if score_state.computed_composite_score is not none %}{{ score_state.computed_composite_score }}/100{% else %}n/a{% endif %}</p>
      </div>
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.reviewed_score }}</span>
        <p>{% if score_state.reviewed_composite_score is not none %}{{ score_state.reviewed_composite_score }}/100{% else %}none{% endif %}</p>
      </div>
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.display_score }}</span>
        <p>
          {% if score_state.display_score_blocked %}
          blocked
          {% elif score_state.recommended_display_score is not none %}
          {{ score_state.recommended_display_score }}/100
          {% else %}
          n/a
          {% endif %}
        </p>
      </div>
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.score_summary }}</span>
        <p>{{ score_state.score_integrity }}</p>
      </div>
    </div>

    <div class="magnetism-audit-summary-grid">
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.fallback_flags }}</span>
        <p>
          {% if score_state.fallback_flags.replay_neutral_fallback_dimensions %}
          {{ score_state.fallback_flags.replay_neutral_fallback_dimensions|join(', ') }}
          {% else %}
          none
          {% endif %}
        </p>
      </div>
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.warnings }}</span>
        <p>{{ provenance.warnings|length }}</p>
      </div>
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.rules_caps }}</span>
        <p>{{ provenance.rules_applied|length }}</p>
      </div>
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.dimension_breakdown }}</span>
        <p>{{ provenance.dimension_breakdown|length }}</p>
      </div>
    </div>

    {% if score_state.computed_composite_score is not none or score_state.reviewed_composite_score is not none %}
    <div class="magnetism-audit-summary-grid">
      {% if score_state.computed_composite_score is not none %}
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.computed_score }}</span>
        <p>{{ score_state.computed_composite_score }}/100</p>
      </div>
      {% endif %}
      {% if score_state.reviewed_composite_score is not none %}
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.reviewed_score }}</span>
        <p>{{ score_state.reviewed_composite_score }}/100</p>
      </div>
      {% endif %}
      {% if score_state.limited_confidence %}
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.score_summary }}</span>
        <p>limited confidence</p>
      </div>
      {% endif %}
    </div>
    {% endif %}

    {% if reviewed_score %}
    <div class="magnetism-audit-summary-grid">
      <div>
        <span class="dim magnetism-audit-mini-label">{{ model.t.reviewed_score_block }}</span>
        <p>{{ reviewed_score.reviewed_composite_score }}/100 · {{ reviewed_score.review_status }}</p>
      </div>
      <div>
        <span class="dim magnetism-audit-mini-label">reason</span>
        <p>{{ reviewed_score.reason }}</p>
      </div>
      <div>
        <span class="dim magnetism-audit-mini-label">evidence refs</span>
        <p>{{ reviewed_score.evidence_refs|length }}</p>
      </div>
    </div>
    {% endif %}
  </article>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.dimension_breakdown }}</span>
    <span class="tag">// {{ model.t.score_summary }}</span>
  </div>
  <div class="magnetism-audit-dimension-grid">
    {% for dim_name, dim in provenance.dimension_breakdown.items() %}
    <article class="magnetism-audit-dimension-card">
      <div class="magnetism-audit-dimension-head">
        <strong>{{ dim_name }}</strong>
        <span class="badge {% if dim.replay.unavailable %}badge-missing{% else %}badge-ready{% endif %}">
          {% if dim.score is not none %}{{ dim.score }}/100{% else %}n/a{% endif %} · {{ dim.confidence_label }}
        </span>
      </div>
      <div class="magnetism-audit-dimension-body">
        <div>
          <span class="dim magnetism-audit-mini-label">{{ model.t.confidence_summary }}</span>
          <p>{{ dim.confidence_status }} · {{ dim.coverage_label }}</p>
        </div>
        <div>
          <span class="dim magnetism-audit-mini-label">{{ model.t.rules_caps }}</span>
          {% if dim.rules_applied %}
          <ul>
            {% for rule in dim.rules_applied %}
            <li>{{ rule }}</li>
            {% endfor %}
          </ul>
          {% else %}
          <p class="dim">none</p>
          {% endif %}
        </div>
        <div>
          <span class="dim magnetism-audit-mini-label">{{ model.t.score_summary }}</span>
          <p>
            persisted={{ dim.replay.persisted if dim.replay.persisted is not none else 'n/a' }},
            artifact={{ dim.replay.artifact if dim.replay.artifact is not none else 'n/a' }},
            recomputed={{ dim.replay.recomputed if dim.replay.recomputed is not none else 'n/a' }}
          </p>
        </div>
        {% if dim.replay.unavailable %}
        <div>
          <span class="dim magnetism-audit-mini-label">{{ model.t.fallback_flags }}</span>
          <p>unavailable=true</p>
        </div>
        {% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.confidence_summary }}</span>
    <span class="tag">// {{ model.t.internal_audit }}</span>
  </div>
  <div class="magnetism-audit-dimension-grid">
    {% for dim_name, dim in provenance.confidence_summary.items() %}
    <article class="magnetism-audit-dimension-card">
      <div class="magnetism-audit-dimension-head">
        <strong>{{ dim_name }}</strong>
        <span class="badge {% if dim.confidence_status == 'good' %}badge-ready{% else %}badge-missing{% endif %}">
          {{ dim.confidence_label }} · {{ dim.coverage_label }}
        </span>
      </div>
      <div class="magnetism-audit-dimension-body">
        <div>
          <span class="dim magnetism-audit-mini-label">status</span>
          <p>{{ dim.confidence_status }}</p>
        </div>
        <div>
          <span class="dim magnetism-audit-mini-label">missing</span>
          <p>{{ dim.missing_signals|join(', ') if dim.missing_signals else 'none' }}</p>
        </div>
        <div>
          <span class="dim magnetism-audit-mini-label">next steps</span>
          <p>{{ dim.recommended_next_steps|join(' · ') if dim.recommended_next_steps else 'none' }}</p>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.fallback_flags }}</span>
    <span class="tag">// {{ model.t.audit_status }}</span>
  </div>
  <article class="magnetism-audit-summary">
    <div class="magnetism-audit-summary-grid">
      <div>
        <span class="dim magnetism-audit-mini-label">replay_unavailable_dimensions</span>
        <p>{{ provenance.fallback_flags.replay_unavailable_dimensions|join(', ') if provenance.fallback_flags.replay_unavailable_dimensions else 'none' }}</p>
      </div>
      <div>
        <span class="dim magnetism-audit-mini-label">replay_neutral_fallback_dimensions</span>
        <p>{{ provenance.fallback_flags.replay_neutral_fallback_dimensions|join(', ') if provenance.fallback_flags.replay_neutral_fallback_dimensions else 'none' }}</p>
      </div>
      <div>
        <span class="dim magnetism-audit-mini-label">readiness_fallback_dimensions</span>
        <p>{{ provenance.fallback_flags.readiness_fallback_dimensions|join(', ') if provenance.fallback_flags.readiness_fallback_dimensions else 'none' }}</p>
      </div>
    </div>
    <div class="magnetism-audit-summary-grid">
      {% for dim_name, items in provenance.fallback_flags.missing_high_weight_features.items() %}
      <div>
        <span class="dim magnetism-audit-mini-label">{{ dim_name }}</span>
        <p>{{ items|join(', ') }}</p>
      </div>
      {% endfor %}
      {% if not provenance.fallback_flags.missing_high_weight_features %}
      <div>
        <span class="dim magnetism-audit-mini-label">missing_high_weight_features</span>
        <p>none</p>
      </div>
      {% endif %}
    </div>
  </article>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.warnings }}</span>
    <span class="tag">// {{ model.t.audit_status }}</span>
  </div>
  <article class="magnetism-audit-summary">
    {% if provenance.warnings %}
    <ul>
      {% for warning in provenance.warnings %}
      <li>
        <strong>{{ warning.code }}</strong>
        <span class="dim">· {{ warning.message }}</span>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="dim">none</p>
    {% endif %}
  </article>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.tldr_v2_internal_summary }}</span>
    <span class="tag">// {{ model.t.internal_audit_tag }}</span>
  </div>
  <article class="magnetism-audit-summary">
    <p class="magnetism-audit-summary-text">
      {{ internal.summary }}
    </p>
    <details class="magnetism-audit-evidence-details">
      <summary class="source-link">{{ model.t.fingerprint_details }}</summary>
      <ul>
        <li>status: {{ score_state.score_integrity }}</li>
        <li>fingerprint: {{ score_state.replay_integrity.fingerprint_status }}</li>
        <li>persisted fingerprint: {{ score_state.replay_integrity.persisted_scoring_state_fingerprint or 'n/a' }}</li>
        <li>current fingerprint: {{ score_state.replay_integrity.current_scoring_state_fingerprint or 'n/a' }}</li>
      </ul>
    </details>
    <details class="magnetism-audit-evidence-details">
      <summary class="source-link">{{ model.t.raw_feature_provenance }}</summary>
      <ul>
        {% for dim_name, dim in provenance.feature_provenance_summary.items() %}
        <li>
          <strong>{{ dim_name }}</strong>
          <span class="dim">· {{ dim.feature_count }} features · {{ dim.evidence_count }} evidence items</span>
          {% if dim.feature_names %}
          <div class="dim">{{ dim.feature_names|join(', ') }}</div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </details>
  </article>
</section>
{% endif %}
{% endif %}
{% endblock %}
