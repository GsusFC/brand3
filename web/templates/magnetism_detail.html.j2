{% extends "base.html.j2" %}
{% block title %}brand3 :: {{ model.title }}{% endblock %}
{% block content %}
<section class="magnetism-hero-section">
  <div class="section-head">
    <span class="label">magnetism scanner</span>
    <span class="tag">// {{ model.t.result }}</span>
  </div>
  {% include "magnetism_scan_nav.html.j2" %}
  <div class="magnetism-hero-grid">
    <div class="magnetism-hero-main">
      <h1 class="page-title magnetism-hero-title">{{ model.brand_name }}</h1>
      {% if model.quadrant %}
      <p class="prose intro-copy magnetism-hero-verdict">
        {{ model.quadrant }}
      </p>
      {% endif %}
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">Magnetism</div>
      <div class="hl-accent magnetism-hero-score">
        {{ model.magnetism_score }}<span>/100</span>
      </div>
      <div class="magnetism-score-bar" aria-hidden="true">
        <span style="--score-width: {{ model.magnetism_score }}%;"></span>
      </div>
      <div class="dim magnetism-hero-tier">{{ model.metrics.magnetism_tier }}</div>
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">{{ model.t.coherence|title }}</div>
      <div class="hl-ok magnetism-hero-score">
        {{ model.coherence_score }}<span>/100</span>
      </div>
      <div class="magnetism-score-bar magnetism-score-bar-ok" aria-hidden="true">
        <span style="--score-width: {{ model.coherence_score }}%;"></span>
      </div>
      <div class="dim magnetism-hero-tier">{{ model.metrics.coherence_tier }}</div>
    </div>
  </div>

  {% if model.deprecation and model.deprecation.status == 'deprecated' %}
  <div style="border: 1px solid var(--warning); background: color-mix(in srgb, var(--warning) 8%, transparent); padding: 10px 12px; margin: 12px 0 0; font-family: var(--font-mono); font-size: 11px; line-height: 1.45;">
    legacy_extraction: this scan did not use the canonical Brand Audit snapshot pipeline. replacement={{ model.deprecation.replacement }}
  </div>
  {% endif %}

  <div hidden aria-hidden="true">
    <div class="lab-index-meta" style="margin: 10px 0 12px; display: flex; flex-wrap: wrap; gap: 14px;">
      <span class="inline-kv"><span class="k">brand_name</span>=<span class="v">{{ model.brand_name }}</span></span>
      {% if model.url and model.url != 'manual' and model.url != 'Manual Upload' %}
      <span class="inline-kv"><span class="k">source_url</span>=<span class="v"><a href="{{ model.url }}" target="_blank" rel="noopener noreferrer">{{ model.url }}</a></span></span>
      {% else %}
      <span class="inline-kv"><span class="k">source_url</span>=<span class="v">Manual Copy/Paste</span></span>
      {% endif %}
      <span class="inline-kv"><span class="k">quadrant</span>=<span class="v hl-accent" style="font-weight: 600;">{{ model.quadrant }}</span></span>
      {% if model.source_run_id %}
      <span class="inline-kv"><span class="k">brand_audit_run</span>=<span class="v">#{{ model.source_run_id }}</span></span>
      {% endif %}
      <span class="inline-kv"><span class="k">extraction_mode</span>=<span class="v">{{ model.extraction_mode }}</span></span>
      {% if model.canonical_evidence_source %}
      <span class="inline-kv"><span class="k">canonical_source</span>=<span class="v">{{ model.canonical_evidence_source }}</span></span>
      {% elif model.direct_source_provider %}
      <span class="inline-kv"><span class="k">direct_source</span>=<span class="v">{{ model.direct_source_provider }}</span></span>
      {% endif %}
    </div>
    <div class="badge-line" style="margin-top: 10px;">
      {% if model.extraction_mode == 'canonical_snapshot' %}
      <span class="badge badge-ready">Canonical Brand Audit Snapshot</span>
      {% elif model.source == 'brand_audit_snapshot' %}
      <span class="badge badge-ready">Brand Audit Evidence</span>
      {% elif model.extraction_mode == 'legacy_direct' %}
      <span class="badge badge-error">Legacy Direct Extraction</span>
      {% elif model.fallback_used %}
      <span class="badge badge-error">Heuristic Fallback Engine</span>
      {% else %}
      <span class="badge badge-ready">AI-Studio Signal Extractor</span>
      {% endif %}
      <span class="badge">Magenta Circle v1.0</span>
      {% if model.evidence_packet_summary and model.evidence_packet_summary.source_label %}
      <span class="badge">{{ model.evidence_packet_summary.source_label }}</span>
      {% endif %}
    </div>
    {% if model.evidence_packet_summary and model.evidence_packet_summary.evidence_basis %}
    <p class="dim" style="font-family: var(--font-mono); font-size: 11px; margin: 10px 0 0;">
      evidence_basis: {{ model.evidence_packet_summary.evidence_basis }}
    </p>
    {% endif %}
    {% if model.content_distillation_summary %}
    <div class="dim" style="font-family: var(--font-mono); font-size: 11px; margin-top: 10px;">
      content_distillation: selected={{ model.content_distillation_summary.selected_count or 0 }} · rejected={{ model.content_distillation_summary.rejected_count or 0 }} · quality={{ model.content_distillation_summary.quality_score or 0 }}/100
    </div>
    {% if model.content_distillation_summary.warnings %}
    <div class="dim" style="font-family: var(--font-mono); font-size: 10px; line-height: 1.45; margin-top: 8px;">
      warnings: {{ model.content_distillation_summary.warnings | join('; ') }}
    </div>
    {% endif %}
    {% endif %}
  </div>
</section>

<hr class="rule-thin magnetism-compact-rule">

<section class="magnetism-tldr-section">
  {% if model.tldr_strategy %}
  <div hidden aria-hidden="true">
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
      <span class="badge">{{ model.tldr_strategy.mode or "method" }}</span>
      {% if model.tldr_strategy.verdict_vs_current %}<span class="inline-kv"><span class="k">verdict</span>=<span class="v">{{ model.tldr_strategy.verdict_vs_current }}</span></span>{% endif %}
    </div>
    {% if model.tldr_strategy.main_gain %}<div><span class="dim">gain:</span> {{ model.tldr_strategy.main_gain }}</div>{% endif %}
    {% if model.tldr_strategy.main_risk %}<div><span class="dim">risk:</span> {{ model.tldr_strategy.main_risk }}</div>{% endif %}
    {% if model.tldr_strategy.validation_notes %}
    <details style="color: var(--muted);">
      <summary style="cursor:pointer; color: var(--muted);">Guardrail corrections · {{ model.tldr_strategy.validation_notes|length }}</summary>
      <ul style="margin: 8px 0 0 16px; padding: 0; display: grid; gap: 4px;">
        {% for note in model.tldr_strategy.validation_notes[:6] %}
        <li>{{ note }}</li>
        {% endfor %}
        {% if model.tldr_strategy.validation_notes|length > 6 %}<li>+{{ model.tldr_strategy.validation_notes|length - 6 }} more</li>{% endif %}
      </ul>
    </details>
    {% endif %}
  </div>
  {% endif %}

  <div class="section-head">
    <span class="label">TLDR Brand3</span>
    <span class="tag">// {{ model.t.detail_tag }}</span>
  </div>

  {% set blocks = [
    ("core_purpose", "CORE PURPOSE"),
    ("magnetism", "MAGNETISM"),
    ("value_proposition", "VALUE PROPOSITION"),
    ("personality", "PERSONALITY"),
    ("brand_idea", "BRAND IDEA"),
    ("attributes", "ATTRIBUTES"),
    ("values", "VALUES"),
    ("mission", "MISSION"),
    ("vision", "VISION")
  ] %}
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-top: 14px;">
    {% for key, label in blocks %}
    {% set block = model.tldr_brand3[key] %}
    <div style="border: 1px solid var(--border); background: var(--soft-panel-bg); padding: 14px; min-height: 190px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px;">
      <div>
        <div class="magnetism-card-head">
          <div class="magnetism-card-title-stack">
            <span class="hl-accent magnetism-card-title">{{ label }}</span>
            <span class="dim magnetism-card-path">
              {{ block.source_signal_path or block.source_signal or "Magenta signal" }}
            </span>
          </div>
          <span hidden aria-hidden="true">{{ block.claim_type or "absent" }} · {{ block.confidence or "low" }}</span>
        </div>
        <span hidden aria-hidden="true">
          source signal: {{ block.source_signal_path or block.source_signal or "Magenta signal" }}
        </span>
        {% if block.detected %}
          {% if block.content is iterable and block.content is not string %}
          <div style="display:flex; flex-wrap:wrap; gap:6px;">
            {% for item in block.content %}
            <span class="badge">{{ item }}</span>
            {% endfor %}
          </div>
          {% else %}
          <p class="magnetism-card-result">{{ block.content }}</p>
          {% endif %}
        {% else %}
        <p class="dim magnetism-card-result">{{ model.t.no_detected }}</p>
        {% endif %}
      </div>
      <div style="display:grid; gap:7px;">
        {% if block.evidence_used or block.evidence %}
        {% set evidence_items = block.evidence_used or block.evidence %}
        <div hidden aria-hidden="true">
          <span style="color: var(--muted); text-transform: uppercase; letter-spacing: .04em;">Evidence</span><br>
          {% if evidence_items is iterable and evidence_items is not string %}
            {{ evidence_items[0] }}{% if evidence_items|length > 1 %} +{{ evidence_items|length - 1 }} more{% endif %}
          {% else %}
            {{ evidence_items }}
          {% endif %}
        </div>
        {% endif %}
        {% if block.reasoning or block.rationale or block.counter_evidence or block.mode %}
        <div hidden aria-hidden="true">
          <span>Method notes{% if block.human_review_recommended %} · review{% endif %}</span>
          <div style="display:grid; gap:6px; margin-top:8px; line-height:1.35;">
            <span>mode: {{ block.mode or "not_detected" }}</span>
            {% if block.reasoning or block.rationale %}<span>reasoning: {{ block.reasoning or block.rationale }}</span>{% endif %}
            {% if block.counter_evidence %}<span>limitation: {{ block.counter_evidence | join("; ") }}</span>{% endif %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

{% if model.system_reading and (model.system_reading.strategic_tensions or model.system_reading.validation_questions or (model.system_reading.credibility_support and model.system_reading.credibility_support.status == 'observed')) %}
<section>
  <div class="section-head">
    <span class="label">{{ model.t.system_reading }}</span>
    <span class="tag">// {{ model.t.system_reading_tag }}</span>
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; margin-top: 14px;">
    {% if model.system_reading.credibility_support and model.system_reading.credibility_support.status == 'observed' %}
    <article class="lab-detail-block" style="border: 1px solid var(--border); padding: 18px; background: var(--surface);">
      <h2 style="font-family: var(--font-ui); font-size: 13px; text-transform: uppercase; color: var(--accent); font-weight: 700; margin: 0 0 10px;">{{ model.t.credibility_support }}</h2>
      <p class="dim" style="font-family: var(--font-mono); font-size: 11px; line-height: 1.5; margin: 0 0 10px;">proof_points={{ model.system_reading.credibility_support.count }} · {{ model.system_reading.credibility_support.reading }}</p>
      {% if model.system_reading.credibility_support.evidence %}
      <ul style="margin: 0; padding-left: 18px; font-family: var(--font-mono); font-size: 12px; line-height: 1.55; color: var(--text);">
        {% for proof in model.system_reading.credibility_support.evidence %}
        <li style="margin-bottom: 8px;">
          {{ proof.text }}
          {% if proof.url %}<br><span class="dim">{{ proof.url }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </article>
    {% endif %}
    {% if model.system_reading.strategic_tensions %}
    <article class="lab-detail-block" style="border: 1px solid var(--border); padding: 18px; background: var(--surface);">
      <h2 style="font-family: var(--font-ui); font-size: 13px; text-transform: uppercase; color: var(--accent); font-weight: 700; margin: 0 0 10px;">{{ model.t.strategic_tensions }}</h2>
      <ul style="margin: 0; padding-left: 18px; font-family: var(--font-mono); font-size: 12px; line-height: 1.55; color: var(--text);">
        {% for tension in model.system_reading.strategic_tensions %}
        <li style="margin-bottom: 8px;">{{ tension }}</li>
        {% endfor %}
      </ul>
    </article>
    {% endif %}
    {% if model.system_reading.validation_questions %}
    <article class="lab-detail-block" style="border: 1px solid var(--border); padding: 18px; background: var(--surface);">
      <h2 style="font-family: var(--font-ui); font-size: 13px; text-transform: uppercase; color: var(--success); font-weight: 700; margin: 0 0 10px;">{{ model.t.validation_questions }}</h2>
      <ul style="margin: 0; padding-left: 18px; font-family: var(--font-mono); font-size: 12px; line-height: 1.55; color: var(--text);">
        {% for question in model.system_reading.validation_questions %}
        <li style="margin-bottom: 8px;">{{ question }}</li>
        {% endfor %}
      </ul>
    </article>
    {% endif %}
  </div>
  {% if model.system_reading.derived_from %}
  <p class="dim" style="font-family: var(--font-mono); font-size: 10px; margin: 10px 0 0;">derived_from: {{ model.system_reading.derived_from }}</p>
  {% endif %}
</section>

<hr class="rule-thin">

{% endif %}

<section>
  <div class="section-head">
    <span class="label">{{ model.t.diagnosis }}</span>
    <span class="tag">// {{ model.t.diagnosis_tag }}</span>
  </div>
  <div style="background: var(--soft-panel-bg); border: 1px solid var(--border); padding: 22px; margin-top: 14px;">
    <h2 style="font-family: var(--font-mono); font-size: 18px; margin: 0 0 14px; font-weight: 700; color: var(--accent);">{{ model.diagnosis.headline }}</h2>
    <ul style="margin: 0; padding-left: 18px; font-family: var(--font-mono); font-size: 13px; line-height: 1.6; color: var(--text);">
      {% for observation in model.diagnosis.key_observations %}
      <li style="margin-bottom: 8px;">{{ observation }}</li>
      {% endfor %}
    </ul>
    {% if model.limitations %}
    <hr class="rule" style="margin: 16px 0; border-top: 1px dashed var(--border);">
    <div class="dim" style="font-family: var(--font-mono); font-size: 12px;">{{ model.t.limitations }}: {{ model.limitations|join('; ') }}</div>
    {% endif %}
  </div>
</section>
{% endblock %}
