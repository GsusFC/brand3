{% extends "base.html.j2" %}
{% block title %}brand3 :: {{ model.t.evidence_reliability }} · {{ model.display_name or model.brand_name }}{% endblock %}
{% block content %}
<section class="magnetism-hero-section">
  <div class="section-head">
    <span class="label">magnetism scanner</span>
    <span class="tag">// {{ model.t.evidence_reliability_tag }}</span>
  </div>
  {% include "magnetism_scan_nav.html.j2" %}
  <div class="magnetism-hero-grid">
    <div class="magnetism-hero-main">
      <h1 class="page-title magnetism-hero-title">{{ model.display_name or model.brand_name }}</h1>
      <p class="prose intro-copy magnetism-hero-verdict">
        {{ model.t.evidence_reliability_intro }}
      </p>
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">{{ model.t.quality_status }}</div>
      <div class="{% if model.quality.status == 'pass' %}hl-ok{% elif model.quality.status == 'fail' %}hl-warn{% else %}hl-accent{% endif %}" style="font-family: var(--font-mono); font-size: 22px; line-height: 1.1;">
        {{ model.quality.status }}
      </div>
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">{{ model.t.quality_score }}</div>
      <div class="hl-accent" style="font-family: var(--font-mono); font-size: 22px; line-height: 1.1;">
        {% if model.quality.total_score is not none %}{{ model.quality.total_score }}{% else %}n/a{% endif %}
      </div>
    </div>
  </div>
</section>

<hr class="rule-thin magnetism-compact-rule">

{% if not model.quality.available %}
<section>
  <div class="section-head">
    <span class="label">{{ model.t.quality_status }}</span>
    <span class="tag">// {{ model.quality.reason }}</span>
  </div>
  <article style="border:1px solid var(--border); background:var(--surface); padding:16px; margin-top:14px;">
    <p class="dim" style="font-family:var(--font-mono); font-size:13px; line-height:1.5; margin:0;">
      {{ model.t.quality_missing }}
    </p>
  </article>
</section>
{% else %}
<section>
  <div class="section-head">
    <span class="label">{{ model.t.quality_gate }}</span>
    <span class="tag">// {{ model.quality.version }}</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:12px; margin-top:14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:16px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">gate_passed</div>
      <strong class="{% if model.quality.gate.passed %}hl-ok{% else %}hl-warn{% endif %}" style="font-family:var(--font-ui); font-size:18px;">
        {{ model.quality.gate.passed }}
      </strong>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:16px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">total_score</div>
      <strong style="font-family:var(--font-ui); font-size:18px;">{{ model.quality.total_score }}</strong>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:16px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">diagnostic_status</div>
      <strong style="font-family:var(--font-ui); font-size:18px;">{{ model.quality.status }}</strong>
    </article>
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.quality_dimensions }}</span>
    <span class="tag">// {{ model.t.quality_dimensions_tag }}</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:12px; margin-top:14px;">
    {% for dimension in model.quality.dimensions %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div style="display:flex; justify-content:space-between; gap:8px; align-items:flex-start;">
        <strong style="font-family:var(--font-ui); font-size:13px;">{{ dimension.label }}</strong>
        <span class="badge {% if dimension.status == 'pass' %}badge-ready{% else %}badge-missing{% endif %}">{{ dimension.status }} · {{ dimension.score }}</span>
      </div>
      {% if dimension.reasons %}
      <ul style="margin:10px 0 0; padding-left:18px; font-family:var(--font-mono); font-size:12px; line-height:1.5;">
        {% for reason in dimension.reasons %}
        <li>{{ reason }}</li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="dim" style="font-family:var(--font-mono); font-size:12px; margin:10px 0 0;">pass</p>
      {% endif %}
    </article>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.quality_warnings }}</span>
    <span class="tag">// {{ model.t.quality_failures }}</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:12px; margin-top:14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">{{ model.t.quality_warnings }}</strong>
      {% if model.quality.warnings %}
      <ul style="margin:10px 0 0; padding-left:18px; font-family:var(--font-mono); font-size:12px; line-height:1.5;">
        {% for warning in model.quality.warnings %}
        <li>{{ warning }}</li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="dim" style="font-family:var(--font-mono); font-size:12px;">{{ model.t.no_quality_warnings }}</p>
      {% endif %}
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">{{ model.t.quality_failures }}</strong>
      {% if model.quality.gate.failures %}
      <ul style="margin:10px 0 0; padding-left:18px; font-family:var(--font-mono); font-size:12px; line-height:1.5;">
        {% for failure in model.quality.gate.failures %}
        <li>{{ failure }}</li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="dim" style="font-family:var(--font-mono); font-size:12px;">{{ model.t.no_quality_failures }}</p>
      {% endif %}
    </article>
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.quality_pack_summary }}</span>
    <span class="tag">// research_pack</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-top:14px;">
    {% for label, value in model.quality.pack_summary.items() %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">{{ label }}</div>
      <strong style="font-family:var(--font-ui); font-size:16px; overflow-wrap:anywhere;">{{ value }}</strong>
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endblock %}
