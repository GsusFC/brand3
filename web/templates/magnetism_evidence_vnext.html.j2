{% extends "base.html.j2" %}
{% block title %}brand3 :: evidence vNext - {{ model.brand_name }}{% endblock %}
{% block content %}
{% set report = model.report %}
{% set totals = report.totals %}
{% set row = model.row %}
{% set readiness_rows = report.readiness_matrix.rows if report.readiness_matrix else [] %}
{% set readiness = readiness_rows[0] if readiness_rows else {} %}
{% set work_order = report.work_orders[0] if report.work_orders else {} %}
{% set adjudication = report.adjudication_intake if report.adjudication_intake else {} %}

<section class="magnetism-hero-section">
  <div class="section-head">
    <span class="label">evidence vNext</span>
    <span class="tag">// read-only diagnostic</span>
  </div>
  <div class="magnetism-hero-grid">
    <div class="magnetism-hero-main">
      <h1 class="page-title magnetism-hero-title">{{ model.brand_name }}</h1>
      <p class="prose intro-copy magnetism-hero-verdict">
        Brand Audit run #{{ model.run_id }} - {{ model.url or "snapshot" }}
      </p>
      <div class="badge-line" style="margin-top:12px;">
        <span class="badge badge-ready">runtime_effect={{ model.diagnostic.runtime_effect }}</span>
        <span class="badge badge-ready">prompt_effect={{ model.diagnostic.prompt_effect }}</span>
        <span class="badge badge-ready">persistence_effect={{ model.diagnostic.persistence_effect }}</span>
      </div>
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">promotion</div>
      <div class="{% if row.promotion_status == 'blocked' %}hl-warn{% else %}hl-ok{% endif %} magnetism-hero-metric-value-compact">
        {{ row.promotion_status or "unknown" }}
      </div>
      {% if row.promotion_reason_codes %}
      <div class="dim magnetism-hero-tier">{{ row.promotion_reason_codes | join(', ') }}</div>
      {% endif %}
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">readiness</div>
      <div class="{% if readiness.readiness_status == 'blocked_after_shadow_policy' %}hl-warn{% else %}hl-accent{% endif %} magnetism-hero-metric-value-compact">
        {{ readiness.readiness_status or report.recommendation.status or "unknown" }}
      </div>
      {% if readiness.next_action %}
      <div class="dim magnetism-hero-tier">{{ readiness.next_action }}</div>
      {% endif %}
    </div>
  </div>
  <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:14px;">
    <a class="source-link" href="{{ model.back_href }}">{{ "volver al scanner" if model.lang == "es" else "back to scanner" }}</a>
    <a class="source-link" href="{{ model.json_href }}">{{ model.t.evidence_vnext_json }}</a>
  </div>
</section>

<hr class="rule-thin magnetism-compact-rule">

<section>
  <div class="section-head">
    <span class="label">operator path</span>
    <span class="tag">// what happens next</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:12px; margin-top:14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">promotion path</div>
      <strong class="hl-accent" style="font-family:var(--font-mono); font-size:16px;">
        {{ readiness.current_promotion_status or row.promotion_status or "unknown" }} -> {{ readiness.projected_promotion_status or row.promotion_status or "unknown" }}
      </strong>
      <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5; margin:8px 0 0;">
        readiness={{ readiness.readiness_status or report.recommendation.status or "unknown" }}
      </p>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">next action</div>
      <strong class="{% if readiness.human_required %}hl-warn{% else %}hl-ok{% endif %}" style="font-family:var(--font-mono); font-size:16px;">
        {{ readiness.next_action or "none" }}
      </strong>
      <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5; margin:8px 0 0;">
        human_required={{ readiness.human_required }} · lane={{ readiness.automation_lane or "unknown" }}
      </p>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">adjudication</div>
      <strong class="{% if adjudication.pending_count %}hl-warn{% else %}hl-ok{% endif %}" style="font-family:var(--font-mono); font-size:16px;">
        {{ adjudication.status or "empty" }}
      </strong>
      <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5; margin:8px 0 0;">
        pending={{ adjudication.pending_count or 0 }} · work_orders={{ report.work_orders | length }}
      </p>
    </article>
  </div>

  {% if readiness.remaining_reason_codes %}
  <div class="badge-line" style="margin-top:12px;">
    {% for reason in readiness.remaining_reason_codes %}
    <span class="badge {% if readiness.human_required %}badge-error{% endif %}">{{ reason }}</span>
    {% endfor %}
  </div>
  {% endif %}

  {% if work_order %}
  <article style="border:1px solid var(--border); background:var(--surface); padding:14px; margin-top:14px;">
    <div class="section-head" style="margin-bottom:8px;">
      <span class="label">{{ work_order.work_order_id }}</span>
      <span class="tag">{{ work_order.expected_output }} · {{ work_order.priority }}</span>
    </div>
    <strong style="font-family:var(--font-ui); font-size:14px;">{{ work_order.task }}</strong>
    <p class="prose" style="font-size:13px; line-height:1.55; margin:8px 0 0;">{{ work_order.closure_criteria }}</p>
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:12px; margin-top:12px;">
      <div>
        <div class="dim" style="font-family:var(--font-mono); font-size:11px;">checklist</div>
        <ul style="margin:8px 0 0; padding-left:18px; font-size:13px; line-height:1.55;">
          {% for item in work_order.checklist %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <div class="dim" style="font-family:var(--font-mono); font-size:11px;">decision template</div>
        <pre style="white-space:pre-wrap; border:1px solid var(--border); background:var(--bg); padding:10px; font-size:11px; line-height:1.45; margin:8px 0 0;">{{ work_order.decision_record_template }}</pre>
      </div>
    </div>
    {% if work_order.context.review_urls or work_order.context.profile_urls or work_order.context.affected_material_fields %}
    <div class="badge-line" style="margin-top:12px;">
      {% for url in work_order.context.profile_urls or [] %}
      <span class="badge badge-missing">profile={{ url }}</span>
      {% endfor %}
      {% for url in work_order.context.review_urls or [] %}
      <span class="badge">review_url={{ url }}</span>
      {% endfor %}
      {% for field in work_order.context.affected_material_fields or [] %}
      <span class="badge badge-error">field={{ field }}</span>
      {% endfor %}
    </div>
    {% endif %}
  </article>
  {% endif %}
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">gate summary</span>
    <span class="tag">// accepted, review, rejected</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap:12px; margin-top:14px;">
    {% for label, value, klass in [
      ("accepted", totals.accepted, "hl-ok"),
      ("review", totals.review_required, "hl-warn"),
      ("rejected", totals.rejected, "hl-accent"),
      ("noise_delta", totals.reclassified_to_noise, "hl-accent"),
      ("changed_fields", totals.changed_fields, "hl-accent"),
      ("lost_fields", totals.lost_fields, "hl-warn")
    ] %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">{{ label }}</div>
      <strong class="{{ klass }}" style="font-family:var(--font-mono); font-size:24px; font-variant-numeric: tabular-nums;">{{ value or 0 }}</strong>
    </article>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">run decision</span>
    <span class="tag">// current vNext state</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>run</th>
          <th>brand</th>
          <th>status</th>
          <th>promotion</th>
          <th>manual audit</th>
          <th>material lost</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>#{{ row.run_id or model.run_id }}</td>
          <td>{{ row.brand_name or model.brand_name }}</td>
          <td>{{ row.status or "unknown" }}</td>
          <td>{{ row.promotion_status or "unknown" }}</td>
          <td>{{ row.manual_audit_required }}</td>
          <td class="num num-inline">{{ row.material_lost_fields or 0 }}</td>
        </tr>
      </tbody>
    </table>
  </div>
  {% if row.scorecard_reason_codes or row.promotion_reason_codes %}
  <div class="badge-line" style="margin-top:12px;">
    {% for reason in row.scorecard_reason_codes or [] %}
    <span class="badge">{{ reason }}</span>
    {% endfor %}
    {% for reason in row.promotion_reason_codes or [] %}
    <span class="badge badge-error">{{ reason }}</span>
    {% endfor %}
  </div>
  {% endif %}
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">reason counts</span>
    <span class="tag">// review and rejection pressure</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:12px; margin-top:14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">review reasons</strong>
      <div class="badge-line" style="margin-top:10px;">
        {% for reason, count in report.top_review_reasons.items() %}
        <span class="badge badge-missing">{{ reason }}={{ count }}</span>
        {% else %}
        <span class="dim" style="font-family:var(--font-mono); font-size:12px;">none</span>
        {% endfor %}
      </div>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">rejected reasons</strong>
      <div class="badge-line" style="margin-top:10px;">
        {% for reason, count in report.top_rejected_reasons.items() %}
        <span class="badge">{{ reason }}={{ count }}</span>
        {% else %}
        <span class="dim" style="font-family:var(--font-mono); font-size:12px;">none</span>
        {% endfor %}
      </div>
    </article>
  </div>
</section>

{% if report.acquisition_matrix and (report.acquisition_matrix.provider_rows or report.acquisition_matrix.source_class_rows) %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">acquisition matrix</span>
    <span class="tag">// provider and source-class gate outcomes</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:12px; margin-top:14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">providers</strong>
      <div class="table-wrap" style="margin-top:10px;">
        <table>
          <thead>
            <tr>
              <th>provider</th>
              <th class="num">ok</th>
              <th class="num">review</th>
              <th class="num">reject</th>
            </tr>
          </thead>
          <tbody>
            {% for item in report.acquisition_matrix.provider_rows %}
            <tr>
              <td>{{ item.provider }}</td>
              <td class="num num-inline">{{ item.accepted or 0 }}</td>
              <td class="num num-inline">{{ item.review_required or 0 }}</td>
              <td class="num num-inline">{{ item.rejected or 0 }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">source classes</strong>
      <div class="table-wrap" style="margin-top:10px;">
        <table>
          <thead>
            <tr>
              <th>source_class</th>
              <th class="num">ok</th>
              <th class="num">review</th>
              <th class="num">reject</th>
            </tr>
          </thead>
          <tbody>
            {% for item in report.acquisition_matrix.source_class_rows %}
            <tr>
              <td>{{ item.source_class }}</td>
              <td class="num num-inline">{{ item.accepted or 0 }}</td>
              <td class="num num-inline">{{ item.review_required or 0 }}</td>
              <td class="num num-inline">{{ item.rejected or 0 }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </article>
  </div>
</section>
{% endif %}

{% if report.semantic_evidence %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">semantic shadow</span>
    <span class="tag">// materiality over accepted evidence</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:12px; margin-top:14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">classifier</div>
      <strong class="hl-accent" style="font-family:var(--font-mono); font-size:14px;">{{ report.semantic_evidence.classifier or "none" }}</strong>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">accepted_material</div>
      <strong class="hl-ok" style="font-family:var(--font-mono); font-size:24px;">{{ report.semantic_evidence.accepted_material or 0 }}</strong>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">accepted_weak</div>
      <strong class="hl-warn" style="font-family:var(--font-mono); font-size:24px;">{{ report.semantic_evidence.accepted_weak or 0 }}</strong>
    </article>
  </div>
  {% if report.semantic_evidence.semantic_class_counts %}
  <div class="table-wrap" style="margin-top:14px;">
    <table>
      <thead>
        <tr>
          <th>semantic_class</th>
          <th class="num">count</th>
        </tr>
      </thead>
      <tbody>
        {% for class_name, count in report.semantic_evidence.semantic_class_counts.items() %}
        <tr>
          <td>{{ class_name }}</td>
          <td class="num num-inline">{{ count }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% if report.semantic_evidence.weak_examples %}
  <div class="table-wrap" style="margin-top:14px;">
    <table>
      <thead>
        <tr>
          <th>weak accepted example</th>
          <th>class</th>
          <th>source</th>
        </tr>
      </thead>
      <tbody>
        {% for item in report.semantic_evidence.weak_examples[:6] %}
        <tr>
          <td>{{ item.text_preview }}</td>
          <td>{{ item.semantic_class }}</td>
          <td><a class="source-link" href="{{ item.url }}">{{ item.url }}</a></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% if report.semantic_llm %}
  <div style="border:1px solid var(--border); background:var(--surface); padding:14px; margin-top:14px;">
    <strong style="font-family:var(--font-ui); font-size:13px;">llm shadow</strong>
    <div class="badge-line" style="margin-top:10px;">
      {% for status, count in report.semantic_llm.status_counts.items() %}
      <span class="badge">{{ status }}={{ count }}</span>
      {% endfor %}
      <span class="badge badge-ready">class_delta={{ report.semantic_llm.semantic_class_disagreement_count or 0 }}</span>
      <span class="badge badge-ready">materiality_delta={{ report.semantic_llm.materiality_disagreement_count or 0 }}</span>
    </div>
    {% if report.semantic_llm.models %}
    <p class="dim" style="margin:8px 0 0; font-family:var(--font-mono); font-size:12px;">models={{ report.semantic_llm.models }}</p>
    {% endif %}
  </div>
  {% endif %}
</section>
{% endif %}

{% if report.acquisition_contract_exclusions %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">shadow exclusions</span>
    <span class="tag">// acquisition contract dry run</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:12px; margin-top:14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">by contract</strong>
      <p class="dim" style="margin:8px 0 0;">{{ report.acquisition_contract_exclusions.total or 0 }} items would be excluded before evidence construction.</p>
      <div class="table-wrap" style="margin-top:10px;">
        <table>
          <thead>
            <tr>
              <th>contract</th>
              <th class="num">excluded</th>
            </tr>
          </thead>
          <tbody>
            {% for contract, count in report.acquisition_contract_exclusions.by_contract.items() %}
            <tr>
              <td>{{ contract }}</td>
              <td class="num num-inline">{{ count }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">by surface</strong>
      <div class="table-wrap" style="margin-top:10px;">
        <table>
          <thead>
            <tr>
              <th>surface</th>
              <th class="num">excluded</th>
            </tr>
          </thead>
          <tbody>
            {% for surface, count in report.acquisition_contract_exclusions.by_surface.items() %}
            <tr>
              <td>{{ surface }}</td>
              <td class="num num-inline">{{ count }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </article>
  </div>
</section>
{% endif %}

{% if report.provider_acquisition_contracts %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">provider contracts</span>
    <span class="tag">// proposed acquisition rules</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>contract</th>
          <th>provider</th>
          <th>severity</th>
          <th>status</th>
          <th class="num">affected</th>
          <th>action</th>
        </tr>
      </thead>
      <tbody>
        {% for item in report.provider_acquisition_contracts %}
        <tr>
          <td>{{ item.contract }}</td>
          <td>{{ item.provider }}</td>
          <td>{{ item.severity }}</td>
          <td>{{ item.implementation_status }}</td>
          <td class="num num-inline">{{ item.affected_observation_count or 0 }}</td>
          <td>
            <div>{{ item.recommended_action }}</div>
            <div class="dim" style="font-family:var(--font-mono); font-size:11px; margin-top:4px;">{{ item.enforcement_point }}</div>
            <div class="dim" style="font-family:var(--font-mono); font-size:11px; margin-top:4px;">{{ item.next_step }}</div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

{% if report.provider_contract_backlog %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">contract backlog</span>
    <span class="tag">// implementation lanes</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:12px; margin-top:14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">status summary</strong>
      <div class="table-wrap" style="margin-top:10px;">
        <table>
          <thead>
            <tr>
              <th>status</th>
              <th class="num">contracts</th>
              <th class="num">obs</th>
            </tr>
          </thead>
          <tbody>
            {% for status, count in report.provider_contract_backlog.counts.items() %}
            <tr>
              <td>{{ status }}</td>
              <td class="num num-inline">{{ count }}</td>
              <td class="num num-inline">{{ report.provider_contract_backlog.observation_counts.get(status, 0) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">next work</strong>
      <div class="table-wrap" style="margin-top:10px;">
        <table>
          <thead>
            <tr>
              <th>contract</th>
              <th>lane</th>
              <th class="num">affected</th>
              <th>next</th>
            </tr>
          </thead>
          <tbody>
            {% for item in report.provider_contract_backlog.rows %}
            <tr>
              <td>{{ item.contract }}</td>
              <td>{{ item.implementation_lane }}</td>
              <td class="num num-inline">{{ item.affected_observation_count or 0 }}</td>
              <td>{{ item.next_step }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </article>
  </div>
</section>
{% endif %}

{% if report.review_examples_by_reason or report.rejected_examples_by_reason %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">source examples</span>
    <span class="tag">// acquisition evidence behind the gate</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:12px; margin-top:14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">review examples</strong>
      <div style="display:grid; gap:10px; margin-top:10px;">
        {% for reason, examples in report.review_examples_by_reason.items() %}
          {% for example in examples[:3] %}
          <div style="border:1px solid var(--border); background:var(--soft-panel-bg); padding:10px;">
            <div class="badge-line">
              <span class="badge badge-missing">{{ reason }}</span>
              <span class="badge">{{ example.provider or "unknown_provider" }}</span>
              <span class="badge">{{ example.source_class or "unknown_source" }}</span>
            </div>
            <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5; margin:8px 0 0;">{{ example.text_preview or "-" }}</p>
            {% if example.url %}
            <a href="{{ example.url }}" target="_blank" rel="noopener noreferrer" style="display:block; margin-top:8px; font-family:var(--font-mono); font-size:11px; overflow-wrap:anywhere;">{{ example.url }}</a>
            {% endif %}
          </div>
          {% endfor %}
        {% else %}
        <span class="dim" style="font-family:var(--font-mono); font-size:12px;">none</span>
        {% endfor %}
      </div>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">rejected examples</strong>
      <div style="display:grid; gap:10px; margin-top:10px;">
        {% for reason, examples in report.rejected_examples_by_reason.items() %}
          {% for example in examples[:3] %}
          <div style="border:1px solid var(--border); background:var(--soft-panel-bg); padding:10px;">
            <div class="badge-line">
              <span class="badge">{{ reason }}</span>
              <span class="badge">{{ example.provider or "unknown_provider" }}</span>
              <span class="badge">{{ example.source_class or "unknown_source" }}</span>
            </div>
            <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5; margin:8px 0 0;">{{ example.text_preview or "-" }}</p>
            {% if example.url %}
            <a href="{{ example.url }}" target="_blank" rel="noopener noreferrer" style="display:block; margin-top:8px; font-family:var(--font-mono); font-size:11px; overflow-wrap:anywhere;">{{ example.url }}</a>
            {% endif %}
          </div>
          {% endfor %}
        {% else %}
        <span class="dim" style="font-family:var(--font-mono); font-size:12px;">none</span>
        {% endfor %}
      </div>
    </article>
  </div>
</section>
{% endif %}

{% if report.decision_queue %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">decision queue</span>
    <span class="tag">// next human or policy action</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>priority</th>
          <th>action</th>
          <th>runs</th>
          <th>reasons</th>
        </tr>
      </thead>
      <tbody>
        {% for item in report.decision_queue %}
        <tr>
          <td>{{ item.priority }}</td>
          <td>{{ item.action }}</td>
          <td>{{ item.affected_runs | join(', ') }}</td>
          <td>{{ item.reason_codes | join(', ') }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

{% if report.work_orders %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">work orders</span>
    <span class="tag">// adjudication intake</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>work order</th>
          <th>task</th>
          <th>expected output</th>
          <th>allowed decisions</th>
        </tr>
      </thead>
      <tbody>
        {% for item in report.work_orders[:12] %}
        <tr>
          <td>{{ item.work_order_id }}</td>
          <td>{{ item.task }}</td>
          <td>{{ item.expected_output }}</td>
          <td>{{ item.allowed_decisions | join(', ') }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% if report.adjudication_intake %}
  <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5; margin-top:10px;">
    adjudication_status={{ report.adjudication_intake.status }} - pending={{ report.adjudication_intake.pending_count }}
  </p>
  {% endif %}
</section>
{% endif %}
{% endblock %}
