{% extends "base.html.j2" %}
{% block title %}brand3 :: {{ model.t.moodboard }} · {{ model.brand_name }}{% endblock %}
{% block content %}
<section class="magnetism-hero-section">
  <div class="section-head">
    <span class="label">magnetism scanner</span>
    <span class="tag">// {{ model.t.moodboard_tag }}</span>
  </div>
  {% include "magnetism_scan_nav.html.j2" %}
  <div class="magnetism-hero-grid">
    <div class="magnetism-hero-main">
      <h1 class="page-title magnetism-hero-title">{{ model.brand_name }}</h1>
      <p class="prose intro-copy magnetism-hero-verdict">
        {{ model.t.moodboard_intro }}
      </p>
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">{{ model.t.moodboard_inventory }}</div>
      <div class="hl-accent magnetism-hero-metric-value-compact" style="font-family: var(--font-mono);">
        {{ model.moodboard.image_count }}
      </div>
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">Magnetism</div>
      <div class="hl-ok magnetism-hero-metric-value-compact" style="font-family: var(--font-mono);">
        {{ model.magnetism_score }}<span>/100</span>
      </div>
    </div>
  </div>
</section>

<hr class="rule-thin magnetism-compact-rule">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.moodboard }}</span>
    <span class="tag">// {{ model.t.moodboard_hint }}</span>
    {% if model.moodboard.available %}
    <button class="source-link source-link-button moodboard-shuffle" type="button" data-moodboard-shuffle>{{ model.t.moodboard_shuffle }}</button>
    {% endif %}
  </div>
  {% if model.moodboard.available %}
  <div class="scan-loader-stage cloud-stage" data-moodboard-stage aria-label="{{ model.t.moodboard }}">
    <div class="cloud-layer" data-cloud-layer></div>
    <canvas class="scan-loader-grain" data-moodboard-grain></canvas>
    <div class="scan-loader-vignette"></div>
  </div>
  <p class="dim" style="font-family: var(--font-mono); font-size: 10px; margin: 8px 0 0;">
    {{ model.t.moodboard_source_note }}
  </p>
  <script type="application/json" data-moodboard-items>{{ model.moodboard.images | tojson }}</script>
  <script src="/static/brand3_cloud.js?v={{ static_asset_version }}" defer></script>
  <script src="/static/moodboard.js?v={{ static_asset_version }}" defer></script>
  {% else %}
  <div class="moodboard-empty">
    <p class="dim" style="font-family: var(--font-mono); font-size: 12px; margin: 0;">// {{ model.t.moodboard_empty }}</p>
  </div>
  {% endif %}
</section>

{% if model.moodboard.visual_reading %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.moodboard_visual_reading }}</span>
    <span class="tag">// {{ model.t.moodboard_visual_reading_tag }}</span>
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; margin-top: 14px;">
    {% for item in model.moodboard.visual_reading %}
    <article class="lab-detail-block" style="border: 1px solid var(--border); padding: 18px; background: var(--surface);">
      <h2 style="font-family: var(--font-ui); font-size: 13px; text-transform: uppercase; color: var(--accent); font-weight: 700; margin: 0 0 10px;">
        {{ model.t.tldr_block_names[item.key] or item.key }}
      </h2>
      <p style="font-family: var(--font-mono); font-size: 12px; line-height: 1.55; color: var(--text); margin: 0;">{{ item.text }}</p>
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if model.moodboard.available %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.moodboard_inventory }}</span>
    <span class="tag">// {{ model.t.moodboard_inventory_tag }}</span>
  </div>
  <div style="overflow-x: auto; margin-top: 14px;">
    <table class="table" style="width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 11px;">
      <thead>
        <tr>
          <th style="text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border);">url</th>
          <th style="text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border);">{{ model.t.moodboard_role }}</th>
          <th style="text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border);">{{ model.t.moodboard_alt }}</th>
        </tr>
      </thead>
      <tbody>
        {% for image in model.moodboard.images %}
        <tr>
          <td style="padding: 6px 10px; border-bottom: 1px solid var(--border); max-width: 480px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            <a href="{{ image.url }}" target="_blank" rel="noopener noreferrer">{{ image.url }}</a>
          </td>
          <td style="padding: 6px 10px; border-bottom: 1px solid var(--border);"><span class="badge">{{ model.t.moodboard_roles[image.role] or image.role }}</span></td>
          <td style="padding: 6px 10px; border-bottom: 1px solid var(--border);" class="dim">{{ image.alt or "—" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}
{% endblock %}
