{% extends "base.html.j2" %}
{% block title %}brand3 :: {{ model.t.research_evidence }} · {{ model.display_name or model.brand_name }}{% endblock %}
{% block content %}
{% set hero_label = "magnetism scanner" %}
{% set hero_tag = model.t.research_tag %}
{% set hero_intro = model.t.research_intro %}
{% set hero_metrics = [
  {"label": model.t.pack_source, "value": model.research.research_pack_source, "class": "hl-accent magnetism-hero-metric-value-compact"},
  {"label": model.t.tldr_mode, "value": model.research.tldr_generation_mode, "class": "hl-ok magnetism-hero-metric-value-compact"}
] %}
{% include "magnetism_scan_hero.html.j2" %}

<hr class="rule-thin magnetism-compact-rule">

<nav aria-label="{{ model.t.research_sections }}" style="display:flex; flex-wrap:wrap; gap:8px; margin:0 0 18px;">
  <a class="source-link" href="#entity-resolution">{{ model.t.entity_resolution }}</a>
  {% if model.research.entity_boundary_warnings or model.research.entity_boundary_rejections %}<a class="source-link" href="#entity-boundary">{{ model.t.entity_boundary_warnings }}</a>{% endif %}
  <a class="source-link" href="#research-pack">{{ model.t.research_pack }}</a>
  <a class="source-link" href="#surface-map">{{ model.t.surface_map }}</a>
  {% if model.research.competitive_context %}<a class="source-link" href="#competitive-context">{{ model.t.competitive_context }}</a>{% endif %}
  <a class="source-link" href="#parallel-shadow">{{ model.t.parallel_shadow }}</a>
  <a class="source-link" href="#tldr-evidence">{{ model.t.tldr_evidence }}</a>
  {% if model.research.noise_rejected or model.research.evidence_gaps %}<a class="source-link" href="#rejected-gaps">{{ model.t.rejected_gaps }}</a>{% endif %}
</nav>

<section id="entity-resolution">
  <div class="section-head">
    <span class="label">{{ model.t.entity_resolution }}</span>
    <span class="tag">// {{ model.t.entity_tag }}</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; margin-top: 14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:16px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">resolved_entity</div>
      <strong style="font-family:var(--font-ui); font-size:18px;">{{ model.research.entity.resolved_entity or model.display_name or model.brand_name }}</strong>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:16px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">entity_type</div>
      <strong style="font-family:var(--font-ui); font-size:18px;">{{ model.research.entity.entity_type or "unknown" }}</strong>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:16px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">entity_scope</div>
      <strong style="font-family:var(--font-ui); font-size:18px;">{{ model.research.entity.entity_scope or "unknown" }}</strong>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:16px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px;">parent_brand</div>
      <strong style="font-family:var(--font-ui); font-size:18px;">{{ model.research.entity.parent_brand or "none" }}</strong>
    </article>
  </div>
</section>

<hr class="rule-thin">

<section id="entity-boundary">
  <div class="section-head">
    <span class="label">{{ model.t.entity_boundary_warnings }}</span>
    <span class="tag">// {{ model.t.entity_boundary_warnings_tag }}</span>
  </div>
  {% if model.research.entity_boundary_warnings or model.research.entity_boundary_rejections %}
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:12px; margin-top:14px;">
    {% if model.research.entity_boundary_warnings %}
    <article style="border:1px solid var(--warning); background:color-mix(in srgb, var(--warning) 8%, transparent); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">{{ model.t.entity_boundary_warnings }}</strong>
      <ul style="margin:10px 0 0; padding-left:18px; font-family:var(--font-mono); font-size:12px; line-height:1.5;">
        {% for warning in model.research.entity_boundary_warnings %}
        <li>{{ warning }}</li>
        {% endfor %}
      </ul>
    </article>
    {% endif %}
    {% if model.research.entity_boundary_rejections %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">{{ model.t.entity_boundary_rejections }}</strong>
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:8px; margin-top:10px;">
        {% for item in model.research.entity_boundary_rejections[:6] %}
        <div style="border:1px solid var(--border); background:var(--soft-panel-bg); padding:10px;">
          {% if item.source_type %}<span class="badge">{{ item.source_type }}</span>{% endif %}
          <p class="dim" style="font-family:var(--font-mono); font-size:11px; line-height:1.4; margin:7px 0 0; display:-webkit-box; -webkit-line-clamp:4; -webkit-box-orient:vertical; overflow:hidden;">{{ item.text }}</p>
          {% if item.source_url %}
          <a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer" style="display:block; margin-top:7px; font-family:var(--font-mono); font-size:11px; overflow-wrap:anywhere;">{{ model.t.entity_boundary_open_source }}</a>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </article>
    {% endif %}
  </div>
  {% else %}
  <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5;">{{ model.t.no_entity_boundary_warnings }}</p>
  {% endif %}
</section>

<hr class="rule-thin">

<section id="research-pack">
  <div class="section-head">
    <span class="label">{{ model.t.research_pack }}</span>
    <span class="tag">// {{ model.t.research_pack_tag }}</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:12px; margin-top:14px;">
    {% for label, value in [
      ("category", model.research.category),
      ("offer", model.research.offer),
      ("company_summary", model.research.company_summary),
      ("product_summary", model.research.product_summary),
      ("audience", model.research.audience),
      ("outcome", model.research.outcome),
      ("declared_mission", model.research.declared_mission),
      ("future_direction", model.research.future_direction)
    ] %}
    {% if value %}
    <article style="border:1px solid var(--border); background:var(--soft-panel-bg); padding:14px;">
      <div class="dim" style="font-family:var(--font-mono); font-size:11px; text-transform:uppercase;">{{ label }}</div>
      <p style="margin:6px 0 0; font-family:var(--font-mono); font-size:13px; line-height:1.5;">{{ value }}</p>
    </article>
    {% endif %}
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section id="surface-map">
  <div class="section-head">
    <span class="label">{{ model.t.surface_map }}</span>
    <span class="tag">// {{ model.t.surface_map_tag }}</span>
  </div>
  <div class="badge-line">
    {% for source_type, count in model.research.source_counts.items() %}
    <span class="badge">{{ source_type }}={{ count }}</span>
    {% endfor %}
  </div>

  {% if model.research.product_surfaces %}
  <h2 style="font-family:var(--font-ui); font-size:14px; margin:20px 0 10px;">{{ model.t.product_surfaces }}</h2>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:8px;">
    {% for surface in model.research.product_surfaces %}
    <div style="border:1px solid var(--border); background:var(--surface); padding:10px 12px;">
      <span class="badge badge-ready">{{ surface.entity_scope or surface.role }}</span>
      <a class="source-link" href="{{ surface.url }}" target="_blank" rel="noopener noreferrer">{{ surface.url }}</a>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if model.research.source_rows %}
  <h2 style="font-family:var(--font-ui); font-size:14px; margin:22px 0 10px;">{{ model.t.source_map }}</h2>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:8px;">
    {% for source in model.research.source_rows[:40] %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:10px 12px;">
      <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
        <span class="badge">{{ source.source_type }}</span>
        {% if source.entity_scope %}<span class="badge">{{ source.entity_scope }}</span>{% endif %}
        {% if source.surface_role %}<span class="badge">{{ source.surface_role }}</span>{% endif %}
      </div>
      <a href="{{ source.url }}" target="_blank" rel="noopener noreferrer" style="display:block; margin-top:8px; font-family:var(--font-mono); font-size:12px; overflow-wrap:anywhere;">{{ source.url }}</a>
    </article>
    {% endfor %}
  </div>
  {% endif %}
</section>

<hr class="rule-thin">

{% if model.research.competitive_context %}
<section id="competitive-context">
  <div class="section-head">
    <span class="label">{{ model.t.competitive_context }}</span>
    <span class="tag">// {{ model.t.competitive_context_tag }}</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:8px; margin-top:14px;">
    {% for item in model.research.competitive_context[:8] %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:10px 12px;">
      <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
        <span class="badge">{{ item.source_type or "competitive_context" }}</span>
        <span class="badge">{{ item.kind }}</span>
      </div>
      <p style="margin:8px 0 0; font-family:var(--font-mono); font-size:12px; line-height:1.45;">{{ item.text }}</p>
      {% if item.source_url %}
      <a href="{{ item.source_url }}" target="_blank" rel="noopener noreferrer" style="display:block; margin-top:8px; font-family:var(--font-mono); font-size:12px; overflow-wrap:anywhere;">{{ item.source_url }}</a>
      {% endif %}
    </article>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">
{% endif %}

<section id="parallel-shadow">
  <div class="section-head">
    <span class="label">{{ model.t.parallel_shadow }}</span>
    <span class="tag">// {{ model.t.parallel_shadow_tag }}</span>
  </div>
  <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5; max-width:860px; margin:10px 0 0;">
    {{ model.t.parallel_shadow_intro }}
  </p>
  {% if model.research.shadow_sources %}
  <div style="display:grid; gap:14px; margin-top:14px;">
    {% for shadow in model.research.shadow_sources %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div style="display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px; align-items:flex-start;">
        <div>
          <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
            <span class="badge badge-ready">{{ shadow.provider }}</span>
            <span class="badge">{{ shadow.mode }}</span>
            <span class="badge">{{ shadow.status }}</span>
          </div>
          {% if shadow.notes %}
          <p class="dim" style="font-family:var(--font-mono); font-size:11px; line-height:1.45; margin:8px 0 0;">{{ shadow.notes[0] }}</p>
          {% endif %}
        </div>
        <div style="display:flex; gap:16px; font-family:var(--font-mono); font-size:12px;">
          <span>results={{ shadow.result_total }}</span>
          <span>domains={{ shadow.unique_domain_count }}</span>
        </div>
      </div>

      {% if shadow.readout %}
      <div style="margin-top:14px;">
        <strong style="font-family:var(--font-ui); font-size:13px;">{{ model.t.parallel_shadow_readout }}</strong>
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap:10px; margin-top:10px;">
          <div style="border:1px solid var(--border); background:var(--soft-panel-bg); padding:12px;">
            <div class="dim" style="font-family:var(--font-mono); font-size:11px;">{{ model.t.parallel_shadow_coverage }}</div>
            <div style="display:grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap:8px; margin-top:8px;">
              <div>
                <div class="dim" style="font-family:var(--font-mono); font-size:10px;">{{ model.t.parallel_shadow_candidate_count }}</div>
                <strong style="font-family:var(--font-ui); font-size:18px;">{{ shadow.readout.result_total }}</strong>
              </div>
              <div>
                <div class="dim" style="font-family:var(--font-mono); font-size:10px;">{{ model.t.parallel_shadow_domain_count }}</div>
                <strong style="font-family:var(--font-ui); font-size:18px;">{{ shadow.readout.unique_domain_count }}</strong>
              </div>
            </div>
            {% if shadow.readout.domain_summary %}
            <p class="dim" style="font-family:var(--font-mono); font-size:11px; line-height:1.45; margin:7px 0 0;">{{ shadow.readout.domain_summary }}</p>
            {% endif %}
          </div>
          <div style="border:1px solid var(--border); background:var(--soft-panel-bg); padding:12px;">
            <div class="dim" style="font-family:var(--font-mono); font-size:11px;">{{ model.t.parallel_shadow_signal_types }}</div>
            {% if shadow.readout.signal_types %}
            <div class="badge-line" style="margin-top:8px;">
              {% for signal in shadow.readout.signal_types %}
              <span class="badge">{{ signal.label }}={{ signal.result_count }}</span>
              {% endfor %}
            </div>
            {% else %}
            <p class="dim" style="font-family:var(--font-mono); font-size:11px; margin:8px 0 0;">none</p>
            {% endif %}
          </div>
        </div>
      </div>
      {% endif %}

      {% if shadow.unique_domains %}
      <div style="margin-top:12px;">
        <strong style="font-family:var(--font-ui); font-size:12px;">{{ model.t.parallel_shadow_domains }}</strong>
        <div class="badge-line" style="margin-top:8px;">
          {% for domain in shadow.unique_domains[:12] %}
          <span class="badge">{{ domain }}</span>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if shadow.intents %}
      <div style="margin-top:14px;">
        <strong style="font-family:var(--font-ui); font-size:12px;">{{ model.t.parallel_shadow_intents }}</strong>
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap:8px; margin-top:8px;">
          {% for intent in shadow.intents %}
          <div style="border:1px solid var(--border); background:var(--soft-panel-bg); padding:10px;">
            <div style="display:flex; justify-content:space-between; gap:8px; align-items:flex-start;">
              <strong style="font-family:var(--font-ui); font-size:12px;">{{ intent.name }}</strong>
              <span class="badge {% if intent.status == 'ok' %}badge-ready{% else %}badge-missing{% endif %}">{{ intent.status }}</span>
            </div>
            <p class="dim" style="font-family:var(--font-mono); font-size:11px; margin:8px 0 0;">results={{ intent.result_count }}</p>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {% if shadow.readout.review_candidates %}
      <div style="margin-top:14px;">
        <strong style="font-family:var(--font-ui); font-size:12px;">{{ model.t.parallel_shadow_manual_review }}</strong>
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:8px; margin-top:8px;">
          {% for result in shadow.readout.review_candidates %}
          <div style="border:1px solid var(--border); background:var(--soft-panel-bg); padding:10px 12px;">
            <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
              <span class="badge">{{ result.label }}</span>
              <a href="{{ result.url }}" target="_blank" rel="noopener noreferrer" style="font-family:var(--font-mono); font-size:12px; overflow-wrap:anywhere;">{{ result.title }}</a>
            </div>
            {% if result.excerpt %}
            <p class="dim" style="font-family:var(--font-mono); font-size:11px; line-height:1.45; margin:7px 0 0;">{{ result.excerpt }}</p>
            {% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </article>
    {% endfor %}
  </div>
  {% else %}
  <article style="border:1px solid var(--border); background:var(--surface); padding:14px; margin-top:14px;">
    <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5; margin:0;">{{ model.t.parallel_shadow_missing }}</p>
  </article>
  {% endif %}
</section>

<hr class="rule-thin">

<section id="tldr-evidence">
  <div class="section-head">
    <span class="label">{{ model.t.tldr_evidence }}</span>
    <span class="tag">// {{ model.t.tldr_evidence_tag }}</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:12px; margin-top:14px;">
    {% for block in model.research.block_evidence %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <div style="display:flex; justify-content:space-between; gap:8px; align-items:flex-start;">
        <strong style="font-family:var(--font-ui); font-size:13px;">{{ block.label }}</strong>
        <span class="badge">{{ block.claim_type }} · {{ block.confidence }}</span>
      </div>
      {% if block.answer %}
      <p style="font-family:var(--font-mono); font-size:12px; line-height:1.45;">{{ block.answer }}</p>
      {% endif %}
      {% if block.evidence_used %}
      <ul style="margin:10px 0 0; padding-left:18px; font-family:var(--font-mono); font-size:11px; line-height:1.45;">
        {% for item in block.evidence_used[:3] %}
        <li>{{ item }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </article>
    {% endfor %}
  </div>
</section>

{% if model.research.noise_rejected or model.research.evidence_gaps %}
<hr class="rule-thin">

<section id="rejected-gaps">
  <div class="section-head">
    <span class="label">{{ model.t.rejected_gaps }}</span>
    <span class="tag">// {{ model.t.rejected_gaps_tag }}</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:12px; margin-top:14px;">
    {% if model.research.evidence_gaps %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">{{ model.t.evidence_gaps }}</strong>
      <ul style="margin:10px 0 0; padding-left:18px; font-family:var(--font-mono); font-size:12px; line-height:1.5;">
        {% for gap in model.research.evidence_gaps %}
        <li>{{ gap }}</li>
        {% endfor %}
      </ul>
    </article>
    {% endif %}
    {% if model.research.noise_rejected %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">{{ model.t.rejected_noise }}</strong>
      <ul style="margin:10px 0 0; padding-left:18px; font-family:var(--font-mono); font-size:12px; line-height:1.5;">
        {% for item in model.research.noise_rejected[:8] %}
        <li>{{ item.text }}</li>
        {% endfor %}
      </ul>
    </article>
    {% endif %}
  </div>
</section>
{% endif %}
{% endblock %}
