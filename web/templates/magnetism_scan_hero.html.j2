<section class="magnetism-hero-section">
  <div class="section-head">
    <span class="label">{{ hero_label }}</span>
    <span class="tag">// {{ hero_tag }}</span>
  </div>
  {% include "magnetism_scan_nav.html.j2" %}
  <div class="magnetism-hero-grid magnetism-hero-grid-{{ hero_metrics|length }}">
    <div class="magnetism-hero-main">
      <h1 class="page-title magnetism-hero-title">{{ model.display_name or model.brand_name }}</h1>
      {% if model.display_url %}
      <a class="magnetism-hero-url" href="{{ model.display_url }}" target="_blank" rel="noopener">
        {{ model.display_url }}
      </a>
      {% endif %}
      <p class="prose intro-copy magnetism-hero-verdict">
        {{ hero_intro }}
      </p>
    </div>
    {% for metric in hero_metrics %}
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">{{ metric.label }}</div>
      <div class="{{ metric.class }}" style="font-family: var(--font-mono);">
        {{ metric.value }}{% if metric.suffix %}<span>{{ metric.suffix }}</span>{% endif %}
      </div>
      {% if metric.bar_width is defined %}
      <div class="magnetism-score-bar" aria-hidden="true">
        <span style="--score-width: {{ metric.bar_width }}%;"></span>
      </div>
      {% endif %}
      {% if metric.tier %}
      <div class="dim magnetism-hero-tier">{{ metric.tier }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</section>
