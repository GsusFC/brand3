{% extends "base.html.j2" %}
{% block title %}Brand3 :: Magnetism Scanner{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">magnetism_scanner</span>
    <span class="tag">// competitive analysis and 7-layer audit</span>
  </div>

  <h1 class="page-title">Brand Magnetism Scanner</h1>
  <p class="prose dim intro-copy">
    Evaluate a startup's brand power. Map its strategic positioning across the 7 layers of the Magenta Circle framework, score its competitive magnetism and message coherence, and check its location on the 2x2 positioning quadrant.
  </p>

  <form action="/magnetism-scanner/analyze" method="post">
    <div class="form-row">
      <input type="url" name="url" placeholder="https://your-brand.com" autofocus spellcheck="false" autocomplete="off" style="flex: 1 1 380px;">
      <button type="submit">Scan Brand</button>
    </div>

    <details style="margin-top: 18px; cursor: pointer; color: var(--text-muted); font-size: 12px; max-width: 820px;">
      <summary style="font-weight: 600; font-family: var(--font-ui); outline: none; user-select: none;">❯ Manual text block input (CORS / Scraper Fallback)</summary>
      <div style="margin-top: 10px; cursor: default;">
        <label for="manual_text" style="display: block; margin-bottom: 6px; color: var(--text-soft); font-weight: 500;">Raw website content / landing page copy:</label>
        <textarea id="manual_text" name="manual_text" rows="8" placeholder="Paste website homepage text copy here..." style="width: 100%; background: var(--surface); color: var(--text); border: 1px solid var(--border); font-family: var(--font-mono); padding: 10px; font-size: 12px; resize: vertical; display: block; border-radius: 0; outline: none;"></textarea>
        <p class="small dim form-note" style="margin-top: 6px; color: var(--text-soft);">
          If scraping is blocked by Cloudflare, or direct crawler access fails, paste the copied home page text above to run the 7-layer analysis.
        </p>
      </div>
    </details>
  </form>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">from_brand_audit</span>
    <span class="tag">// reuse existing evidence packet</span>
  </div>
  <p class="prose dim intro-copy">
    Preferred path: generate Magnetism from an existing Brand Audit run. This reuses normalized evidence, confidence state, context readiness, and Visual Signature instead of scraping again.
  </p>
  {% if model.audit_runs %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="col-date">run</th>
        <th class="col-brand">brand</th>
        <th>url</th>
        <th class="num col-score">score</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    {% for run in model.audit_runs %}
      <tr>
        <td>#{{ run.id }}</td>
        <td><strong>{{ run.brand_name }}</strong></td>
        <td class="dim">{{ run.url }}</td>
        <td class="num num-inline">{{ run.composite_score if run.composite_score is not none else "n/a" }}</td>
        <td>
          <form action="/magnetism-scanner/from-run" method="post" style="margin:0;">
            <input type="hidden" name="run_id" value="{{ run.id }}">
            <button type="submit" style="padding: 6px 10px; font-size: 11px;">use evidence</button>
          </form>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="empty">// no Brand Audit runs available yet — run a normal audit first, or use manual scanner input.</div>
  {% endif %}
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">recent_scans</span>
    <span class="tag">// latest {{ model.scans|length }} runs</span>
  </div>
  {% if model.scans %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="col-date">date</th>
        <th class="col-brand">brand</th>
        <th class="num col-score">magnetism</th>
        <th class="num col-score">coherence</th>
        <th class="col-band-wide">positioning quadrant</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    {% for scan in model.scans %}
      <tr>
        <td>{{ scan.formatted_date }}</td>
        <td><strong>{{ scan.brand_name }}</strong></td>
        <td class="num num-inline hl-accent" style="font-weight: 600;">{{ scan.magnetism_score }}</td>
        <td class="num num-inline hl-ok" style="font-weight: 600;">{{ scan.coherence_score }}</td>
        <td class="dim">{{ scan.quadrant }}</td>
        <td><a href="/magnetism-scanner/scan/{{ scan.id }}">view sheet</a></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="empty">// no magnetism scans recorded yet — run the first scan above.</div>
  {% endif %}
</section>
{% endblock %}
