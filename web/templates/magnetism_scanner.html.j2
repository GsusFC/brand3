{% extends "base.html.j2" %}
{% block title %}Brand3 :: {{ model.t.scanner_title }}{% endblock %}
{% block content %}
<section class="home-hero">
  <h1 class="page-title">{{ model.t.recent_scans_nav }}</h1>
  <p class="prose dim intro-copy">
    {{ model.t.scanner_history_intro }}
  </p>
</section>

<section>
  <div class="section-head">
    <span class="label">{{ model.t.recent_scans }}</span>
    <span class="tag">// {{ model.t.latest_runs }} {{ model.observatory.total }} · {{ 'página' if current_lang == 'es' else 'page' }} {{ model.observatory.page }}/{{ model.observatory.total_pages }}</span>
  </div>
  <form method="get" action="/magnetism-scanner" class="form-row observatory-filter">
    {% if model.lang == 'en' %}
    <input type="hidden" name="lang" value="en">
    {% endif %}
    <input type="text" name="q" value="{{ model.observatory.query }}" placeholder="{{ 'buscar marca, dominio, categoría o tag ...' if current_lang == 'es' else 'search brand, domain, category, or tag ...' }}">
    <select name="sort">
      <option value="newest" {% if model.observatory.sort == "newest" %}selected{% endif %}>{{ 'más recientes' if current_lang == 'es' else 'newest' }}</option>
      <option value="score_desc" {% if model.observatory.sort == "score_desc" %}selected{% endif %}>{{ 'puntuación ↓' if current_lang == 'es' else 'score ↓' }}</option>
      <option value="score_asc" {% if model.observatory.sort == "score_asc" %}selected{% endif %}>{{ 'puntuación ↑' if current_lang == 'es' else 'score ↑' }}</option>
      <option value="scans_desc" {% if model.observatory.sort == "scans_desc" %}selected{% endif %}>{{ 'más scans' if current_lang == 'es' else 'most scans' }}</option>
    </select>
    <select name="category">
      <option value="">{{ 'todas las categorías' if current_lang == 'es' else 'all categories' }}</option>
      {% for key, spec in model.observatory.categories.items() %}
      <option value="{{ key }}"{% if model.observatory.category == key %} selected{% endif %}>{{ spec["label"] }}</option>
      {% endfor %}
    </select>
    <select name="tag" aria-label="Tag">
      <option value="">{{ 'todos los tags' if current_lang == 'es' else 'all tags' }}</option>
      {% for key, spec in model.observatory.tags.items() %}
      <option value="{{ key }}"{% if model.observatory.tag == key %} selected{% endif %}>{{ spec["label"] }}</option>
      {% endfor %}
    </select>
    <button type="submit">{{ 'filtrar' if current_lang == 'es' else 'filter' }}</button>
  </form>
  {% if model.scans %}
  <div class="table-wrap">
      <table class="scanner-recent-table">
        <thead>
          <tr>
            <th class="col-date">{{ model.t.date }}</th>
            <th class="col-brand">{{ model.t.brand }}</th>
            <th class="num col-score">score</th>
            <th>{{ 'modelo' if current_lang == 'es' else 'model' }}</th>
            <th class="col-band-wide">{{ model.t.quadrant }}</th>
            <th>{{ 'categoría' if current_lang == 'es' else 'category' }}</th>
            <th class="num">{{ 'scans' if current_lang == 'es' else 'scans' }}</th>
            <th class="col-action"></th>
          </tr>
        </thead>
        <tbody>
    {% for scan in model.scans %}
      <tr>
        <td class="col-date">{{ scan.compact_date }}</td>
        <td class="col-brand">
          <a href="{{ scan.brand_href }}"><strong>{{ scan.display_name }}</strong></a>
          {% if scan.domain %}<span class="dim" style="display:block; font-size:11px;">{{ scan.domain }}</span>{% endif %}
        </td>
        <td class="num num-inline col-score"><span class="score-compact">{{ scan.score_compact }}</span></td>
        <td><span class="badge-ready">{{ scan.score_model }}</span></td>
        <td class="dim col-band-wide">{{ scan.quadrant or '-' }}</td>
        <td class="dim">{{ scan.category_label or '-' }}</td>
        <td class="num"><a href="{{ scan.brand_href }}">{{ scan.scan_count }}</a></td>
        <td class="action-cell col-action">
          {% if scan.sv9_generate_scan_id %}
          <form method="post" action="/magnetism-scanner/scan/{{ scan.sv9_generate_scan_id }}/generate-sv9?lang={{ model.lang }}" style="margin:0;">
            <button type="submit" style="padding: 6px 10px; font-size: 11px;">SV9</button>
          </form>
          {% else %}
          <a href="{{ scan.primary_href }}">{{ model.t.view_sheet }}</a>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% set pager = {
    "base_path": "/magnetism-scanner",
    "page": model.observatory.page,
    "total_pages": model.observatory.total_pages,
    "has_prev": model.observatory.has_prev,
    "has_next": model.observatory.has_next,
    "query": model.observatory.query,
    "sort": model.observatory.sort,
    "category": model.observatory.category,
    "tag": model.observatory.tag
  } %}
  {% include "observatory_pager.html.j2" %}
  {% else %}
  <div class="empty">{{ model.t.no_scans }}</div>
  {% endif %}
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.from_audit }}</span>
    <span class="tag">// {{ model.t.from_audit_tag }}</span>
  </div>
  <p class="prose dim intro-copy">
    {{ model.t.from_audit_intro }}
  </p>
  {% if model.audit_runs %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="col-date">{{ model.t.run }}</th>
        <th class="col-brand">{{ model.t.brand }}</th>
        <th class="num col-score">{{ model.t.audit_score }}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
    {% for run in model.audit_runs %}
      <tr>
        <td class="col-date">#{{ run.id }}</td>
        <td class="col-brand"><strong>{{ run.display_name or run.brand_name }}</strong></td>
        <td class="num num-inline col-score">{{ run.composite_score if run.composite_score is not none else "n/a" }}</td>
        <td class="action-cell col-action">
          <form action="/magnetism-scanner/from-run" method="post" style="margin:0;">
            <input type="hidden" name="run_id" value="{{ run.id }}">
            <input type="hidden" name="lang" value="{{ model.lang }}">
            <button type="submit" style="padding: 6px 10px; font-size: 11px;">{{ model.t.use_evidence }}</button>
          </form>
          <a href="/magnetism-scanner/run/{{ run.id }}/evidence-vnext/view{{ model.lang_query }}" style="display:inline-block; margin-top: 6px; font-size: 11px;">{{ model.t.evidence_vnext_diag }}</a>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="empty">{{ model.t.no_audits }}</div>
  {% endif %}
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.t.new_scan }}</span>
    <span class="tag">// {{ landing.title }}</span>
  </div>
  <p class="prose dim intro-copy">
    {{ landing.intro }}
  </p>

  <div class="home-scanner-shell">
  <form action="/magnetism-scanner/analyze" method="post">
    <input type="hidden" name="lang" value="{{ model.lang }}">
    <div class="form-row home-scanner-form">
      <input type="url" name="url" placeholder="https://your-brand.com" spellcheck="false" autocomplete="off">
      <button type="submit">{{ landing.button }}</button>
    </div>
    <div class="scanner-result-includes" aria-label="{{ landing.result_label }}">
      <span class="scanner-result-label">{{ landing.result_label }}</span>
      <span>{{ landing.result_tldr }}</span>
      <span>{{ landing.result_audit }}</span>
      <span>{{ landing.result_evidence }}</span>
      <span>{{ landing.result_methodology }}</span>
    </div>

    <details style="margin-top: 18px; cursor: pointer; color: var(--text-muted); font-size: 12px; max-width: 820px;">
      <summary style="font-weight: 600; font-family: var(--font-ui); outline: none; user-select: none;">❯ {{ model.t.manual_summary }}</summary>
      <div style="margin-top: 10px; cursor: default;">
        <label for="manual_text" style="display: block; margin-bottom: 6px; color: var(--text-soft); font-weight: 500;">{{ model.t.manual_label }}</label>
        <textarea id="manual_text" name="manual_text" rows="8" placeholder="{{ model.t.manual_placeholder }}" style="width: 100%; background: var(--surface); color: var(--text); border: 1px solid var(--border); font-family: var(--font-mono); padding: 10px; font-size: 12px; resize: vertical; display: block; border-radius: 0; outline: none;"></textarea>
        <p class="small dim form-note" style="margin-top: 6px; color: var(--text-soft);">
          {{ model.t.manual_note }}
        </p>
      </div>
    </details>
  </form>
  </div>
</section>
{% endblock %}
