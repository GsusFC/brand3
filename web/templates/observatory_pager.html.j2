<nav class="pager small" aria-label="{{ 'Paginación' if current_lang == 'es' else 'Pagination' }}">
  {% if pager.has_prev %}
  <a href="{{ pager.base_path }}?lang={{ current_lang }}&page={{ pager.page - 1 }}{% if pager.sort %}&sort={{ pager.sort|urlencode }}{% endif %}{% if pager.query %}&q={{ pager.query|urlencode }}{% endif %}{% if pager.category %}&category={{ pager.category|urlencode }}{% endif %}{% if pager.tag %}&tag={{ pager.tag|urlencode }}{% endif %}">
    {{ '← anterior' if current_lang == 'es' else '← prev' }}
  </a>
  {% endif %}
  <span class="dim">{{ 'página' if current_lang == 'es' else 'page' }} {{ pager.page }} {{ 'de' if current_lang == 'es' else 'of' }} {{ pager.total_pages }}</span>
  {% if pager.has_next %}
  <a href="{{ pager.base_path }}?lang={{ current_lang }}&page={{ pager.page + 1 }}{% if pager.sort %}&sort={{ pager.sort|urlencode }}{% endif %}{% if pager.query %}&q={{ pager.query|urlencode }}{% endif %}{% if pager.category %}&category={{ pager.category|urlencode }}{% endif %}{% if pager.tag %}&tag={{ pager.tag|urlencode }}{% endif %}">
    {{ 'siguiente →' if current_lang == 'es' else 'next →' }}
  </a>
  {% endif %}
</nav>
