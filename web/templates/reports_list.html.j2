{% extends "base.html.j2" %}
{% block title %}brand3 :: observatorio avanzado{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">{{ 'observatorio_avanzado' if current_lang == 'es' else 'advanced_observatory' }}</span>
    <span class="tag">// {{ total }} {{ 'total' if current_lang == 'es' else 'total' }} · {{ 'página' if current_lang == 'es' else 'page' }} {{ page }}/{{ total_pages }}</span>
  </div>

  <form method="get" action="/reports" class="form-row reports-filter">
    {% if ui_lang == 'en' %}
    <input type="hidden" name="lang" value="en">
    {% endif %}
    <input type="text" name="q" value="{{ query }}" placeholder="{{ 'buscar marca, dominio o categoría ...' if current_lang == 'es' else 'search brand, domain, or category ...' }}">
    <select name="sort">
      <option value="newest" {% if sort == "newest" %}selected{% endif %}>{{ 'más recientes' if current_lang == 'es' else 'newest' }}</option>
      <option value="score_desc" {% if sort == "score_desc" %}selected{% endif %}>{{ 'puntuación ↓' if current_lang == 'es' else 'score ↓' }}</option>
      <option value="score_asc" {% if sort == "score_asc" %}selected{% endif %}>{{ 'puntuación ↑' if current_lang == 'es' else 'score ↑' }}</option>
      <option value="scans_desc" {% if sort == "scans_desc" %}selected{% endif %}>{{ 'más scans' if current_lang == 'es' else 'most scans' }}</option>
    </select>
    <select name="category">
      <option value="">{{ 'todas las categorías' if current_lang == 'es' else 'all categories' }}</option>
      {% for key, spec in categories.items() %}
      <option value="{{ key }}"{% if category == key %} selected{% endif %}>{{ spec["label"] }}</option>
      {% endfor %}
    </select>
    <button type="submit">{{ 'filtrar' if current_lang == 'es' else 'filter' }}</button>
  </form>

  {% if rows %}
  <div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="col-date">{{ 'fecha' if current_lang == 'es' else 'date' }}</th>
        <th class="col-brand">{{ 'marca' if current_lang == 'es' else 'brand' }}</th>
        <th>{{ 'dominio' if current_lang == 'es' else 'domain' }}</th>
        <th class="num col-score">score</th>
        <th>{{ 'modelo' if current_lang == 'es' else 'model' }}</th>
        <th>{{ 'cuadrante' if current_lang == 'es' else 'quadrant' }}</th>
        <th>{{ 'categoría' if current_lang == 'es' else 'category' }}</th>
        <th class="num">{{ 'scans' if current_lang == 'es' else 'scans' }}</th>
        <th class="col-action"></th>
      </tr>
    </thead>
    <tbody>
    {% for row in rows %}
      <tr>
        <td class="col-date">{{ row.compact_date }}</td>
        <td class="col-brand"><a href="{{ row.primary_href }}">{{ row.display_name }}</a></td>
        <td class="dim">{{ row.domain or '-' }}</td>
        <td class="num num-inline col-score">{{ row.score_compact }}</td>
        <td><span class="badge-ready">{{ row.score_model }}</span></td>
        <td class="dim">{{ row.quadrant or '-' }}</td>
        <td class="dim">{{ row.category_label or '-' }}</td>
        <td class="num">{{ row.scan_count }}</td>
        <td class="action-cell col-action">
          {% if row.sv9_generate_scan_id %}
          <form method="post" action="/magnetism-scanner/scan/{{ row.sv9_generate_scan_id }}/generate-sv9?lang={{ current_lang }}" style="margin:0;">
            <button type="submit" style="padding: 6px 10px; font-size: 11px;">SV9</button>
          </form>
          {% else %}
          <a href="{{ row.primary_href }}">{{ 'ver' if current_lang == 'es' else 'view' }}</a>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <div class="empty">// {% if current_lang == 'es' %}ningún análisis coincide con este filtro.{% else %}no analyses match this filter.{% endif %}</div>
  {% endif %}

  <nav class="pager small">
    {% if has_prev %}<a href="/reports?page={{ page - 1 }}&q={{ query }}&sort={{ sort }}{% if category %}&category={{ category }}{% endif %}{{ lang_query }}">{{ '← anterior' if current_lang == 'es' else '← prev' }}</a>{% endif %}
    <span class="dim">{{ 'página' if current_lang == 'es' else 'page' }} {{ page }} {{ 'de' if current_lang == 'es' else 'of' }} {{ total_pages }}</span>
    {% if has_next %}<a href="/reports?page={{ page + 1 }}&q={{ query }}&sort={{ sort }}{% if category %}&category={{ category }}{% endif %}{{ lang_query }}">{{ 'siguiente →' if current_lang == 'es' else 'next →' }}</a>{% endif %}
  </nav>
</section>
{% endblock %}
