{% extends "base.html.j2" %}
{% block title %}Brand3 Scanner API{% endblock %}
{% block content %}
<section class="magnetism-hero-section">
  <div class="section-head">
    <span class="label">brand3 scanner api</span>
    <span class="tag">// {{ 'api interna de plataforma' if current_lang == 'es' else 'internal platform api' }}</span>
  </div>
  <div class="magnetism-hero-grid">
    <div class="magnetism-hero-main">
      <h1 class="page-title magnetism-hero-title">Brand3 Scanner API</h1>
      <p class="prose intro-copy magnetism-hero-verdict">
        {% if current_lang == 'es' %}
        Ejecuta y consulta resultados completos del Brand3 Scanner desde herramientas del equipo: TLDR Brand3, auditoría asociada, evidencia, metodología y metadata de frescura.
        {% else %}
        Run and inspect complete Brand3 Scanner results from team tools: TLDR Brand3, attached audit, evidence, methodology, and freshness metadata.
        {% endif %}
      </p>
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">base</div>
      <div class="hl-accent" style="font-family:var(--font-mono); font-size:22px; line-height:1.1;">/api/v1/scanner</div>
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">mode</div>
      <div class="hl-ok" style="font-family:var(--font-mono); font-size:22px; line-height:1.1;">internal</div>
    </div>
  </div>
</section>

<hr class="rule-thin magnetism-compact-rule">

<section>
  <div class="section-head">
    <span class="label">{{ 'flujo' if current_lang == 'es' else 'flow' }}</span>
    <span class="tag">// scanner + audit</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:12px; margin-top:14px;">
    {% if current_lang == 'es' %}
    {% set steps = [
      ("1", "Crear scanner", "POST crea un trabajo desde URL o desde un Brand Audit run existente."),
      ("2", "Esperar estado", "GET status indica queued, running, ready o failed."),
      ("3", "Leer resultado", "GET result devuelve score, TLDR, metadata y links a secciones."),
      ("4", "Consultar secciones", "audit, evidence y methodology separan consumo operativo sin tocar el TLDR.")
    ] %}
    {% else %}
    {% set steps = [
      ("1", "Create scanner", "POST creates a job from a URL or an existing Brand Audit run."),
      ("2", "Wait for status", "GET status reports queued, running, ready, or failed."),
      ("3", "Read result", "GET result returns score, TLDR, metadata, and section links."),
      ("4", "Inspect sections", "audit, evidence, and methodology support team workflows without changing TLDR.")
    ] %}
    {% endif %}
    {% for number, title, description in steps %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <span class="badge badge-ready">{{ number }}</span>
      <h2 style="font-family:var(--font-ui); font-size:15px; margin:10px 0 6px;">{{ title }}</h2>
      <p style="font-family:var(--font-mono); font-size:12px; line-height:1.5;">{{ description }}</p>
    </article>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">endpoints</span>
    <span class="tag">// v1</span>
  </div>
  <div style="display:grid; gap:8px; margin-top:14px;">
    {% for method, path, description in [
      ("POST", "/api/v1/scanner", "create scanner from url or audit_run_id"),
      ("GET", "/api/v1/scanner/{id}", "status and links"),
      ("GET", "/api/v1/scanner/{id}/result", "scores, TLDR, metadata, section URLs"),
      ("GET", "/api/v1/scanner/{id}/audit", "attached Brand Audit snapshot"),
      ("GET", "/api/v1/scanner/{id}/evidence", "Research Pack, source map, context, shadow sources"),
      ("GET", "/api/v1/scanner/{id}/methodology", "pipeline, limits, freshness metadata")
    ] %}
    <article style="border:1px solid var(--border); background:var(--surface); padding:10px 12px; display:grid; grid-template-columns:80px minmax(0, 1fr); gap:10px; align-items:start;">
      <span class="badge {% if method == 'POST' %}badge-ready{% endif %}">{{ method }}</span>
      <div>
        <code style="font-family:var(--font-mono); font-size:13px;">{{ path }}</code>
        <p class="dim" style="font-family:var(--font-mono); font-size:11px; line-height:1.4; margin:5px 0 0;">{{ description }}</p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ 'ejemplos' if current_lang == 'es' else 'examples' }}</span>
    <span class="tag">// json</span>
  </div>
  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap:12px; margin-top:14px;">
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">{{ 'Desde URL' if current_lang == 'es' else 'From URL' }}</strong>
      <pre style="white-space:pre-wrap; overflow-wrap:anywhere; font-family:var(--font-mono); font-size:12px; line-height:1.45; margin:10px 0 0;">POST /api/v1/scanner
{
  "url": "https://example.com",
  "lang": "es",
  "mode": "advanced",
  "include_audit": true
}</pre>
    </article>
    <article style="border:1px solid var(--border); background:var(--surface); padding:14px;">
      <strong style="font-family:var(--font-ui); font-size:13px;">{{ 'Desde auditoría existente' if current_lang == 'es' else 'From existing audit' }}</strong>
      <pre style="white-space:pre-wrap; overflow-wrap:anywhere; font-family:var(--font-mono); font-size:12px; line-height:1.45; margin:10px 0 0;">POST /api/v1/scanner
{
  "audit_run_id": 165,
  "lang": "es",
  "include_audit": true
}</pre>
    </article>
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ 'límites' if current_lang == 'es' else 'limits' }}</span>
    <span class="tag">// tldr guardrails</span>
  </div>
  <div style="border:1px solid var(--border); background:var(--surface); padding:14px;">
    {% if current_lang == 'es' %}
    <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5; margin:0;">
      La API expone <code>shadow_sources</code> y metadata de frescura, pero no los usa para scoring ni TLDR. Los resultados históricos se leen tal como fueron persistidos; no se regeneran al consultarlos.
    </p>
    {% else %}
    <p class="dim" style="font-family:var(--font-mono); font-size:12px; line-height:1.5; margin:0;">
      The API exposes <code>shadow_sources</code> and freshness metadata, but does not use them for scoring or TLDR. Historic results are read as persisted; reads do not regenerate scans.
    </p>
    {% endif %}
  </div>
</section>
{% endblock %}
