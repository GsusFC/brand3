{% extends "base.html.j2" %}
{% block title %}brand3 :: analyzing {{ brand_slug }}{% endblock %}
{% block extra_head %}
  <script src="/static/status_waiting.js?v={{ static_asset_version }}" defer></script>
{% endblock %}
{% block content %}
<section data-status-waiting data-status="{{ status }}" data-phase="{{ phase if phase else '' }}" data-elapsed="{{ elapsed_seconds if elapsed_seconds else 0 }}" data-ready-href="{{ ready_href if ready_href else '' }}" data-poll-interval="5000">
  <div class="section-head">
    <span class="label">{{ status_label if status_label else "analysis_status" }}</span>
    <span class="tag">// token={{ token }}</span>
  </div>

  {# Everything inside this wrapper is re-rendered by the live poller; the
     waiting game below stays out so its state survives updates. #}
  <div data-status-dynamic>
  <pre class="term-head">
{%- if status == "queued" -%}
<span class="hl-warn">[queued]</span>   <span class="dim">{{ brand_slug }} — {{ queued_message if queued_message else "waiting for worker" }}</span>
{%- elif status == "running" -%}
<span class="hl-accent">[running]</span>  <span class="dim">{{ brand_slug }} — {{ phase_label }}</span>
{%- elif status == "ready" -%}
<span class="hl-ok">[ready]</span>    <span class="dim">{{ brand_slug }} — {{ ready_message if ready_message else "redirecting to report ..." }}</span>
{%- elif status == "failed" -%}
<span class="hl-alert">[failed]</span>   <span class="dim">{{ brand_slug }} — {{ failed_headline if failed_headline else (error_message or "unknown error") }}</span>
{%- endif -%}
  </pre>

  {% if status in ("queued", "running") %}
  {# RGB progress: the bar reveals the B3S mark colors in order — red, blue,
     green — as the scan advances. Driven by --scan-progress from JS. #}
  <div class="status-progress" data-progress-bar role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-label="{{ 'Progreso del escaneo' if ui_lang == 'es' else 'Scan progress' }}" style="--scan-progress: 2%"></div>

  <div class="status-grid">
    <div class="status-metric">
      <span class="k">phase</span>
      <span class="v">{{ phase_label }}</span>
    </div>
    <div class="status-metric">
      <span class="k">elapsed</span>
      <span class="v tabular-nums" data-elapsed-label>{{ elapsed_label }}</span>
    </div>
    <div class="status-metric">
      <span class="k">typical run</span>
      <span class="v">{{ typical_run_label if typical_run_label else "3–5 min" }}</span>
    </div>
  </div>

  <ol class="status-steps">
    {% for step in phase_steps %}
    <li class="status-step is-{{ step.state }}">
      <span class="status-step-mark">
        {%- if step.state == "done" -%}[done]
        {%- elif step.state == "active" -%}[active]
        {%- elif step.state == "failed" -%}[failed]
        {%- else -%}[pending]
        {%- endif -%}
      </span>
      <span>{{ step.label }}</span>
    </li>
    {% endfor %}
  </ol>

  <p class="small dim">{{ status_note if status_note else "A full scan takes 3-5 minutes. Keep this tab open — you'll land on the result automatically." }}</p>
  {% elif status == "ready" %}
  <p><a href="{{ ready_href if ready_href else '/r/' ~ token }}">{{ ready_link_label if ready_link_label else "→ open report" }}</a></p>
  {% elif status == "failed" %}
  {% if failure_diagnostics %}
  <div class="status-grid" style="margin-top: 12px;">
    <div class="status-metric">
      <span class="k">component</span>
      <span class="v">{{ failure_diagnostics.component }}</span>
    </div>
    <div class="status-metric">
      <span class="k">failure_type</span>
      <span class="v">{{ failure_diagnostics.failure_type }}</span>
    </div>
    <div class="status-metric">
      <span class="k">retryable</span>
      <span class="v">{{ "yes" if failure_diagnostics.retryable else "no" }}</span>
    </div>
  </div>
  <p class="small dim">{{ failure_diagnostics.safe_message }}</p>
  {% endif %}
  {% if retry_url %}
  <form method="post" action="/magnetism-scanner/analyze" style="margin: 14px 0 4px;">
    <input type="hidden" name="url" value="{{ retry_url }}">
    <input type="hidden" name="lang" value="{{ ui_lang if ui_lang else 'es' }}">
    <button class="source-link" type="submit">⟳ {{ 'Reintentar escaneo' if ui_lang == 'es' else 'Retry scan' }}</button>
  </form>
  {% endif %}
  <p><a href="{{ back_href if back_href else '/' }}">{{ back_link_label if back_link_label else "← back to form" }}</a></p>
  {% endif %}
  </div>

  {% if status in ("queued", "running") %}
  <section class="status-game" aria-label="{{ 'Mini juego de espera' if ui_lang == 'es' else 'Waiting mini game' }}">
    <div class="status-game-head">
      <div>
        <div class="status-game-label">{{ 'T-Rex de espera' if ui_lang == 'es' else 'Waiting T-Rex' }}</div>
        <div class="status-game-copy small">{{ 'Espacio / ↑ / toque: saltar. Doble salto disponible. P: pausar.' if ui_lang == 'es' else 'Space / ↑ / tap: jump. Double jump available. P: pause.' }}</div>
      </div>
      <div class="status-game-scoreboard" aria-live="polite">
        <div>
          <span class="k">{{ 'Score' if ui_lang == 'en' else 'Puntos' }}</span>
          <span class="v tabular-nums" data-dino-score>0</span>
        </div>
        <div>
          <span class="k">{{ 'Best' if ui_lang == 'en' else 'Récord' }}</span>
          <span class="v tabular-nums" data-dino-best>0</span>
        </div>
        <div>
          <span class="k">{{ 'Speed' if ui_lang == 'en' else 'Ritmo' }}</span>
          <span class="v tabular-nums" data-dino-speed>x1.0</span>
        </div>
      </div>
    </div>
    <div class="status-game-board">
      <canvas class="status-game-canvas" width="640" height="180" data-dino-canvas data-game-lang="{{ ui_lang }}"></canvas>
    </div>
    <div class="status-game-footer">
      <button class="source-link status-game-button" type="button" data-dino-start aria-pressed="false">{{ 'Empezar' if ui_lang == 'es' else 'Start' }}</button>
      <span class="small dim" data-dino-level>{{ 'Nivel 1' if ui_lang == 'es' else 'Level 1' }}</span>
      <span class="small dim" data-dino-state>{{ 'Listo para jugar' if ui_lang == 'es' else 'Ready to play' }}</span>
    </div>
  </section>
  {% endif %}
</section>
{% endblock %}
