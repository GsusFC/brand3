{% extends "base.html.j2" %}
{% block title %}brand3 :: calibración #{{ scan.id }}{% endblock %}
{% block extra_head %}
<style>
  /* Internal calibration tool: scoped styles, public CSS untouched. */
  .sv9-cal-card {
    margin: 22px 0;
    padding: 18px 20px 20px;
    border: 1px solid var(--border);
    background: var(--soft-panel-bg);
  }
  .sv9-cal-detected { margin: 10px 0 4px; line-height: 1.55; }
  .sv9-cal-tile {
    margin: 14px 0;
    padding: 12px 0;
    border-top: 1px dashed var(--border);
  }
  .sv9-cal-tile-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
  }
  .sv9-cal-tile-head .tid {
    font-family: var(--font-mono);
    font-weight: 700;
  }
  .sv9-cal-tile-evidence {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
  }
  .sv9-estado-ia { font-family: var(--font-mono); font-size: 11px; }
  .sv9-estado-ia.ok { color: var(--accent); }
  .sv9-estado-ia.no { color: var(--danger); }
  .sv9-estado-ia.sin_evidencia { color: var(--text-muted, inherit); }
  /* Three-way state picker: radios styled as segments. */
  .sv9-estado-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 8px 0 0;
  }
  .sv9-estado-picker input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .sv9-estado-picker .seg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0 14px;
    border: 1px solid var(--border-strong);
    background: var(--surface, transparent);
    font-family: var(--font-mono);
    font-size: 12px;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }
  .sv9-estado-picker input:checked + .seg {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 700;
  }
  .sv9-estado-picker input:focus-visible + .seg {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sv9-cal-motivo {
    width: 100%;
    min-height: 38px;
    margin: 8px 0 0;
    padding: 8px 12px;
    border: 1px solid var(--border-strong);
    background: var(--surface, transparent);
    color: var(--text, inherit);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .sv9-cal-form-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: stretch;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border-strong);
  }
  .sv9-cal-form-footer .grow { flex: 1 1 220px; }
  .sv9-cal-form-footer input[type="text"] {
    width: 100%;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--border-strong);
    background: var(--surface, transparent);
    color: var(--text, inherit);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .sv9-cal-submit {
    min-height: 44px;
    padding: 10px 28px;
    border: 1px solid var(--text);
    background: var(--text);
    color: var(--button-text, var(--bg));
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
  }
  @media (max-width: 760px) {
    .sv9-cal-card { margin: 16px 0; padding: 14px; }
    .sv9-estado-picker { display: grid; grid-template-columns: 1fr 1fr 1fr; }
    .sv9-estado-picker .seg { padding: 0 6px; }
    .sv9-cal-form-footer { display: grid; grid-template-columns: 1fr; }
    .sv9-cal-submit { width: 100%; }
  }
</style>
{% endblock %}
{% block content %}
<section>
  <div class="lab-review-nav" style="margin-bottom: 14px;">
    <a class="source-link" href="/sv9/calibration">← Scans</a>
    <a class="source-link" href="/sv9/scan/{{ scan.id }}">Canvas</a>
    <a class="source-link" href="/sv9/scan/{{ scan.id }}/export.md">Export .md</a>
    <span class="badge badge-missing">interno</span>
  </div>

  <div class="section-head">
    <span class="label">calibración por baldosa</span>
    <span class="tag">// scan #{{ scan.id }} · {{ scan.model or scan.rubric_version }} · {{ scan.evaluator_model or '—' }}</span>
  </div>

  <p class="prose">
    <strong>{{ scan.brand_name }}</strong> ({{ scan.url }}) ·
    Brand3 Score <strong>{{ scan.brand3_score }}/100</strong>
    {% if scan.magnetism_capped %}· <span class="tag">magnetism cap</span>{% endif %}
    {% if scan.needs_review %}· <span class="tag">coherencia en revisión</span>{% endif %}
  </p>

  {% if is_legacy %}
  <p class="prose dim">
    Modelo anterior ({{ scan.rubric_version }}): no es convertible a baldosas v3.1.
    Re-escanéalo para calibrar por baldosa.
  </p>
  {% endif %}

  {% for c in components %}
  <div id="{{ c.key }}" class="sv9-cal-card">
    <div class="section-head">
      <span class="label">{{ c.label }}</span>
      <span class="tag">
        // ia: {{ c.result.score }}/{{ c.scale }}{% if c.multiplier == 2 %} ×2{% endif %}
        · {{ c.result.status }}{% if c.result.confidence %} · confianza {{ c.result.confidence }}{% endif %}
      </span>
    </div>

    {% if c.result.detected_content %}
    <p class="prose sv9-cal-detected"><span class="dim">detectado:</span> {{ c.result.detected_content }}</p>
    {% else %}
    <p class="prose dim sv9-cal-detected">(no detectado)</p>
    {% endif %}
    {% if c.result.veredicto %}
    <p class="prose sv9-cal-detected"><span class="dim">veredicto:</span> <em>{{ c.result.veredicto }}</em></p>
    {% endif %}
    {% if c.result.error %}
    <p class="prose dim">error técnico: {{ c.result.error }}</p>
    {% endif %}

    {% if c.tiles and not is_legacy %}
    <form method="post" action="/sv9/calibration/{{ scan.id }}/{{ c.key }}">
      {% for tile in c.tiles %}
      <div class="sv9-cal-tile">
        <div class="sv9-cal-tile-head">
          <span class="tid">{{ tile.id }}</span>
          <span>{{ tile.name }}</span>
          <span class="sv9-estado-ia {{ tile.estado_ia }}">· ia: {{ tile.estado_ia or '—' }}</span>
        </div>
        <p class="dim" style="margin: 4px 0 0; font-family: var(--font-mono); font-size: 12px; line-height: 1.5;">{{ tile.condition }}</p>
        {% if tile.note %}
        <p class="dim" style="margin: 4px 0 0; font-family: var(--font-mono); font-size: 11px;">nota: {{ tile.note }}</p>
        {% endif %}
        {% if tile.estado_ia == 'ok' and tile.evidencia %}
        <p class="sv9-cal-tile-evidence dim">evidencia: {{ tile.evidencia }}</p>
        {% elif tile.motivo %}
        <p class="sv9-cal-tile-evidence dim">motivo ia: {{ tile.motivo }}{% if tile.contexto_requerido %} · contexto: {{ tile.contexto_requerido }}{% endif %}</p>
        {% endif %}
        <div class="sv9-estado-picker" role="radiogroup" aria-label="estado humano {{ tile.id }}">
          {% for estado in estados %}
          <label>
            <input type="radio" name="estado__{{ tile.id }}" value="{{ estado }}"{% if tile.estado_ia == estado %} checked{% endif %}>
            <span class="seg">{{ estado }}</span>
          </label>
          {% endfor %}
        </div>
        <input type="text" class="sv9-cal-motivo" name="motivo__{{ tile.id }}"
               placeholder="motivo (solo si corriges la IA)" autocomplete="off">
      </div>
      {% endfor %}

      <div class="sv9-cal-form-footer">
        <div class="grow">
          <input type="text" name="evaluador" value="{{ evaluador }}" placeholder="evaluador" required aria-label="evaluador">
        </div>
        <button type="submit" class="sv9-cal-submit">guardar {{ c.label }}</button>
      </div>
    </form>
    {% endif %}

    {% if c.labels %}
    <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:12px;">
      {% for label in c.labels %}
      <span class="tag">{{ label.evaluador }} · {{ label.baldosa_id }}: {{ label.estado_humano }}{% if label.estado_ia != label.estado_humano %} (ia {{ label.estado_ia }}){% endif %}</span>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endblock %}
