{% extends "base.html.j2" %}
{% block title %}brand3 :: sv9 calibración #{{ scan.id }}{% endblock %}
{% block extra_head %}
<style>
  /* Internal calibration tool: scoped styles, public CSS untouched. */
  .sv9-cal-card {
    margin: 22px 0;
    padding: 18px 20px 20px;
    border: 1px solid var(--border);
    background: var(--soft-panel-bg);
  }
  .sv9-cal-detected {
    margin: 10px 0 4px;
    line-height: 1.55;
  }
  .sv9-cal-ladder summary {
    cursor: pointer;
    padding: 8px 0;
    user-select: none;
  }
  .sv9-cal-ladder li {
    margin: 10px 0;
    line-height: 1.5;
  }
  .sv9-cal-ladder .rung-evidence {
    margin-left: 1.8em;
    line-height: 1.45;
  }
  .sv9-cal-labels {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 0;
  }
  .sv9-cal-form {
    display: grid;
    gap: 14px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px dashed var(--border-strong);
  }
  .sv9-cal-form .field-label {
    display: block;
    margin-bottom: 6px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted, inherit);
  }
  /* Score picker: one click = one score. Radios styled as segments. */
  .sv9-score-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sv9-score-picker input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .sv9-score-picker .seg {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 46px;
    min-height: 44px;
    padding: 0 10px;
    border: 1px solid var(--border-strong);
    background: var(--surface, transparent);
    font-family: var(--font-mono);
    font-size: 15px;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease,
      color 160ms ease, transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .sv9-score-picker .seg:hover {
      border-color: var(--accent);
    }
  }
  .sv9-score-picker .seg:active {
    transform: scale(0.95);
  }
  .sv9-score-picker input:checked + .seg {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 700;
  }
  .sv9-score-picker input:focus-visible + .seg {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sv9-cal-form input[type="text"] {
    width: 100%;
    min-height: 44px;
    padding: 10px 14px;
    border: 1px solid var(--border-strong);
    background: var(--surface, transparent);
    color: var(--text, inherit);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .sv9-cal-form input[type="text"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(239, 73, 13, 0.12);
  }
  .sv9-cal-flag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--border-strong);
    cursor: pointer;
    user-select: none;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .sv9-cal-flag input {
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .sv9-cal-flag:has(input:checked) {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .sv9-cal-form-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: stretch;
  }
  .sv9-cal-form-footer .grow {
    flex: 1 1 220px;
  }
  .sv9-cal-submit {
    min-height: 44px;
    padding: 10px 28px;
    border: 1px solid var(--text);
    background: var(--text);
    color: var(--button-text, var(--bg));
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease,
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .sv9-cal-submit:hover {
      background: var(--accent);
      border-color: var(--accent);
    }
  }
  .sv9-cal-submit:active {
    transform: scale(0.97);
  }
</style>
{% endblock %}
{% block content %}
<section>
  <div class="lab-review-nav" style="margin-bottom: 14px;">
    <a class="source-link" href="/sv9/calibration">← Scans SV9</a>
    <a class="source-link" href="/sv9/scan/{{ scan.id }}">Canvas</a>
    <span class="badge badge-missing">interno</span>
  </div>

  <div class="section-head">
    <span class="label">sv9_calibracion</span>
    <span class="tag">// scan #{{ scan.id }} · {{ scan.rubric_version }} · {{ scan.evaluator_model or '—' }}</span>
  </div>

  <p class="prose">
    <strong>{{ scan.brand_name }}</strong> ({{ scan.url }}) ·
    Brand3 Score <strong>{{ scan.brand3_score }}/100</strong>
    {% if scan.magnetism_capped %}· <span class="tag">magnetism cap</span>{% endif %}
    {% if scan.needs_review %}· <span class="tag">coherencia en revisión</span>{% endif %}
  </p>

  {% for c in components %}
  <div id="{{ c.key }}" class="sv9-cal-card">
    <div class="section-head">
      <span class="label">{{ c.label }}</span>
      <span class="tag">
        // ia: {{ c.result.score }}/{{ c.scale }}{% if c.multiplier == 2 %} ×2{% endif %}
        · {{ c.result.status }}
      </span>
    </div>

    {% if c.result.detected_content %}
    <p class="prose sv9-cal-detected"><span class="dim">detectado:</span> {{ c.result.detected_content }}</p>
    {% else %}
    <p class="prose dim sv9-cal-detected">(no detectado)</p>
    {% endif %}
    {% if c.result.error %}
    <p class="prose dim">error técnico: {{ c.result.error }}</p>
    {% endif %}

    {% if c.ladder and c.result.rung_profile %}
    <details class="sv9-cal-ladder">
      <summary class="dim">escalera y veredictos</summary>
      <ul style="list-style:none; padding-left:0;">
        {% for rung in c.ladder %}
        <li>
          {% if rung.verdict and rung.verdict.passed %}
          <span style="color:var(--accent);">✓</span>
          {% elif rung.verdict and not rung.verdict.get('evaluable', true) %}
          <span class="dim" title="sin canal de evidencia">⊘</span>
          {% else %}
          <span class="dim">✗</span>
          {% endif %}
          <strong>{{ rung.rung }}</strong> · {{ rung.criterion }}
          {% if rung.verdict and not rung.verdict.passed and not rung.verdict.get('evaluable', true) %}
          <span class="badge">no evaluable</span>
          {% endif %}
          {% if rung.verdict and rung.verdict.evidence %}
          <div class="dim rung-evidence">evidencia: {{ rung.verdict.evidence }}</div>
          {% endif %}
          {% if rung.verdict and rung.verdict.reasoning %}
          <div class="dim rung-evidence">{{ rung.verdict.reasoning }}</div>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </details>
    {% endif %}

    {% if c.labels %}
    <div class="sv9-cal-labels">
      {% for label in c.labels %}
      <span class="tag">{{ label.evaluador }}: {{ label.score_humano }}/{{ c.scale }} (Δ{{ label.delta }}){% if label.flag_evidencia %} ⚑ evidencia errónea{% endif %}</span>
      {% endfor %}
    </div>
    {% endif %}

    <form method="post" action="/sv9/calibration/{{ scan.id }}/{{ c.key }}" class="sv9-cal-form">
      <div>
        <span class="field-label">score humano</span>
        <div class="sv9-score-picker">
          {% for n in range(0, c.scale + 1) %}
          <label>
            <input type="radio" name="score_humano" value="{{ n }}" required>
            <span class="seg">{{ n }}</span>
          </label>
          {% endfor %}
        </div>
      </div>

      <div>
        <span class="field-label">motivo</span>
        <input type="text" name="motivo" placeholder="una línea — por qué este score y no el de la IA" autocomplete="off">
      </div>

      <div class="sv9-cal-form-footer">
        <label class="sv9-cal-flag">
          <input type="checkbox" name="flag_evidencia" value="true">
          evidencia errónea
        </label>
        <div class="grow">
          <input type="text" name="evaluador" value="{{ evaluador }}" placeholder="evaluador" required
                 style="min-height:44px;" aria-label="evaluador">
        </div>
        <button type="submit" class="sv9-cal-submit">guardar</button>
      </div>
    </form>
  </div>
  {% endfor %}
</section>
{% endblock %}
