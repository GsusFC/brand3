{% extends "base.html.j2" %}
{% block title %}brand3 :: sv9 {{ 'calibración' if current_lang == 'es' else 'calibration' }}{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">sv9_{{ 'calibracion' if current_lang == 'es' else 'calibration' }}</span>
    <span class="tag">// {{ 'interno' if current_lang == 'es' else 'internal' }} · {{ rubric_version }}</span>
  </div>

  <p class="prose dim">
    {% if current_lang == 'es' %}
    Scans en sombra del motor SV9. Puntúa cada componente con la escalera delante;
    el delta humano-IA alimenta los few-shots y decide cuándo se apaga el V5.
    {% else %}
    Shadow scans from the SV9 engine. Score each component with the ladder in front of you;
    the human-AI delta feeds few-shots and helps decide when V5 is retired.
    {% endif %}
  </p>

  {% if not scans %}
  <p class="prose">{{ 'No hay scans SV9 todavía. Lanza' if current_lang == 'es' else 'No SV9 scans yet. Run' }} <code>scripts/sv9_shadow_replay.py</code> {{ 'primero.' if current_lang == 'es' else 'first.' }}</p>
  {% else %}
  <div class="table-wrap sv9-calibration-table-wrap">
  <table style="width:100%; border-collapse:collapse; font-size:0.95em;">
    <thead>
      <tr style="text-align:left; opacity:0.7;">
        <th style="padding:10px 12px;">scan</th>
        <th style="padding:10px 12px;">{{ 'marca' if current_lang == 'es' else 'brand' }}</th>
        <th style="padding:10px 12px;">brand3_score</th>
        <th style="padding:10px 12px;">{{ 'modelo' if current_lang == 'es' else 'model' }}</th>
        <th style="padding:10px 12px;">flags</th>
        <th style="padding:10px 12px;">{{ 'etiquetas' if current_lang == 'es' else 'labels' }}</th>
        <th style="padding:10px 12px;">{{ 'fecha' if current_lang == 'es' else 'date' }}</th>
      </tr>
    </thead>
    <tbody>
      {% for scan in scans %}
      <tr style="border-top:1px solid rgba(128,128,128,0.25);">
        <td style="padding:10px 12px;"><a href="/sv9/calibration/{{ scan.id }}{{ lang_suffix }}">#{{ scan.id }}</a></td>
        <td style="padding:10px 12px;"><a href="/sv9/scan/{{ scan.id }}{{ lang_suffix }}">{{ scan.brand_name }}</a></td>
        <td style="padding:10px 12px;">{{ scan.brand3_score }}/100</td>
        <td style="padding:10px 12px;" class="dim">{{ scan.evaluator_model or '—' }}</td>
        <td style="padding:10px 12px;">
          {% if scan.magnetism_capped %}<span class="tag">cap</span>{% endif %}
          {% if scan.needs_review %}<span class="tag">{{ 'revisión' if current_lang == 'es' else 'review' }}</span>{% endif %}
          {% if not scan.is_complete %}<span class="tag">{{ 'parcial' if current_lang == 'es' else 'partial' }}</span>{% endif %}
        </td>
        <td style="padding:10px 12px;">{{ labels_by_scan.get(scan.id, 0) }}</td>
        <td style="padding:10px 12px;" class="dim">{{ scan.created_at[:16] }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% endif %}
</section>
{% endblock %}
