{% extends "base.html.j2" %}
{% block title %}brand3 :: sv9 calibración{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">sv9_calibracion</span>
    <span class="tag">// interno · {{ rubric_version }}</span>
  </div>

  <p class="prose dim">
    Scans en sombra del motor SV9. Puntúa cada componente con la escalera delante;
    el delta humano-IA alimenta los few-shots y decide cuándo se apaga el V5.
  </p>

  {% if not scans %}
  <p class="prose">No hay scans SV9 todavía. Lanza <code>scripts/sv9_shadow_replay.py</code> primero.</p>
  {% else %}
  <table style="width:100%; border-collapse:collapse; font-size:0.92em;">
    <thead>
      <tr style="text-align:left; opacity:0.7;">
        <th style="padding:4px 8px;">scan</th>
        <th style="padding:4px 8px;">marca</th>
        <th style="padding:4px 8px;">brand3_score</th>
        <th style="padding:4px 8px;">modelo</th>
        <th style="padding:4px 8px;">flags</th>
        <th style="padding:4px 8px;">etiquetas</th>
        <th style="padding:4px 8px;">fecha</th>
      </tr>
    </thead>
    <tbody>
      {% for scan in scans %}
      <tr style="border-top:1px solid rgba(128,128,128,0.25);">
        <td style="padding:4px 8px;"><a href="/sv9/calibration/{{ scan.id }}">#{{ scan.id }}</a></td>
        <td style="padding:4px 8px;">{{ scan.brand_name }}</td>
        <td style="padding:4px 8px;">{{ scan.brand3_score }}/100</td>
        <td style="padding:4px 8px;" class="dim">{{ scan.evaluator_model or '—' }}</td>
        <td style="padding:4px 8px;">
          {% if scan.magnetism_capped %}<span class="tag">cap</span>{% endif %}
          {% if scan.needs_review %}<span class="tag">revisión</span>{% endif %}
          {% if not scan.is_complete %}<span class="tag">parcial</span>{% endif %}
        </td>
        <td style="padding:4px 8px;">{{ labels_by_scan.get(scan.id, 0) }}</td>
        <td style="padding:4px 8px;" class="dim">{{ scan.created_at[:16] }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>
{% endblock %}
