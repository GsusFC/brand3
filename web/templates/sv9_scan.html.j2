{% extends "base.html.j2" %}
{% block title %}brand3 :: baldosas :: {{ scan.display_name or scan.brand_name }}{% endblock %}
{% block extra_head %}
<style>
  /* Tile grid: three visual states. Scoped styles, public CSS untouched. */
  .sv9-tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
  }
  .sv9-tile {
    position: relative;
    min-width: 34px;
    min-height: 34px;
    padding: 4px 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    cursor: default;
  }
  /* Encendida: lit, the brand earned the tile. */
  .sv9-tile.is-on {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  /* Apagada: off — a brand failure. Painted red. */
  .sv9-tile.is-off {
    background: color-mix(in srgb, var(--danger) 16%, transparent);
    border-color: var(--danger);
    color: var(--danger);
  }
  /* Punto ciego: blind spot — a limit of the snapshot. Muted, never red. */
  .sv9-tile.is-blind {
    background: transparent;
    border-style: dashed;
    border-color: var(--border-strong);
    color: var(--text-muted, inherit);
    opacity: 0.65;
  }
  .sv9-tile-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .sv9-tile-legend .swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-right: 5px;
    vertical-align: -1px;
    border: 1px solid var(--border-strong);
  }
  .sv9-tile-legend .swatch.on { background: var(--accent); border-color: var(--accent); }
  .sv9-tile-legend .swatch.off { background: color-mix(in srgb, var(--danger) 16%, transparent); border-color: var(--danger); }
  .sv9-tile-legend .swatch.blind { background: transparent; border-style: dashed; }
  .sv9-tile-detail {
    margin: 10px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
  }
  .sv9-tile-detail .blind-cta {
    color: var(--accent);
  }
  .sv9-confidence-badge.media { color: var(--warn, #b8860b); }
  .sv9-confidence-badge.baja { color: var(--danger); }
</style>
{% endblock %}
{% block content %}
{% macro tile_box(box, full_width=false) %}
<div class="sv9-canvas-card{% if full_width %} sv9-canvas-coherence{% endif %}{% if box.status != 'scored' %} sv9-canvas-card-muted{% endif %}" id="sv9-card-{{ box.key }}">
  <div class="magnetism-card-head sv9-canvas-card-head">
    <span class="hl-accent magnetism-card-title sv9-canvas-card-title">{{ box.label }}</span>
    <span class="sv9-canvas-actions">
      <span class="badge">{{ box.score }}/{{ box.scale }}{% if box.multiplier == 2 %} ×2{% endif %}</span>
      {{ eye_button(box) }}
    </span>
  </div>
  {% if box.veredicto %}
  <p class="prose{% if full_width %} sv9-coherence-verdict{% endif %}" style="margin: 4px 0 0; font-style: italic; line-height: 1.5;">{{ box.veredicto }}</p>
  {% if box.content or box.message %}
  <hr style="border: 0; border-top: 1px dashed var(--border); margin: 10px 0;">
  {% endif %}
  {% endif %}
  {% if box.content %}
  <p class="magnetism-card-result" style="margin: 0;">{{ box.content }}</p>
  {% elif box.status == 'not_detected' %}
  <p class="dim magnetism-card-result" style="margin: 0;">(no detectado)</p>
  {% elif box.status == 'not_evaluated' %}
  <p class="dim magnetism-card-result" style="margin: 0;">(fallo técnico)</p>
  {% endif %}

  {% if box.message %}
  <p class="dim" style="margin: 6px 0 0; font-family: var(--font-mono); font-size: 12px; line-height: 1.55;">{{ box.message }}</p>
  {% endif %}
</div>
{% endmacro %}

{% macro eye_button(box) -%}
<button class="source-link sv9-editorial-open" type="button" data-sv9-dialog-open="sv9-editorial-{{ box.key }}" aria-label="Abrir lectura editorial de {{ box.label }}" title="Abrir lectura editorial">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
    <circle cx="12" cy="12" r="2.75"></circle>
  </svg>
</button>
{%- endmacro %}

{% macro editorial_drawer(box, is_coherence=False) -%}
<dialog class="sv9-editorial-drawer" id="sv9-editorial-{{ box.key }}" aria-labelledby="sv9-editorial-title-{{ box.key }}">
  <div class="sv9-editorial-drawer-inner">
    <div class="sv9-editorial-drawer-head">
      <div>
        <div class="dim sv9-editorial-kicker">componente</div>
        <h2 id="sv9-editorial-title-{{ box.key }}" class="sv9-editorial-title">{{ box.label }}</h2>
      </div>
      <form method="dialog">
        <button class="source-link" type="submit" aria-label="Cerrar drawer editorial">Cerrar</button>
      </form>
    </div>

    <div class="sv9-editorial-stack">
      <section class="sv9-editorial-section">
        <h3>Resumen</h3>
        <div class="sv9-editorial-scoreline">
          <span class="badge">{{ box.score }}/{{ box.scale }}{% if box.multiplier == 2 or is_coherence %} ×2{% endif %}</span>
          <span class="dim">{{ box.status_label }}</span>
        </div>
        <p>{{ box.content or ("Coherencia se evalúa a partir del conjunto del canvas." if is_coherence else "(no detectado)") }}</p>
      </section>

      {% if box.tiles %}
      <section class="sv9-editorial-section">
        <h3>Baldosas</h3>
        <p class="dim sv9-editorial-meta">
          {{ box.lit_tile_count }} encendida{% if box.lit_tile_count != 1 %}s{% endif %}; se muestran solo fallos y puntos ciegos.
        </p>
        {% if box.action_tiles %}
        <div class="sv9-tiles">
          {% for tile in box.action_tiles %}
          <article class="sv9-tile-card{% if tile.is_off %} is-off{% elif tile.is_blind %} is-blind{% elif tile.is_missing %} is-missing{% endif %}">
            <span class="sv9-tile">{{ tile.id }}</span>
            <div>
              <strong>{{ tile.name }}{% if tile.is_missing %} · sin veredicto{% endif %}</strong>
              <p>{{ tile.motivo or tile.condition }}</p>
              {% if tile.is_blind and tile.contexto_requerido %}
              <p class="dim">Contexto requerido: {{ tile.contexto_requerido }}</p>
              {% endif %}
            </div>
          </article>
          {% endfor %}
        </div>
        {% else %}
        <p class="dim">No hay fallos ni puntos ciegos en este componente.</p>
        {% endif %}
      </section>
      {% endif %}

      <section class="sv9-editorial-section">
        <h3>V9</h3>
        {% if box.message %}
        <p>{{ box.message }}</p>
        {% else %}
        <p class="dim">No hay editorial V9 generada para {{ "coherencia" if is_coherence else "este componente" }}.</p>
        {% endif %}
      </section>

      <section class="sv9-editorial-section">
        <h3>V2</h3>
        {% if is_coherence %}
        <p class="dim">V2 no tiene bloque equivalente de coherencia. Este cierre pertenece a SV9.</p>
        {% elif box.v2_reference.text %}
        <p>{{ box.v2_reference.text }}</p>
        <p class="dim sv9-editorial-meta">
          source={{ box.v2_reference.source }}{% if box.v2_reference.confidence %} · confidence={{ box.v2_reference.confidence }}{% endif %}{% if box.v2_reference.mode %} · mode={{ box.v2_reference.mode }}{% endif %}
        </p>
        {% else %}
        <p class="dim">No hay editorial V2 persistida para este componente. SV9 no ejecuta TLDR v2 al abrir esta vista.</p>
        {% endif %}
      </section>

      <section class="sv9-editorial-section">
        <h3>Decisión</h3>
        <form method="post" action="/sv9/scan/{{ scan.id }}/editorial-decision/{{ box.key }}">
          <label class="sv9-editorial-field">
            <span>Decisión</span>
            <select name="decision" required>
              <option value="v9"{% if box.editorial_decision.decision == 'v9' %} selected{% endif %}>V9</option>
              <option value="v2"{% if box.editorial_decision.decision == 'v2' %} selected{% endif %}>V2</option>
              <option value="mix"{% if box.editorial_decision.decision == 'mix' %} selected{% endif %}>Mezclar</option>
              <option value="rewrite"{% if box.editorial_decision.decision == 'rewrite' %} selected{% endif %}>Reescribir</option>
              <option value="reject_both"{% if box.editorial_decision.decision == 'reject_both' %} selected{% endif %}>Descartar ambas</option>
            </select>
          </label>
          <label class="sv9-editorial-field">
            <span>Nota interna</span>
            <textarea name="note" rows="4">{{ box.editorial_decision.note or "" }}</textarea>
          </label>
          <label class="sv9-editorial-field">
            <span>Evaluador</span>
            <input name="evaluator" value="{{ box.editorial_decision.evaluator or "" }}" placeholder="nombre">
          </label>
          <button class="source-link" type="submit">Guardar decisión</button>
        </form>
      </section>
    </div>
  </div>
</dialog>
{%- endmacro %}

<section class="magnetism-hero-section">
  {% if model %}
  {% include "magnetism_scan_nav.html.j2" %}
  {% else %}
  <div class="lab-review-nav" style="margin-bottom: 14px;">
    <a class="source-link" href="/sv9/calibration">← Scans</a>
    <a class="source-link badge-ready" href="/sv9/scan/{{ scan.id }}">Baldosas</a>
    <a class="source-link" href="/sv9/calibration/{{ scan.id }}">Calibración</a>
    <a class="source-link" href="/sv9/scan/{{ scan.id }}/export.md">Export .md</a>
  </div>
  {% endif %}

  {% if is_legacy %}
  <div style="margin: 14px 0; border: 1px solid var(--border-strong); background: var(--soft-panel-bg); padding: 14px;">
    <p class="dim" style="margin: 0; font-family: var(--font-mono); font-size: 12px; line-height: 1.55;">
      Este scan usa el modelo anterior (<strong>{{ scan.rubric_version }}</strong>). No es convertible al modelo de baldosas v3.1:
      re-escanéalo para ver el grid de baldosas. Se mantiene en el ranking etiquetado como <strong>v2</strong> hasta entonces.
    </p>
  </div>
  {% endif %}

  <div class="magnetism-hero-grid">
    <div class="magnetism-hero-main">
      <h1 class="page-title magnetism-hero-title">{{ scan.display_name or scan.brand_name }}</h1>
      {% if scan.display_url %}
      <a class="sv9-scan-url-subtitle" href="{{ scan.display_url }}" target="_blank" rel="noopener">
        {{ scan.display_url }}
      </a>
      {% endif %}
      <div style="margin-top: 8px; display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
        <span class="badge">{{ scan.reliability_label or "desconocido" }}</span>
        <span class="dim" style="font-family: var(--font-mono); font-size: 11px;">
          {% if scan.reliability_reason_labels %}
          {{ scan.reliability_reason_labels|join(" · ") }}
          {% else %}
          sin bloqueos de confiabilidad
          {% endif %}
        </span>
      </div>
      <div style="margin-top: 6px; display:flex; flex-wrap:wrap; gap:8px; align-items:center;">
        <span class="badge">{{ scan.canonical_label or "desconocido" }}</span>
        <span class="dim" style="font-family: var(--font-mono); font-size: 11px;">
          {% if scan.canonical_reason_labels %}
          {{ scan.canonical_reason_labels|join(" · ") }}
          {% else %}
          salida principal
          {% endif %}
        </span>
      </div>
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">Brand3 Score</div>
      <div class="hl-accent magnetism-hero-score">
        {{ scan.brand3_score }}<span>/100</span>
      </div>
      <div class="magnetism-score-bar" aria-hidden="true">
        <span style="--score-width: {{ scan.brand3_score }}%;"></span>
      </div>
      {% if gap_label %}
      <div class="dim magnetism-hero-tier">hueco: {{ gap_label }}</div>
      {% endif %}
    </div>
    <div class="magnetism-hero-metric">
      <div class="dim magnetism-hero-label">Margen inmediato</div>
      <div class="hl-ok magnetism-hero-score">
        +{{ scan.immediate_margin }}<span> pts</span>
      </div>
      <div class="dim magnetism-hero-tier" style="margin-top: 8px;">
        {% if scan.magnetism_capped %}magnetism cap activo{% endif %}
        {% if scan.needs_review %} · coherencia en revisión{% endif %}
        {% if not scan.is_complete %} · scan parcial{% endif %}
        {% if scan.total_blind_spots %} · {{ scan.total_blind_spots }} puntos ciegos{% endif %}
      </div>
    </div>
  </div>

  {% if technical_failures %}
  <div style="margin-top: 18px; border: 1px solid var(--danger); background: color-mix(in srgb, var(--danger) 10%, transparent); padding: 14px;">
    <div class="magnetism-card-head" style="display:flex; justify-content:space-between; align-items:flex-start; gap:14px;">
      <div>
        <div class="hl-warn" style="font-family:var(--font-mono); text-transform:uppercase; font-size:12px;">evaluación técnica fallida</div>
        <p class="dim" style="margin: 6px 0 0; font-family:var(--font-mono); font-size:12px; line-height:1.55;">
          El contenido fue detectado, pero {{ technical_failures|length }} componente{% if technical_failures|length != 1 %}s{% endif %} no se puntuaron por fallo del proveedor.
          Este 0/100 no es un diagnóstico estratégico válido.
        </p>
        <p class="dim" style="margin: 6px 0 0; font-family:var(--font-mono); font-size:12px; line-height:1.55;">
          error: {{ technical_failures[0].error or 'not_evaluated' }}
        </p>
      </div>
      {% if scan.source_run_id %}
      <form method="post" action="/sv9/scan/{{ scan.id }}/retry">
        <button class="source-link" type="submit">Reintentar</button>
      </form>
      {% endif %}
    </div>
  </div>
  {% endif %}
</section>

<section class="magnetism-tldr-section">
  <div class="sv9-canvas" style="margin-top: 14px;">
    {% for row in canvas %}
    <div class="sv9-canvas-row sv9-canvas-row-{{ row|length }}">
      {% for box in row %}
      {{ tile_box(box) }}
      {{ editorial_drawer(box) }}
      {% endfor %}
    </div>
    {% endfor %}

    {{ tile_box(coherencia, full_width=true) }}
    {{ editorial_drawer(coherencia, is_coherence=True) }}
  </div>

  <p class="dim" style="font-family: var(--font-mono); font-size: 11px; margin: 12px 0 0;">
    <a href="/sv9/calibration/{{ scan.id }}">→ baldosas, evidencia y calibración de este scan</a>
  </p>
</section>
<script>
  (() => {
    const openers = document.querySelectorAll("[data-sv9-dialog-open]");
    openers.forEach((opener) => {
      opener.addEventListener("click", () => {
        const dialog = document.getElementById(opener.dataset.sv9DialogOpen);
        if (!dialog || typeof dialog.showModal !== "function") return;
        dialog.showModal();
      });
    });
  })();
</script>
{% endblock %}
