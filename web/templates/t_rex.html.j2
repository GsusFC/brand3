{% extends "base.html.j2" %}
{% block title %}brand3 :: t-rex{% endblock %}
{% block extra_head %}
  <script src="/static/status_waiting.js?v={{ static_asset_version }}" defer></script>
{% endblock %}
{% block content %}
<section data-status-waiting data-status="playground" data-ready-href="" data-poll-interval="0">
  <div class="section-head">
    <span class="label">t_rex_playground</span>
    <span class="tag">// {{ 'modo libre' if ui_lang == 'es' else 'free mode' }}</span>
  </div>

  <pre class="term-head">
<span class="hl-accent">[play]</span>     <span class="dim">{{ 'iteración del juego sin scanner activo' if ui_lang == 'es' else 'game iteration without an active scanner' }}</span>
  </pre>

  <div class="status-grid">
    <div class="status-metric">
      <span class="k">{{ 'control' if ui_lang == 'es' else 'control' }}</span>
      <span class="v">{{ 'Espacio / ↑ / toque' if ui_lang == 'es' else 'Space / ↑ / tap' }}</span>
    </div>
    <div class="status-metric">
      <span class="k">{{ 'pausa' if ui_lang == 'es' else 'pause' }}</span>
      <span class="v">P</span>
    </div>
    <div class="status-metric">
      <span class="k">{{ 'objetivo' if ui_lang == 'es' else 'goal' }}</span>
      <span class="v">{{ 'probar ritmo y legibilidad' if ui_lang == 'es' else 'test rhythm and readability' }}</span>
    </div>
  </div>

  <section class="status-game t-rex-playground" aria-label="{{ 'Mini juego T-Rex' if ui_lang == 'es' else 'T-Rex mini game' }}">
    <div class="status-game-head">
      <div>
        <div class="status-game-label">{{ 'T-Rex sandbox' if ui_lang == 'es' else 'T-Rex sandbox' }}</div>
        <div class="status-game-copy small">{{ 'Espacio / ↑ / toque: saltar. Doble salto disponible. P: pausar.' if ui_lang == 'es' else 'Space / ↑ / tap: jump. Double jump available. P: pause.' }}</div>
      </div>
      <div class="status-game-scoreboard" aria-live="polite">
        <div>
          <span class="k">{{ 'Score' if ui_lang == 'en' else 'Puntos' }}</span>
          <span class="v tabular-nums" data-dino-score>0</span>
        </div>
        <div>
          <span class="k">{{ 'Best' if ui_lang == 'en' else 'Récord' }}</span>
          <span class="v tabular-nums" data-dino-best>0</span>
        </div>
        <div>
          <span class="k">{{ 'Speed' if ui_lang == 'en' else 'Ritmo' }}</span>
          <span class="v tabular-nums" data-dino-speed>x1.0</span>
        </div>
      </div>
    </div>
    <div class="status-game-board">
      <canvas class="status-game-canvas" width="960" height="220" data-dino-canvas data-game-lang="{{ ui_lang }}"></canvas>
    </div>
    <div class="status-game-footer">
      <button class="source-link status-game-button" type="button" data-dino-start aria-pressed="false">{{ 'Empezar' if ui_lang == 'es' else 'Start' }}</button>
      <span class="small dim" data-dino-level>{{ 'Nivel 1' if ui_lang == 'es' else 'Level 1' }}</span>
      <span class="small dim" data-dino-state>{{ 'Listo para jugar' if ui_lang == 'es' else 'Ready to play' }}</span>
    </div>
  </section>

  <p class="small dim">
    <a href="/magnetism-scanner{{ lang_suffix }}">{{ 'Volver al Brand3 Scanner' if ui_lang == 'es' else 'Back to Brand3 Scanner' }}</a>
  </p>
</section>
{% endblock %}
