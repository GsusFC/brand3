{% extends "base.html.j2" %}
{% block title %}brand3 :: {{ model.ui.title_by_section.get(model.section, model.title) }}{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">{{ model.ui.title_by_section.get(model.section, model.title) }}</span>
    <span class="tag">// {{ model.ui.guardrails.get('read-only source artifact navigation') }} · {{ model.ui.guardrails.get('evidence-only') }} · {{ model.ui.guardrails.get('no scoring impact') }}</span>
  </div>

  <h1 class="page-title">{{ model.ui.title_by_section.get(model.section, model.title) }}</h1>
  <p class="prose dim intro-copy vs-summary">{{ model.ui.intro_by_section.get(model.section, model.intro) }}</p>

  <nav class="vs-nav" aria-label="{{ 'Secciones de firma visual' if current_lang == 'es' else 'Visual Signature sections' }}">
    {% for item in model.nav %}
    <a class="vs-nav-link{% if item.active %} active{% endif %}" href="{{ item.href }}{{ lang_suffix }}">{{ model.ui.nav.get(item.href, item.label) }}</a>
    {% endfor %}
  </nav>

  <div class="guardrail-banner">
    <strong>{{ model.ui.overview_guardrail_title }}</strong>
    <span class="dim">{{ model.ui.overview_guardrail_copy }} <a href="{{ model.initial_scoring.href }}{{ lang_suffix }}">Brand Audit</a>. {{ model.ui.overview_guardrail_tail }}</span>
  </div>

  <div class="badge-line">
    {% for guardrail in model.guardrails %}
    <span class="badge">{{ model.ui.guardrails.get(guardrail, guardrail) }}</span>
    {% endfor %}
  </div>
</section>

{% if model.section == "overview" %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.ui.visual_evidence }}</span>
    <span class="tag">// {{ model.ui.screenshots_primary }}</span>
  </div>

  <div class="visual-evidence-intro">
    <h2>{{ model.ui.visual_evidence_first }}</h2>
    <p>{{ model.ui.visual_evidence_intro }}</p>
    <div class="vs-meta-row">
      <span class="inline-kv"><span class="k">{{ model.ui.captures }}</span>=<span class="v">{{ model.visual_evidence.summary.capture_count }}</span></span>
      <span class="inline-kv"><span class="k">{{ model.ui.raw_viewport }}</span>=<span class="v">{{ model.visual_evidence.summary.raw_viewport_count }}</span></span>
      <span class="inline-kv"><span class="k">{{ model.ui.clean_attempt }}</span>=<span class="v">{{ model.visual_evidence.summary.clean_attempt_count }}</span></span>
      <span class="inline-kv"><span class="k">{{ model.ui.full_page }}</span>=<span class="v">{{ model.visual_evidence.summary.full_page_count }}</span></span>
    </div>
  </div>

  <div class="visual-evidence-list">
    {% for item in model.visual_evidence["items"] %}
    <article class="visual-evidence-item">
      <div class="visual-evidence-head">
        <div>
          <h2>{{ item.brand_name }}</h2>
          <p class="dim">
            {{ item.obstruction_type }} · {{ item.obstruction_severity }} · {{ item.perceptual_state }}
          </p>
        </div>
        <span class="badge badge-{{ item.capture_status|replace('_', '-') }}">{{ item.capture_status }}</span>
      </div>

      <div class="screenshot-strip">
        {% for screenshot in item.variants %}
        <figure class="screenshot-evidence{% if not screenshot.exists %} is-missing{% endif %}">
          {% if screenshot.exists %}
          <a href="{{ screenshot.preview_href }}{{ lang_suffix }}" aria-label="{{ model.ui.preview_screenshot }} {{ model.ui.screenshot_labels.get(screenshot.label, screenshot.label) }} screenshot for {{ item.brand_name }}">
            <img src="{{ screenshot.href }}" alt="{{ screenshot.alt }}">
          </a>
          {% else %}
          <div class="screenshot-missing">{% if screenshot.label == "clean attempt" %}{{ model.ui.no_clean_attempt }}{% else %}{{ model.ui.missing_screenshot }}{% endif %}</div>
          {% endif %}
          <figcaption>
            <span>{{ model.ui.screenshot_labels.get(screenshot.label, screenshot.label) }}</span>
            <code>{{ screenshot.filename }}</code>
            {% if screenshot.exists %}
            <a class="source-link screenshot-source-link" href="{{ screenshot.href }}" target="_blank" rel="noopener">{{ model.ui.open_full_resolution }}</a>
          {% endif %}
        </figcaption>
      </figure>
        {% endfor %}
      </div>

      <div class="evidence-story">
        <p><strong>{{ model.ui.capture }}:</strong> {{ model.ui.capture_story }}</p>
        <p><strong>{{ model.ui.obstruction }}:</strong> {{ item.obstruction_type }} {{ model.ui.obstruction_story }} {{ item.obstruction_severity }} {{ model.ui.severity }}.</p>
        <p><strong>{{ model.ui.clean_attempt }}:</strong> {% if item.dismissal_attempted %}{{ model.ui.clean_attempt_recorded }}{% if item.dismissal_successful %} {{ model.ui.clean_attempt_reduced }}{% else %}, {{ model.ui.clean_attempt_not_reduced }}{% endif %}.{% else %}{{ model.ui.clean_attempt_not_attempted }}{% endif %}</p>
        <p><strong>{{ model.ui.preservation }}:</strong> {{ model.ui.preservation_story }}</p>
      </div>

      {% if item.evidence_notes %}
      <details class="vs-compact-details">
        <summary>{{ model.ui.evidence_notes }}</summary>
        <ul class="evidence-notes">
          {% for note in item.evidence_notes %}
          <li>{{ note }}</li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
    </article>
    {% endfor %}

    {% if not model.visual_evidence["items"] %}
    <div class="visual-evidence-empty">
      {{ model.ui.no_curated_screenshots }} <code>examples/visual_signature/screenshots/</code>.
    </div>
    {% endif %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.ui.evidence_flow }}</span>
    <span class="tag">// {{ model.ui.capture_to_review }}</span>
  </div>
  <div class="evidence-flow">
    <article>
      <h2>{{ model.ui.flow_capture_title }}</h2>
      <p>{{ model.ui.flow_capture_copy }}</p>
    </article>
    <article>
      <h2>{{ model.ui.flow_dismiss_title }}</h2>
      <p>{{ model.ui.flow_dismiss_copy }}</p>
    </article>
    <article>
      <h2>{{ model.ui.flow_clean_title }}</h2>
      <p>{{ model.ui.flow_clean_copy }}</p>
    </article>
    <article>
      <h2>{{ model.ui.flow_preserve_title }}</h2>
      <p>{{ model.ui.flow_preserve_copy }}</p>
    </article>
  </div>
</section>
{% endif %}

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{% if model.section == "overview" %}{{ model.ui.governance_summary }}{% else %}{{ model.ui.status_summary }}{% endif %}</span>
    <span class="tag">// {{ model.ui.source_artifacts_only }}</span>
  </div>

  <div class="vs-report-list">
    {% for card in model.cards %}
    <article class="vs-report-item">
      <div class="vs-report-main">
        <div class="vs-report-title">
          <h2>{{ card.label }}</h2>
          <p class="dim">
            {% if card.exists %}
            {{ model.ui.artifact_available }}
            {% else %}
            {{ model.ui.artifact_missing }}
            {% endif %}
          </p>
        </div>
        <span class="badge badge-{{ card.status|replace('_', '-') }}">{{ card.status }}</span>
      </div>

      <div class="vs-meta-row">
        {% for key, value in card.summary.items() %}
        <span class="inline-kv"><span class="k">{{ key }}</span>=<span class="v">{{ value }}</span></span>
        {% endfor %}
        {% if not card.summary %}
        <span class="inline-kv"><span class="k">{{ model.ui.state }}</span>=<span class="v">missing_or_unknown</span></span>
        {% endif %}
      </div>

      <details class="vs-compact-details">
        <summary>{{ model.ui.artifact_metadata }}</summary>
        <div class="kv artifact-kv">
          <span class="k">type</span>    <span class="v">{{ card.type }}</span>
          <span class="k">exists</span>  <span class="v">{{ card.exists }}</span>
          <span class="k">path</span>    <span class="v mono-token">{{ card.path }}</span>
          <span class="k">{{ model.ui.source }}</span>  <span class="v">{% if card.exists %}<a href="{{ card.source_href }}">{{ model.ui.open_source }} {{ card.type }}</a>{% else %}missing_or_unknown{% endif %}</span>
        </div>
      </details>
    </article>
    {% endfor %}
  </div>
</section>

{% if model.section == "reviewer" %}
<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.ui.human_review }}</span>
    <span class="tag">// {{ model.ui.screenshot_first_draft }}</span>
  </div>
  <div class="vs-report-item">
      <div class="vs-report-main">
        <div class="vs-report-title">
          <h2>{{ model.ui.evidence_first_review }}</h2>
          <p class="dim">{{ model.ui.human_review_intro }}</p>
        </div>
      <a class="source-link" href="/visual-signature/reviewer/human-review{{ lang_suffix }}">{{ model.ui.open_human_review }}</a>
      </div>
  </div>
</section>
{% endif %}

{% if model.records %}
<hr class="rule-thin">
<section>
  <div class="section-head">
    <span class="label">{{ model.ui.records }}</span>
    <span class="tag">// {{ model.records|length }} {{ model.ui.shown }}</span>
  </div>
  <div class="table-wrap vs-records-table">
    <table>
      <thead>
        <tr>
          <th>{{ model.ui.item }}</th>
          <th>{{ model.ui.status }}</th>
          <th>{{ model.ui.metadata }}</th>
        </tr>
      </thead>
      <tbody>
      {% for item in model.records %}
        <tr>
          <td>{{ item.title }}</td>
          <td><span class="badge">{{ item.status }}</span></td>
          <td>
            {% for key, value in item.meta.items() %}
              <span class="inline-kv"><span class="k">{{ key }}</span>=<span class="v">{{ value }}</span></span>
            {% endfor %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.ui.source_artifacts }}</span>
    <span class="tag">// {{ model.ui.raw_json_hidden }}</span>
  </div>
  <div class="artifact-list">
    {% for artifact in model.artifacts %}
    <details class="artifact-details">
      <summary>
        <span>{{ artifact.label }}</span>
        <span class="badge">{{ artifact.status }}</span>
      </summary>
      <div class="kv artifact-kv">
        <span class="k">type</span>    <span class="v">{{ artifact.type }}</span>
        <span class="k">exists</span>  <span class="v">{{ artifact.exists }}</span>
        <span class="k">path</span>    <span class="v mono-token">{{ artifact.path }}</span>
        <span class="k">{{ model.ui.source }}</span>  <span class="v">{% if artifact.exists %}<a href="{{ artifact.source_href }}">{{ model.ui.open_source_artifact }}</a>{% else %}missing_or_unknown{% endif %}</span>
      </div>
      {% if artifact.raw_json %}
      <pre class="raw-json">{{ artifact.raw_json }}</pre>
      {% else %}
      <pre class="raw-json">{{ model.ui.raw_json_unavailable }}</pre>
      {% endif %}
    </details>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.ui.what_to_do_next }}</span>
    <span class="tag">// {{ model.ui.no_write_actions }}</span>
  </div>
  <div class="next-steps">
    {% for step in model.next_steps %}
    <p class="next-step">{{ step }}</p>
    {% endfor %}
  </div>
</section>
{% endblock %}
