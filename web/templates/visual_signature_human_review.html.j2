{% extends "base.html.j2" %}
{% block title %}brand3 :: {{ model.ui.human_review_title }}{% endblock %}
{% block extra_head %}
<script src="/static/visual_signature_human_review.js?v=brand3-human-review-draft-20260514" defer></script>
{% endblock %}
{% block content %}
<section>
  <div class="section-head">
    <span class="label">{{ model.ui.human_review }}</span>
    <span class="tag">// {{ model.ui.human_review_header_tag }}</span>
  </div>

  <h1 class="page-title">{{ model.ui.human_review_title }}</h1>
  <p class="prose dim intro-copy vs-summary">{{ model.ui.human_review_intro_full }}</p>

  <nav class="vs-nav" aria-label="{{ 'Secciones de firma visual' if current_lang == 'es' else 'Visual Signature sections' }}">
    {% for item in model.nav %}
    <a class="vs-nav-link{% if item.active %} active{% endif %}" href="{{ item.href }}{{ lang_suffix }}">{{ model.ui.nav.get(item.href, item.label) }}</a>
    {% endfor %}
  </nav>

  <div class="guardrail-banner">
    <strong>{{ model.ui.visible_evidence_only }}</strong>
    <span class="dim">{{ model.ui.human_review_guardrail }}</span>
  </div>

  <div class="badge-line">
    {% for guardrail in model.guardrails %}
    <span class="badge">{{ model.ui.guardrails.get(guardrail, guardrail) }}</span>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.ui.review_queue }}</span>
    <span class="tag">// {{ model.queue["summary"].selected }} {{ model.ui.selected }} · {{ model.queue["summary"].pending }} {{ model.ui.pending }}</span>
  </div>

  <div class="human-review-queue" role="list">
    {% for item in model.queue["items"] %}
    <a class="human-review-queue-item{% if item.active %} is-active{% endif %}" href="{{ item.href }}{{ lang_suffix }}" role="listitem">
      <span class="queue-title">{{ item.brand_name }}</span>
      <span class="queue-meta">{{ item.queue_state }} · {{ item.confidence_bucket }} · {{ item.category }}</span>
    </a>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.ui.active_capture }}</span>
    <span class="tag">// {{ model.active.queue_id }}</span>
  </div>

  <div class="human-review-summary">
    <div>
      <h2>{{ model.active.brand_name }}</h2>
      <p class="dim">{{ model.active.website_url }}</p>
    </div>
    <div class="badge-line">
      <span class="badge badge-{{ model.active.queue_state|replace('_', '-') }}">{{ model.active.queue_state }}</span>
      <span class="badge">{{ model.active.confidence_bucket }}</span>
      <span class="badge">{{ model.active.perceptual_state }}</span>
      <span class="badge">{{ model.active.obstruction_type }}</span>
      <span class="badge">{{ model.active.obstruction_severity }}</span>
    </div>
  </div>

  <div class="vs-meta-row">
    <span class="inline-kv"><span class="k">capture_id</span>=<span class="v">{{ model.active.capture_id }}</span></span>
    <span class="inline-kv"><span class="k">category</span>=<span class="v">{{ model.active.category }}</span></span>
    <span class="inline-kv"><span class="k">dismissal_attempted</span>=<span class="v">{{ model.active.dismissal_attempted }}</span></span>
    <span class="inline-kv"><span class="k">dismissal_successful</span>=<span class="v">{{ model.active.dismissal_successful }}</span></span>
  </div>
</section>

<hr class="rule-thin">

<section class="human-review-evidence-section">
  <div class="section-head">
    <span class="label">{{ model.ui.visual_evidence }}</span>
    <span class="tag">// {{ model.ui.raw_viewport }} {{ 'es evidencia primaria' if current_lang == 'es' else 'is primary evidence' }}</span>
  </div>

  {% if model.active.primary_variant and model.active.primary_variant.exists %}
  <figure class="human-review-primary-shot">
    <div class="human-review-primary-viewport">
      <img src="{{ model.active.primary_variant.href }}" alt="{{ model.active.primary_variant.alt }}">
    </div>
    <figcaption>
      <span>{{ model.ui.primary_evidence }}: {{ model.ui.screenshot_labels.get(model.active.primary_variant.label, model.active.primary_variant.label) }}</span>
      <code>{{ model.active.primary_variant.filename }}</code>
      <a class="source-link" href="{{ model.active.primary_variant.preview_href }}{{ lang_suffix }}">{{ model.ui.preview }}</a>
      <a class="source-link" href="{{ model.active.primary_variant.href }}" target="_blank" rel="noopener">{{ model.ui.open_full_resolution_image }}</a>
    </figcaption>
  </figure>
  {% else %}
  <div class="visual-evidence-empty">{{ model.ui.primary_missing }}</div>
  {% endif %}

  <div class="human-review-variants" role="list">
    {% for screenshot in model.active.variants %}
    <figure class="human-review-variant{% if not screenshot.exists %} is-missing{% endif %}" role="listitem">
      {% if screenshot.exists %}
      <a href="{{ screenshot.preview_href }}{{ lang_suffix }}" aria-label="{{ model.ui.preview_screenshot }} {{ model.ui.screenshot_labels.get(screenshot.label, screenshot.label) }} screenshot for {{ model.active.brand_name }}">
        <img src="{{ screenshot.href }}" alt="{{ screenshot.alt }}">
      </a>
      {% else %}
      <div class="screenshot-missing">{% if screenshot.label == "clean attempt" %}{{ model.ui.no_clean_attempt }}{% else %}{{ model.ui.missing_screenshot }}{% endif %}</div>
      {% endif %}
      <figcaption>
        <span>{% if screenshot.label == "raw viewport" %}{{ model.ui.primary_evidence }}{% else %}{{ model.ui.supplemental_evidence }}{% endif %}: {{ model.ui.screenshot_labels.get(screenshot.label, screenshot.label) }}</span>
        <code>{{ screenshot.filename }}</code>
      </figcaption>
    </figure>
    {% endfor %}
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.ui.structured_visual_questions }}</span>
    <span class="tag">// {{ model.ui.answer_visible_only }}</span>
  </div>

  <div class="human-review-layout">
    <div class="human-review-question-stack">
      <div class="semantic-guidance-banner">
        <strong>{{ model.ui.semantic_guidance }}</strong>
        <span>{{ model.semantic_guidance.summary }}</span>
      </div>
      {% for group in model.question_groups %}
      <article class="human-review-question-group">
        <h2>{{ group.name }}</h2>
        {% for question in group.questions %}
        <div
          class="human-review-question"
          data-question-id="{{ question.id }}"
          data-question-text="{{ question.text }}"
          data-question-category="{{ question.category }}"
          data-observation-type="{{ question.observation_type }}"
          data-answer-type="{{ question.answer_type }}"
        >
          <div class="human-review-question-copy">
            <p>{{ question.text }}</p>
            <div class="semantic-chip-row" aria-label="semantic guidance for {{ question.text }}">
              <span class="semantic-chip">{{ model.ui.question_category }}: {{ question.category_label }}</span>
              <span class="semantic-chip">{{ model.ui.observation_type }}: {{ question.observation_type_label }}</span>
              <span class="semantic-chip">{{ question.answer_type_label }}</span>
            </div>
          </div>
          <div class="human-review-choice-row" aria-label="{{ question.text }}">
            <label class="choice-pill" title="{{ question.answer_guidance.yes }}">
              <input type="radio" name="answer_{{ question.id }}" value="yes">
              <span>{{ model.ui.yes }}</span>
            </label>
            <label class="choice-pill" title="{{ question.answer_guidance.partial }}">
              <input type="radio" name="answer_{{ question.id }}" value="partial">
              <span>{{ model.ui.partial }}</span>
            </label>
            <label class="choice-pill" title="{{ question.answer_guidance.no }}">
              <input type="radio" name="answer_{{ question.id }}" value="no">
              <span>{{ model.ui.no }}</span>
            </label>
            <label class="choice-pill" title="{{ question.answer_guidance.uncertain }}">
              <input type="radio" name="answer_{{ question.id }}" value="uncertain">
              <span>{{ model.ui.uncertain }}</span>
            </label>
          </div>
          <details class="semantic-details">
            <summary>{{ model.ui.what_mean }}</summary>
            <div class="semantic-details-grid">
              <span class="k">{{ model.ui.category }}</span>
              <span class="v">{{ question.category_label }} — {{ question.category_purpose }}</span>
              <span class="k">{{ model.ui.answer_type }}</span>
              <span class="v">{{ question.answer_type_label }}</span>
              <span class="k">{{ model.ui.yes }}</span>
              <span class="v">{{ question.answer_guidance.yes }}</span>
              <span class="k">{{ model.ui.partial }}</span>
              <span class="v">{{ question.answer_guidance.partial }}</span>
              <span class="k">{{ model.ui.no }}</span>
              <span class="v">{{ question.answer_guidance.no }}</span>
              <span class="k">{{ model.ui.confidence }}</span>
              <span class="v">{{ model.ui.confidence_meaning }} {{ question.confidence_guidance }}</span>
              <span class="k">{{ model.ui.observation_vs_interpretation }}</span>
              <span class="v">{{ question.observation_interpretation_guidance }}</span>
            </div>
          </details>
        </div>
        {% endfor %}
      </article>
      {% endfor %}
    </div>

    <aside class="human-review-form-panel">
      <h2>{{ model.ui.outcome_draft }}</h2>
      <p class="dim">{{ model.ui.local_only_form }}</p>
      <div class="draft-warning" role="note">
        <strong>{{ model.ui.not_official_record }}</strong>
        <span>{{ model.ui.drafts_validated }}</span>
      </div>
      <form
        class="human-review-form"
        data-human-review-draft-form
        data-brand-name="{{ model.active.brand_name }}"
        data-capture-id="{{ model.active.capture_id }}"
        data-queue-id="{{ model.active.queue_id }}"
      >
        {% for ref in model.active.evidence_refs %}
        <input type="hidden" name="evidence_ref" value="{{ ref }}">
        {% endfor %}
        <label>
          <span>{{ model.ui.reviewer_id }}</span>
          <input type="text" name="reviewer_id" placeholder="reviewer-01" autocomplete="off">
        </label>
        <label>
          <span>{{ model.ui.review_outcome }}</span>
          <select name="review_outcome">
            {% for outcome in model.outcomes %}
            <option value="{{ outcome }}">{{ outcome }}</option>
            {% endfor %}
          </select>
        </label>
        <label>
          <span>{{ model.ui.confidence }}</span>
          <select name="confidence_bucket">
            {% for bucket in model.confidence_buckets %}
            <option value="{{ bucket }}" {% if bucket == model.active.confidence_bucket %}selected{% endif %}>{{ bucket }}</option>
            {% endfor %}
          </select>
        </label>
        <label>
          <span>{{ model.ui.notes }}</span>
          <textarea name="notes" placeholder="{{ model.ui.notes_placeholder }}"></textarea>
        </label>
        <label>
          <span>{{ model.ui.contradiction_notes }}</span>
          <textarea name="contradictions" placeholder="{{ model.ui.contradictions_placeholder }}"></textarea>
        </label>
        <label>
          <span>{{ model.ui.additional_evidence_needed }}</span>
          <textarea name="missing_evidence" placeholder="{{ model.ui.missing_evidence_placeholder }}"></textarea>
        </label>
        <div class="draft-actions">
          <button class="button" type="button" data-export-draft-review>{{ model.ui.export_draft }}</button>
          <span class="draft-export-status" data-draft-export-status aria-live="polite"></span>
        </div>
      </form>
    </aside>
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.ui.review_record_preview }}</span>
    <span class="tag">// {{ model.ui.no_completed_record }}</span>
  </div>

  <div class="artifact-details">
    <p class="dim">{{ model.ui.preview_only }}</p>
    <div class="kv artifact-kv">
      {% for field in model.record_preview_fields %}
      <span class="k">{{ field }}</span>    <span class="v">{% if field == "queue_id" %}{{ model.active.queue_id }}{% elif field == "capture_id" %}{{ model.active.capture_id }}{% elif field == "evidence_refs" %}{{ model.ui.selected_screenshot_refs }}{% else %}{{ model.ui.local_draft_field }}{% endif %}</span>
      {% endfor %}
    </div>
  </div>
</section>

<hr class="rule-thin">

<section>
  <div class="section-head">
    <span class="label">{{ model.ui.advanced_metadata }}</span>
    <span class="tag">// {{ model.ui.collapsed_by_default }}</span>
  </div>

  <details class="artifact-details">
    <summary>
      <span>{{ model.ui.source_artifacts_notes }}</span>
      <span class="badge">{{ model.ui.collapsed }}</span>
    </summary>
    {% if model.active.evidence_notes %}
    <ul class="evidence-notes">
      {% for note in model.active.evidence_notes %}
      <li>{{ note }}</li>
      {% endfor %}
    </ul>
    {% endif %}
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>{{ model.ui.artifact }}</th>
            <th>{{ model.ui.status }}</th>
            <th>path</th>
          </tr>
        </thead>
        <tbody>
          {% for artifact in model.source_artifacts %}
          <tr>
            <td>{{ artifact.label }}</td>
            <td><span class="badge">{{ artifact.status }}</span></td>
            <td class="mono-token">{{ artifact.path }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </details>
</section>
{% endblock %}
